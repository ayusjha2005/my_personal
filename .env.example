# ========================================================
# AYUSH JHA PERSONAL TECH BLOG — ENVIRONMENT CONFIGURATION
# ========================================================

# Server Configuration
PORT=3000
NODE_ENV=production
BASE_URL=https://ayushjha.vercel.app

# Database Configuration (MongoDB Atlas Connection URI)
# In production on Vercel, provide your MongoDB Atlas connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ayush_tech_blog?retryWrites=true&w=majority

# Session Security (Generate a secure, random string in production)
SESSION_SECRET=change_this_to_a_long_cryptographically_secure_secret_in_production

# Initial Admin Credentials (Configured for first login / admin setup)
ADMIN_USERNAME=ayush
ADMIN_EMAIL=reach2kr.ayush@gmail.com
ADMIN_PASSWORD=change_this_secure_admin_password_in_production

# Contact Email Configuration
CONTACT_EMAIL=reach2kr.ayush@gmail.com

# Cloudinary Image Storage (Required for persistent image uploads on Vercel)
# Sign up at https://cloudinary.com/ and copy credentials from Dashboard:
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
