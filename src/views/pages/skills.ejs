<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="app" tabindex="-1">
  <section class="view">
    <div class="xhead" style="margin-bottom:28px">
      <span class="t">technical skills & competencies</span>
      <span style="font-family:var(--mono);font-size:12px;color:var(--muted)">verified technologies & engineering foundations</span>
    </div>

    <p style="color:var(--muted);max-width:65ch;line-height:1.7;margin-bottom:24px;">
      Technologies, languages, database systems, and computer science fundamentals I have actively learned and worked with in software development, practical projects, and academic coursework.
    </p>

    <div class="skills-grid">
      <!-- Programming Languages -->
      <div class="skill-card">
        <div class="skill-group-title">Programming Languages</div>
        <div class="skill-items">
          <span class="skill-pill">C</span>
          <span class="skill-pill">C++</span>
          <span class="skill-pill">JavaScript</span>
          <span class="skill-pill">Python</span>
          <span class="skill-pill">SQL</span>
        </div>
      </div>

      <!-- Frontend Development -->
      <div class="skill-card">
        <div class="skill-group-title">Frontend Development</div>
        <div class="skill-items">
          <span class="skill-pill">HTML</span>
          <span class="skill-pill">CSS</span>
          <span class="skill-pill">JavaScript</span>
        </div>
      </div>

      <!-- Backend Development -->
      <div class="skill-card">
        <div class="skill-group-title">Backend Development</div>
        <div class="skill-items">
          <span class="skill-pill">Node.js</span>
          <span class="skill-pill">Express.js</span>
          <span class="skill-pill">REST API Development</span>
          <span class="skill-pill">EJS</span>
        </div>
      </div>

      <!-- Databases -->
      <div class="skill-card">
        <div class="skill-group-title">Databases</div>
        <div class="skill-items">
          <span class="skill-pill">MongoDB</span>
          <span class="skill-pill">PostgreSQL</span>
          <span class="skill-pill">Oracle SQL</span>
          <span class="skill-pill">Supabase</span>
          <span class="skill-pill">Prisma</span>
        </div>
      </div>

      <!-- Computer Science Fundamentals -->
      <div class="skill-card">
        <div class="skill-group-title">Computer Science Fundamentals</div>
        <div class="skill-items">
          <span class="skill-pill">Data Structures and Algorithms</span>
          <span class="skill-pill">Object-Oriented Programming</span>
          <span class="skill-pill">Database Management Systems</span>
          <span class="skill-pill">Operating Systems</span>
          <span class="skill-pill">Computer Networks</span>
          <span class="skill-pill">Software Engineering</span>
        </div>
      </div>

      <!-- Tools and Platforms -->
      <div class="skill-card">
        <div class="skill-group-title">Tools and Platforms</div>
        <div class="skill-items">
          <span class="skill-pill">Git</span>
          <span class="skill-pill">GitHub</span>
          <span class="skill-pill">VS Code</span>
          <span class="skill-pill">Linux</span>
          <span class="skill-pill">Postman</span>
        </div>
      </div>

      <!-- Areas of Active Exploration -->
      <div class="skill-card">
        <div class="skill-group-title">Areas of Active Learning & Exploration</div>
        <div class="skill-items">
          <span class="skill-pill exploring">Cloud Computing</span>
          <span class="skill-pill exploring">Artificial Intelligence</span>
          <span class="skill-pill exploring">Distributed Systems</span>
          <span class="skill-pill exploring">System Architecture</span>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
