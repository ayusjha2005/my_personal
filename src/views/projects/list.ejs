<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="app" tabindex="-1">
  <section class="view">
    <div class="xhead" style="margin-bottom: 24px;">
      <span class="t">engineering projects</span>
      <span><%= projects.length %> systems & software projects</span>
    </div>

    <p style="color:var(--muted);max-width:65ch;line-height:1.7;margin-bottom:28px;">
      Practical engineering projects spanning systems programming in C++, AI-assisted healthcare software concepts, IoT road monitoring prototypes, and full-stack web applications.
    </p>

    <div class="projects-grid">
      <% if (projects && projects.length > 0) { %>
        <% projects.forEach((project) => { %>
          <div class="project-card">
            <% if (project.image) { %>
              <div style="margin-bottom: 14px; border-radius: 8px; overflow: hidden; border: 1px solid var(--line);">
                <img src="<%= project.image %>" alt="<%= project.title %>" style="width: 100%; height: 180px; object-fit: cover; display: block;" loading="lazy">
              </div>
            <% } %>
            <h3><%= project.title %></h3>
            <p><%= project.description %></p>
            <div class="project-tags">
              <% project.technologies.forEach(tech => { %>
                <span class="project-tag"><%= tech %></span>
              <% }) %>
            </div>
            <div class="project-links">
              <% if (project.githubUrl) { %>
                <a href="<%= project.githubUrl %>" target="_blank" rel="noopener">GitHub ↗</a>
              <% } %>
              <% if (project.liveUrl) { %>
                <a href="<%= project.liveUrl %>" target="_blank" rel="noopener">Live Demo ↗</a>
              <% } %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="empty">No projects added yet. Check back soon!</div>
      <% } %>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
