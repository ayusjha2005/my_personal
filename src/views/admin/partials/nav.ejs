<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= pageTitle %></title>
<link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="admin-layout">
  <!-- Admin Sidebar -->
  <aside class="admin-sidebar">
    <div class="admin-brand">
      <div class="dot"></div>
      <span>Ayush Jha <span style="font-size:11px;color:var(--admin-primary)">CMS</span></span>
    </div>

    <nav class="admin-nav">
      <a href="/admin" class="<%= activeTab === 'dashboard' ? 'active' : '' %>">
        <span>📊</span> Dashboard
      </a>
      <a href="/admin/writings" class="<%= activeTab === 'blogs' || activeTab === 'writings' ? 'active' : '' %>">
        <span>✍️</span> Writings & Articles
      </a>
      <a href="/admin/comments" class="<%= activeTab === 'comments' ? 'active' : '' %>">
        <span>💬</span> Comments
      </a>
      <a href="/admin/projects" class="<%= activeTab === 'projects' ? 'active' : '' %>">
        <span>📁</span> Projects Portfolio
      </a>
      <a href="/admin/contacts" class="<%= activeTab === 'contacts' ? 'active' : '' %>">
        <span>📬</span> Messages Inbox
      </a>
      <a href="/admin/analytics" class="<%= activeTab === 'analytics' ? 'active' : '' %>">
        <span>📈</span> Traffic Analytics
      </a>
      <a href="/admin/settings" class="<%= activeTab === 'settings' ? 'active' : '' %>">
        <span>⚙️</span> Site Settings
      </a>
      <a href="/" target="_blank" style="margin-top: 14px; border-top: 1px dashed var(--admin-border);">
        <span>🌐</span> View Public Site ↗
      </a>
    </nav>

    <div class="admin-user-bar">
      <div class="admin-user-info">
        <strong><%= currentUser ? currentUser.username : 'Administrator' %></strong>
        <span>Security Level: Admin</span>
      </div>
      <a href="/admin/logout" class="admin-logout-btn">Logout</a>
    </div>
  </aside>

  <!-- Admin Main Workspace -->
  <main class="admin-main">
    <% if (messages && messages.error) { %>
      <div class="admin-alert admin-alert-error"><%= messages.error %></div>
    <% } %>
    <% if (messages && messages.success) { %>
      <div class="admin-alert admin-alert-success"><%= messages.success %></div>
    <% } %>
