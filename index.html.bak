<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Ayush Jha · tech blog</title>
<meta name="description" content="Notes on distributed systems, AI infrastructure and developer tools.">
<meta name="color-scheme" content="dark light">
<meta name="theme-color" content="#000000">
<meta name="description" content="Notes on distributed systems, AI infrastructure and developer tools. By Ayush Jha.">
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<link rel="manifest" href="/manifest.json">
<style>
  :root {
    --bg: #000; --bg2: #070707; --fg: #e8e8e8; --muted: #7b7b7b; --dim: #3a3a3a; --line: #1b2640;
    --card: #0c1222; --red: #e5353b; --red-glow: rgba(229,53,59,.5); --code: #050505;
    --font: "Inter", "Helvetica Neue", Arial, sans-serif;
    --mono: "JetBrains Mono", "SFMono-Regular", Menlo, Consolas, monospace;
    --ease: cubic-bezier(.2,.7,.2,1); --spring: cubic-bezier(.34,1.56,.64,1);

    /* Tokyo Drift Palette */
    --accent: #00e5ff;
    --accent-glow: rgba(0, 229, 255, 0.4);
    --red-orange: #ff4d2e;
    --amber: #ff4d2e;
    --headlight: #fff8dc;
    --headlight-glow: #ffd666;
    --taillight: #ff3b3b;
    --sky-top: #06030c;
    --sky-mid: #1a0a22;
    --sky-bot: #3d0f1c;
    --sky-gradient: linear-gradient(180deg, #06030c 0%, #1a0a22 65%, #3d0f1c 100%);
  }
  body.light {
    --bg: #fafafa; --bg2: #f1f1f1; --fg: #111; --muted: #6b6b6b; --dim: #c9c9c9; --line: #e4e4e4;
    --card: #fff; --code: #f3f3f3;
    --accent: #0091a8;
    --amber: #c2410c;
    --red-orange: #c2410c;
    --accent-glow: rgba(0, 145, 168, 0.3);
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { background: var(--bg); scroll-behavior: smooth; }
  body { background: var(--bg); color: var(--fg); font-family: var(--font); font-size: 15px; line-height: 1.7; min-height: 100vh; transition: background .4s, color .4s; overflow-x: hidden; }
  a { color: inherit; text-decoration: none; }
  button { font: inherit; color: inherit; }
  ::selection { background: var(--red); color: #fff; }
  body::after { content: ""; position: fixed; inset: 0; pointer-events: none; z-index: 90; background: repeating-linear-gradient(to bottom, rgba(255,255,255,.025) 0 1px, transparent 1px 3px); }
  body.light::after { display: none; }

  /* top bar */
  header.top { position: sticky; top: 0; z-index: 40; backdrop-filter: blur(10px); background: color-mix(in srgb, var(--bg) 82%, transparent); border-bottom: 1px solid var(--line); }
  .bar { max-width: 1100px; margin: 0 auto; padding: 14px 24px; display: flex; align-items: center; gap: 18px; }
  .brand { font-family: var(--mono); font-weight: 600; font-size: 14px; display: inline-flex; align-items: center; gap: 8px; }
  .brand .cursor { width: 8px; height: 14px; background: var(--red); animation: blink 1s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  nav.main { display: flex; gap: 4px; margin-left: 12px; }
  nav.main a { font-size: 13px; color: var(--muted); padding: 6px 10px; border-radius: 999px; position: relative; transition: color .25s, background .25s; }
  nav.main a:hover, nav.main a.on { color: var(--fg); background: var(--bg2); }
  nav.main a.on::after { content: ""; position: absolute; left: 50%; bottom: -2px; width: 4px; height: 4px; border-radius: 50%; background: var(--red); transform: translateX(-50%); box-shadow: 0 0 8px var(--red); }
  .bar .right { margin-left: auto; display: flex; gap: 8px; align-items: center; }
  .kbd-btn, .icon-btn { border: 1px solid var(--line); background: var(--card); border-radius: 8px; padding: 6px 10px; font-size: 12px; cursor: pointer; color: var(--muted); transition: border-color .25s, color .25s, transform .3s var(--spring); }
  .kbd-btn:hover, .icon-btn:hover { border-color: var(--red); color: var(--fg); transform: translateY(-1px); }
  .icon-btn { width: 34px; height: 34px; padding: 0; display: grid; place-items: center; font-size: 15px; }
  .theme-icon { position: relative; width: 16px; height: 16px; display: inline-block; }
  .theme-icon .sun, .theme-icon .moon { position: absolute; inset: 0; transition: transform .5s var(--spring), opacity .3s; text-align: center; line-height: 16px; }
  body.light .theme-icon .moon { opacity: 0; transform: rotate(90deg) scale(.5); }
  body:not(.light) .theme-icon .sun { opacity: 0; transform: rotate(-90deg) scale(.5); }
  kbd { font-family: var(--mono); font-size: 11px; }

  main { max-width: 1100px; margin: 0 auto; padding: 40px 24px 80px; min-height: 70vh; }
  .view { animation: viewIn .55s var(--ease) both; }
  @keyframes viewIn { from { opacity: 0; transform: translateY(14px); filter: blur(4px); } to { opacity: 1; transform: none; filter: none; } }

  /* night scene */
  .scene { position: relative; height: 230px; border-radius: 14px; overflow: hidden; border: 1px solid #141414; background: #030303; margin-bottom: 44px; animation: sceneIn 1.1s .1s var(--ease) both; }
  @keyframes sceneIn { from { opacity: 0; transform: translateY(12px); } }
  #scene { width: 100%; height: 100%; display: block; }
  /* landing sequence: the scene plays first (beam is built, cat walks on), then the rest of the page fades in */
  .view.stage > :not(.scene) { transition: opacity .9s var(--ease), transform .8s var(--ease); }
  .view.stage.hold > :not(.scene) { opacity: 0; pointer-events: none; }

  /* hero */
  .hero { display: grid; grid-template-columns: 1.05fr .95fr; gap: 40px; align-items: center; margin-bottom: 40px; }
  .hero h1 { font-size: clamp(30px, 5vw, 46px); font-weight: 700; letter-spacing: -.03em; line-height: 1.1; animation: rise 1s var(--ease) both; }
  .hero h1 .grad { background: linear-gradient(90deg, var(--fg), var(--red)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  @keyframes rise { from { opacity: 0; transform: translateY(18px); filter: blur(6px); } }
  .hero p { color: var(--muted); margin-top: 16px; max-width: 52ch; }
  .cta { display: flex; gap: 10px; margin-top: 22px; flex-wrap: wrap; }
  .btn { display: inline-flex; align-items: center; gap: 8px; border-radius: 999px; padding: 9px 16px; font-size: 13px; border: 1px solid var(--line); background: var(--card); cursor: pointer; transition: transform .3s var(--spring), border-color .25s, background .25s, color .25s; will-change: transform; position: relative; overflow: hidden; }
  .btn:hover { border-color: var(--red); }
  .btn.primary { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  .btn.primary:hover { background: var(--red); border-color: var(--red); color: #fff; }
  .btn.primary::after { content: ""; position: absolute; top: 0; left: -60%; width: 40%; height: 100%; background: linear-gradient(90deg, transparent, rgba(255,255,255,.35), transparent); transform: skewX(-20deg); animation: shine 3.5s infinite; pointer-events: none; }
  @keyframes shine { 0% { left: -60%; } 60%, 100% { left: 130%; } }
  .btn.on { border-color: var(--red); color: var(--red); }

  .term { background: var(--code); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; box-shadow: 0 30px 60px -30px rgba(0,0,0,.6); position: relative; }
  .term-head { display: flex; gap: 6px; padding: 10px 12px; border-bottom: 1px solid var(--line); align-items: center; }
  .term-head i { width: 10px; height: 10px; border-radius: 50%; background: var(--dim); }
  .term-head i:first-child { background: var(--red); }
  .term-head span { margin-left: auto; font-family: var(--mono); font-size: 11px; color: var(--muted); }
  .term-body { padding: 16px 18px; font-family: var(--mono); font-size: 13px; line-height: 1.8; min-height: 230px; color: var(--muted); }
  .term-body .p { color: var(--red); }
  .term-body .ok { color: #7ee787; }
  .term-body .c { display: inline-block; width: 8px; height: 14px; background: var(--fg); vertical-align: -2px; animation: blink 1s steps(2) infinite; }
  .term-cat { position: absolute; right: 14px; bottom: 10px; width: 64px; height: 48px; }
  .term-cat .tail { transform-origin: 56px 42px; animation: wag 2.4s ease-in-out infinite; }
  @keyframes wag { 0%,100% { transform: rotate(0); } 50% { transform: rotate(-16deg); } }
  .term-cat .eyes { transform-origin: center; animation: blinkEyes 4.2s infinite; }
  @keyframes blinkEyes { 0%,94%,100% { transform: scaleY(1); } 96% { transform: scaleY(.1); } }
  .term-cat .walk { animation: hop 3.6s ease-in-out infinite; }
  @keyframes hop { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-2px); } }

  /* ticker */
  .ticker { overflow: hidden; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 10px 0; margin: 0 -24px 34px; white-space: nowrap; color: var(--muted); font-family: var(--mono); font-size: 12px; }
  .tk { display: inline-flex; animation: tick 28s linear infinite; }
  .tk span { padding-right: 24px; }
  .tk span::after { content: "✶"; margin-left: 24px; color: var(--red); }
  @keyframes tick { to { transform: translateX(-50%); } }

  /* toolbar */
  .toolbar { display: flex; flex-direction: column; gap: 14px; margin-bottom: 22px; }
  .row2 { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; justify-content: space-between; }
  .search { flex: 1; min-width: 220px; display: flex; align-items: center; gap: 10px; background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 10px 14px; transition: border-color .25s, box-shadow .3s; }
  .search:focus-within { border-color: var(--red); box-shadow: 0 0 0 4px rgba(229,53,59,.12); }
  .search input { flex: 1; background: transparent; border: 0; outline: 0; color: var(--fg); font: inherit; font-size: 14px; }
  .search input::placeholder { color: var(--muted); }
  .search .count { font-family: var(--mono); font-size: 11px; color: var(--muted); }
  .seg { display: inline-flex; border: 1px solid var(--line); border-radius: 999px; padding: 3px; background: var(--card); }
  .seg button { border: 0; background: transparent; font-family: var(--mono); font-size: 12px; color: var(--muted); padding: 5px 12px; border-radius: 999px; cursor: pointer; transition: all .3s var(--spring); }
  .seg button.on { background: var(--red); color: #fff; box-shadow: 0 0 14px var(--red-glow); }

  /* post cards */
  .posts { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .post { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 20px; cursor: pointer; position: relative; overflow: hidden; transition: transform .45s var(--spring), border-color .3s, box-shadow .4s; opacity: 0; transform: translateY(16px); animation: cardIn .6s var(--ease) forwards; animation-delay: calc(var(--i) * 60ms); display: block; }
  @keyframes cardIn { to { opacity: 1; transform: none; } }
  .post::before { content: ""; position: absolute; inset: 0; background: radial-gradient(220px circle at var(--mx, 50%) var(--my, 0%), rgba(229,53,59,.14), transparent 60%); opacity: 0; transition: opacity .4s; pointer-events: none; }
  .post:hover { transform: translateY(-4px); border-color: #333; box-shadow: 0 18px 40px -20px rgba(229,53,59,.45); }
  .post:hover::before { opacity: 1; }
  .post .meta { font-family: var(--mono); font-size: 11px; color: var(--muted); display: flex; gap: 10px; align-items: center; }
  .post h3 { font-size: 18px; font-weight: 600; letter-spacing: -.01em; margin: 10px 0 8px; line-height: 1.3; transition: color .25s; }
  .post:hover h3 { color: var(--red); animation: glitch .5s steps(2) 1; }
  @keyframes glitch { 0% { text-shadow: none; } 25% { text-shadow: 2px 0 rgba(229,53,59,.8), -2px 0 #fff; } 50% { text-shadow: -2px 0 rgba(229,53,59,.8), 2px 0 #fff; } 75%, 100% { text-shadow: none; } }
  .post p { color: var(--muted); font-size: 14px; }
  .post .arrow { position: absolute; right: 18px; bottom: 16px; color: var(--dim); transition: transform .35s var(--spring), color .3s; }
  .post:hover .arrow { transform: translate(4px,-4px); color: var(--red); }
  .empty { grid-column: 1 / -1; color: var(--muted); text-align: center; padding: 40px 0; font-family: var(--mono); font-size: 13px; }

  /* section heads + reveal */
  .xsec { margin-top: 64px; }
  .xhead { position: relative; display: flex; justify-content: space-between; align-items: baseline; color: var(--muted); font-size: 13px; margin-bottom: 18px; padding-bottom: 8px; border-bottom: 1px solid var(--line); }
  .xhead::after { content: ""; position: absolute; left: 0; bottom: -1px; height: 1px; width: 100%; background: linear-gradient(90deg, var(--red), transparent 70%); transform: scaleX(0); transform-origin: left; transition: transform 1.2s var(--ease); }
  .xsec.in .xhead::after { transform: scaleX(1); }
  .xhead .t { color: var(--fg); font-family: var(--mono); font-size: 12px; }
  .xhead .t::before { content: "/ "; color: var(--muted); }
  .xhead a:hover { color: var(--fg); }
  .rv { opacity: 0; transform: translateY(16px); transition: opacity .8s var(--ease), transform .8s var(--ease); }
  .rv.in { opacity: 1; transform: none; }

  /* talks */
  .cards3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .tcard { display: block; transition: transform .35s var(--ease); }
  .tcover { aspect-ratio: 4/3; border-radius: 10px; border: 1px solid #161616; overflow: hidden; position: relative; background: radial-gradient(circle at 50% 70%, #2a0708, #050505 70%); transition: border-color .3s, box-shadow .4s var(--ease); }
  .tcover::before { content: ""; position: absolute; top: -20%; bottom: -20%; left: 0; width: 45%; background: linear-gradient(90deg, transparent, rgba(255,255,255,.12), transparent); transform: translateX(-120%) skewX(-18deg); transition: transform 1s var(--ease); pointer-events: none; z-index: 2; }
  .tcard:hover .tcover::before { transform: translateX(260%) skewX(-18deg); }
  .tcover .spot { position: absolute; inset: 0; background: radial-gradient(160px circle at var(--mx, 50%) var(--my, 50%), rgba(229,53,59,.22), transparent 65%); opacity: 0; transition: opacity .4s; pointer-events: none; }
  .tcard:hover .spot { opacity: 1; }
  .tcover .idx { position: absolute; top: 10px; left: 12px; font-family: var(--mono); font-size: 11px; color: var(--muted); z-index: 3; }
  .tcover .moon { position: absolute; left: 50%; top: 42%; width: 34px; height: 34px; margin: -17px 0 0 -17px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #fff, #bdbdbd 60%, #666); box-shadow: 0 0 22px rgba(229,53,59,.35); transition: transform .6s var(--spring), box-shadow .4s; }
  .tcard:hover .moon { transform: scale(1.15) translateY(-4px); box-shadow: 0 0 36px rgba(229,53,59,.6); }
  .tcover .cat { position: absolute; left: 50%; bottom: 14%; width: 46px; transform: translateX(-50%); transition: transform .4s var(--spring); }
  .tcard:hover .cat { transform: translateX(-50%) translateY(-6px); }
  .tcard:hover .tcover { border-color: #333; box-shadow: 0 16px 34px -14px rgba(229,53,59,.4); }
  .tmeta { font-family: var(--mono); font-size: 12px; color: var(--muted); margin-top: 10px; }
  .ttitle { font-size: 14px; margin-top: 3px; line-height: 1.4; transition: color .25s; }
  .tcard:hover .ttitle { color: var(--red); }

  /* graph */
  .graph-wrap { overflow-x: auto; padding-bottom: 6px; }
  .graph { display: grid; grid-template-columns: 28px repeat(52, 10px); grid-template-rows: 14px repeat(7, 11px); gap: 3px; font-size: 11px; color: var(--muted); width: max-content; }
  .graph .m { grid-row: 1; }
  .graph .d { grid-column: 1; font-size: 10px; line-height: 11px; text-align: right; padding-right: 6px; }
  .cell { width: 10px; height: 10px; border-radius: 2px; background: #1a1a1a; opacity: 0; transform: scale(.4); transition: transform .2s var(--spring), opacity .5s; }
  .cell.on { opacity: 1; transform: none; }
  .cell:hover { background: #fff !important; transform: scale(1.5); }
  .cell.hot { animation: hot 2.4s ease-in-out infinite; }
  @keyframes hot { 50% { box-shadow: 0 0 10px var(--red); } }
  .legend { font-size: 12px; color: var(--muted); margin-top: 10px; display: flex; align-items: center; gap: 6px; }
  .legend i { width: 10px; height: 10px; border-radius: 2px; display: inline-block; }

  /* timeline */
  .exp { display: grid; grid-template-columns: 1fr auto; gap: 4px 16px; position: relative; padding: 12px 0 12px 22px; border-bottom: 1px solid var(--line); font-size: 14px; opacity: 0; transform: translateY(10px); transition: opacity .6s var(--ease), transform .6s var(--ease), padding .4s var(--ease); }
  .exp.in { opacity: 1; transform: none; }
  .exp:hover { padding-left: 30px; }
  .exp::before { content: ""; position: absolute; left: 4px; top: 0; bottom: 0; width: 1px; background: var(--line); }
  .exp::after { content: ""; position: absolute; left: 0; top: 19px; width: 9px; height: 9px; border-radius: 50%; background: #000; border: 1px solid var(--red); box-shadow: 0 0 10px var(--red-glow); }
  .exp.first::after { background: var(--red); animation: ping 2.2s infinite; }
  @keyframes ping { 0% { box-shadow: 0 0 0 0 rgba(229,53,59,.7); } 70%, 100% { box-shadow: 0 0 0 12px rgba(229,53,59,0); } }
  .exp .yr { color: var(--muted); font-size: 13px; font-family: var(--mono); }
  .exp .role { color: #b5b5b5; font-size: 13px; grid-column: 1; }

  /* mailbox */
  .mailbox { display: inline-flex; align-items: center; gap: 12px; border: 1px solid #222; border-radius: 999px; padding: 7px 7px 7px 16px; font-size: 14px; position: relative; overflow: hidden; transition: border-color .3s, box-shadow .3s; }
  .mailbox:hover { border-color: #444; box-shadow: 0 0 0 4px rgba(229,53,59,.08); }
  .mailbox button { font: inherit; font-size: 12px; background: var(--fg); color: var(--bg); border: 0; border-radius: 999px; padding: 6px 14px; cursor: pointer; transition: transform .3s var(--spring), background .25s, color .25s; }
  .mailbox button:hover { transform: scale(1.07); background: var(--red); color: #fff; }
  .rip { position: absolute; border-radius: 50%; background: rgba(229,53,59,.35); transform: scale(0); animation: rip .7s var(--ease) forwards; pointer-events: none; }
  @keyframes rip { to { transform: scale(12); opacity: 0; } }

  /* article */
  .article-wrap { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 56px; }
  .toc { position: sticky; top: 92px; align-self: start; font-size: 13px; }
  .toc h4 { font-family: var(--mono); font-size: 11px; color: var(--muted); font-weight: 400; margin-bottom: 10px; text-transform: uppercase; letter-spacing: .08em; }
  .toc a { display: block; color: var(--muted); padding: 4px 0 4px 12px; border-left: 2px solid var(--line); transition: color .25s, border-color .25s, padding .3s var(--ease); }
  .toc a:hover { color: var(--fg); }
  .toc a.on { color: var(--fg); border-left-color: var(--red); padding-left: 16px; }
  .crumb { font-family: var(--mono); font-size: 12px; color: var(--muted); margin-bottom: 18px; }
  .crumb a:hover { color: var(--red); }
  article h1 { font-size: clamp(28px, 4.4vw, 40px); font-weight: 700; letter-spacing: -.03em; line-height: 1.15; }
  .byline { font-family: var(--mono); font-size: 12px; color: var(--muted); margin: 14px 0 28px; display: flex; gap: 14px; flex-wrap: wrap; }
  article h2 { font-size: 22px; font-weight: 600; letter-spacing: -.01em; margin: 44px 0 12px; scroll-margin-top: 90px; }
  article p { color: #c4c4c4; margin: 14px 0; }
  article ul { margin: 12px 0 12px 20px; color: #c4c4c4; }
  article li { margin: 6px 0; }
  body.light article p, body.light article ul { color: #333; }
  .callout { border-left: 3px solid var(--red); background: var(--card); border-radius: 0 10px 10px 0; padding: 14px 18px; margin: 22px 0; color: #c4c4c4; font-size: 14px; }
  body.light .callout { color: #333; }
  .callout b { color: var(--fg); }
  .codeblock { margin: 22px 0; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: var(--code); }
  .codeblock .bar2 { display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; border-bottom: 1px solid var(--line); font-family: var(--mono); font-size: 11px; color: var(--muted); }
  .codeblock button { background: transparent; border: 1px solid var(--line); color: var(--muted); border-radius: 6px; padding: 3px 9px; font-family: var(--mono); font-size: 11px; cursor: pointer; transition: all .25s; }
  .codeblock button:hover { color: var(--fg); border-color: var(--red); }
  .codeblock.copied button { color: #7ee787; border-color: #7ee787; }
  .codeblock pre { margin: 0; padding: 16px 18px; overflow-x: auto; font-family: var(--mono); font-size: 13px; line-height: 1.7; color: #d4d4d4; }
  body.light .codeblock pre { color: #222; }
  .kw { color: #ff7b72; } .st { color: #a5d6ff; } .cm { color: #6e7681; font-style: italic; } .fn { color: #d2a8ff; } .nm { color: #79c0ff; }
  body.light .kw { color: #cf222e; } body.light .st { color: #0a3069; } body.light .cm { color: #6e7781; } body.light .fn { color: #8250df; } body.light .nm { color: #0550ae; }
  .progress { position: fixed; left: 0; top: 0; height: 2px; background: var(--red); box-shadow: 0 0 10px var(--red); width: 0; z-index: 60; }
  .actions-row { display: flex; gap: 8px; margin-top: 38px; padding-top: 22px; border-top: 1px solid var(--line); align-items: center; flex-wrap: wrap; }
  .actions-row .label { font-size: 13px; color: var(--muted); margin-right: 6px; }
  .heart { font-size: 14px; }
  .heart.pop { animation: pop2 .5s var(--spring); }
  @keyframes pop2 { 40% { transform: scale(1.35); } }
  .related { margin-top: 56px; }
  .related h4 { font-family: var(--mono); font-size: 12px; font-weight: 400; color: var(--muted); margin-bottom: 14px; }
  .related .posts { grid-template-columns: 1fr 1fr; }
  .pn { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-top: 30px; }
  @media (max-width: 900px) { .article-wrap { grid-template-columns: 1fr; } .toc { display: none; } .related .posts { grid-template-columns: 1fr; } }

  /* writing corner */
  .corner { display: grid; grid-template-columns: 1.1fr .9fr; gap: 28px; align-items: start; }
  .desk { position: relative; border: 1px solid var(--line); border-radius: 16px; background: linear-gradient(180deg, #0c0c0c, #050505); padding: 22px; min-height: 360px; overflow: hidden; }
  .desk::before { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 44%; background: linear-gradient(180deg, #111, #050505); border-top: 1px solid #1f1f1f; }
  .lamp { position: absolute; top: -10px; right: 28px; width: 4px; height: 90px; background: #222; }
  .lamp::before { content: ""; position: absolute; top: 84px; left: -18px; width: 40px; height: 16px; background: #2b2b2b; border-radius: 0 0 20px 20px; }
  .lamp::after { content: ""; position: absolute; top: 96px; left: -110px; width: 230px; height: 260px; background: radial-gradient(ellipse at 50% 0%, rgba(255,235,190,.18), transparent 70%); pointer-events: none; animation: flick 6s infinite; }
  @keyframes flick { 0%,92%,100% { opacity: 1; } 94% { opacity: .6; } 96% { opacity: 1; } }
  .paper { position: absolute; left: 14%; bottom: 22%; width: 190px; height: 120px; background: #f2efe6; border-radius: 4px; box-shadow: 0 10px 24px rgba(0,0,0,.6); transform: rotate(-3deg); padding: 14px; color: #111; font-family: var(--mono); font-size: 11px; line-height: 1.6; overflow: hidden; }
  .paper .ln { display: block; height: 6px; background: #d8d4c8; border-radius: 3px; margin: 7px 0; }
  .paper .ink { display: inline-block; width: 0; overflow: hidden; white-space: nowrap; vertical-align: top; animation: type 6s steps(40) infinite; color: #222; }
  @keyframes type { 0% { width: 0; } 60%, 100% { width: 100%; } }
  .sitter { position: absolute; right: 16%; bottom: 30%; width: 96px; height: 92px; }
  .sitter .tail { transform-origin: 40px 84px; animation: tw 2.4s ease-in-out infinite; }
  @keyframes tw { 50% { transform: rotate(-14deg); } }
  .sitter .writing { transform-origin: 54px 56px; animation: scribble .9s ease-in-out infinite alternate; }
  @keyframes scribble { to { transform: rotate(-10deg) translateY(2px); } }
  .sitter .eyes { transform-box: fill-box; transform-origin: center; animation: bl 4.4s infinite; }
  @keyframes bl { 0%,94%,100% { transform: scaleY(1); } 96% { transform: scaleY(.1); } }
  .desk .label { position: absolute; left: 22px; top: 18px; font-family: var(--mono); font-size: 12px; color: var(--muted); }
  .desk .label b { color: var(--fg); font-weight: 400; }
  .notes h3 { font-size: 13px; font-family: var(--mono); font-weight: 400; color: var(--muted); margin-bottom: 14px; }
  .note { border-left: 2px solid var(--line); padding: 8px 0 8px 14px; margin-bottom: 12px; transition: border-color .3s, transform .4s var(--spring); cursor: default; }
  .note:hover { border-left-color: var(--red); transform: translateX(4px); }
  .note time { font-family: var(--mono); font-size: 11px; color: var(--muted); }
  .note p { font-size: 14px; color: #c4c4c4; margin-top: 2px; }
  body.light .note p { color: #333; }
  .corner-list { margin-top: 56px; }
  @media (max-width: 860px) { .corner { grid-template-columns: 1fr; } }

  /* about + newsletter */
  .about { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
  .about h1 { font-size: 34px; letter-spacing: -.02em; }
  .stack { display: grid; gap: 10px; margin-top: 16px; }
  .stack div { display: flex; justify-content: space-between; border-bottom: 1px solid var(--line); padding: 8px 0; font-size: 14px; }
  .stack span:last-child { font-family: var(--mono); color: var(--muted); font-size: 12px; }
  .news { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 22px; margin-top: 60px; }
  .news h3 { font-size: 18px; }
  .news p { color: var(--muted); font-size: 14px; margin: 6px 0 14px; }
  .news form { display: flex; gap: 8px; flex-wrap: wrap; }
  .news input { flex: 1; min-width: 200px; background: var(--bg); border: 1px solid var(--line); border-radius: 999px; padding: 10px 16px; color: var(--fg); font: inherit; font-size: 14px; outline: 0; transition: border-color .25s, box-shadow .3s; }
  .news input:focus { border-color: var(--red); box-shadow: 0 0 0 4px rgba(229,53,59,.12); }
  .news input.bad { border-color: var(--red); animation: shake .4s; }
  @keyframes shake { 25%,75% { transform: translateX(-5px); } 50% { transform: translateX(5px); } }
  .news .msg { font-family: var(--mono); font-size: 12px; color: var(--muted); margin-top: 10px; min-height: 18px; }
  .news .msg.ok { color: #7ee787; }
  @media (max-width: 760px) { .about { grid-template-columns: 1fr; } nav.main { display: none; } }

  /* footer */
  footer.site { border-top: 1px solid var(--line); padding: 30px 24px 40px; color: var(--muted); font-size: 13px; }
  footer.site .in { max-width: 1100px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 14px 24px; align-items: center; justify-content: space-between; }
  footer.site a:hover { color: var(--fg); }
  footer.site .links { display: flex; gap: 18px; }

  /* back to top */
  #toTop { position: fixed; right: 24px; bottom: 24px; width: 48px; height: 48px; border-radius: 50%; border: 1px solid #222; background: rgba(0,0,0,.7); backdrop-filter: blur(6px); cursor: pointer; display: grid; place-items: center; opacity: 0; transform: translateY(12px) scale(.8); transition: opacity .35s, transform .45s var(--spring), border-color .25s; z-index: 40; color: var(--fg); padding: 0; }
  body.light #toTop { background: rgba(255,255,255,.8); }
  #toTop.show { opacity: 1; transform: none; }
  #toTop:hover { border-color: var(--red); }
  #toTop svg { position: absolute; inset: 0; width: 48px; height: 48px; transform: rotate(-90deg); }
  #toTop circle { fill: none; stroke-width: 1.5; }
  #toTop .track { stroke: #1e1e1e; }
  #toTop .bar { stroke: var(--red); stroke-linecap: round; transition: stroke-dashoffset .15s linear; }
  #toTop span { position: relative; font-size: 16px; }
  #progressTop { position: fixed; left: 0; top: 0; height: 2px; width: 100%; background: linear-gradient(90deg, transparent, var(--red)); transform-origin: 0 50%; transform: scaleX(0); z-index: 60; box-shadow: 0 0 12px var(--red); }

  /* command palette + shortcuts */
  .cmdk { position: fixed; inset: 0; background: rgba(0,0,0,.6); backdrop-filter: blur(4px); display: none; align-items: flex-start; justify-content: center; padding-top: 12vh; z-index: 100; }
  .cmdk.open { display: flex; animation: fade .25s ease; }
  @keyframes fade { from { opacity: 0; } }
  .cmdk .box { width: min(560px, 92vw); background: var(--card); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; box-shadow: 0 40px 80px -30px rgba(0,0,0,.8); animation: pop .35s var(--spring); }
  @keyframes pop { from { transform: scale(.94) translateY(-6px); opacity: 0; } }
  .cmdk input { width: 100%; background: transparent; border: 0; border-bottom: 1px solid var(--line); padding: 16px 18px; color: var(--fg); font: inherit; font-size: 15px; outline: 0; }
  .cmdk ul { list-style: none; max-height: 340px; overflow: auto; padding: 6px; }
  .cmdk li { padding: 10px 12px; border-radius: 8px; display: flex; justify-content: space-between; gap: 12px; cursor: pointer; font-size: 14px; color: var(--muted); }
  .cmdk li.sel { background: var(--bg2); color: var(--fg); }
  .cmdk li.sel .k { color: var(--red); }
  .cmdk li .k { font-family: var(--mono); font-size: 11px; color: var(--dim); }
  .cmdk .foot { font-family: var(--mono); font-size: 11px; color: var(--muted); padding: 8px 14px; border-top: 1px solid var(--line); display: flex; gap: 14px; flex-wrap: wrap; }
  #sparks { position: fixed; inset: 0; pointer-events: none; z-index: 66; }
  #confetti { position: fixed; inset: 0; pointer-events: none; z-index: 70; }
  #tip { position: fixed; pointer-events: none; background: #fff; color: #000; font-size: 11px; font-family: var(--mono); padding: 4px 8px; border-radius: 6px; opacity: 0; transform: translate(-50%, -140%); transition: opacity .15s; z-index: 80; white-space: nowrap; }
  .hint { position: fixed; left: 24px; bottom: 24px; font-family: var(--mono); font-size: 11px; color: var(--muted); background: rgba(0,0,0,.6); border: 1px solid var(--line); border-radius: 8px; padding: 6px 10px; opacity: 0; transform: translateY(6px); transition: opacity .4s, transform .4s; pointer-events: none; z-index: 45; }
  .hint.show { opacity: 1; transform: none; }

  /* buddy cat */
  #buddy { position: fixed; left: 0; bottom: 0; width: 90px; height: 90px; z-index: 65; pointer-events: none; will-change: transform; }
  #buddy .body { position: absolute; inset: 0; pointer-events: auto; cursor: pointer; outline: none; }
  #buddy .body svg { width: 90px; height: 90px; overflow: visible; transition: transform .35s var(--spring); display: block; }
  #buddy .tail { transform-box: fill-box; transform-origin: 100% 100%; animation: tw 2s ease-in-out infinite; }
  #buddy .l { transform-box: fill-box; }
  #buddy.walk .l1, #buddy.walk .l3 { animation: leg .35s ease-in-out infinite alternate; }
  #buddy.walk .l2, #buddy.walk .l4 { animation: leg .35s ease-in-out infinite alternate-reverse; }
  @keyframes leg { to { transform: translateY(-3px); } }
  #buddy .eyes { transform-box: fill-box; transform-origin: center; animation: bl 4.2s infinite; }
  #buddy .paw { transform-box: fill-box; transform-origin: 50% 100%; }
  #buddy.wave .paw { animation: wv .4s ease-in-out 4 alternate; }
  @keyframes wv { to { transform: rotate(-28deg); } }
  #buddy .say { position: absolute; left: 58px; bottom: 96px; max-width: 250px; min-width: 150px; background: #fff; color: #000; font-family: var(--mono); font-size: 12px; line-height: 1.5; padding: 9px 12px; border-radius: 12px 12px 12px 2px; opacity: 0; transform: translateY(8px) scale(.92); transform-origin: bottom left; transition: opacity .3s, transform .45s var(--spring); pointer-events: none; box-shadow: 0 12px 30px -10px rgba(229,53,59,.5); }
  #buddy.talk .say { opacity: 1; transform: none; pointer-events: auto; }
  #buddy .acts { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 8px; }
  #buddy .acts:empty { display: none; }
  #buddy .acts button { font: inherit; font-size: 11px; border: 1px solid #000; background: #000; color: #fff; border-radius: 999px; padding: 3px 10px; cursor: pointer; transition: transform .2s var(--spring), background .2s, border-color .2s; }
  #buddy .acts button:hover { background: var(--red); border-color: var(--red); transform: translateY(-1px); }

  /* misc */
  .reveal-cover { position: relative; }
  @media (max-width: 760px) {
    main { padding: 28px 20px 70px; }
    .hero { grid-template-columns: 1fr; }
    .posts { grid-template-columns: 1fr; }
    .cards3 { grid-template-columns: 1fr; }
    .ticker { margin: 0 -20px 28px; }
    #buddy { width: 64px; height: 64px; }
    #buddy .body svg { width: 64px; height: 64px; }
    #buddy .say { left: 46px; bottom: 70px; max-width: 200px; min-width: 130px; font-size: 11px; }
    #sparks { display: none; }
    .hint { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } .post, .rv, .exp { opacity: 1; transform: none; } body::after { display: none; } }

  /* ---------- Ayush additions ---------- */
  .kicker { font-family: var(--mono); font-size: 13px; color: var(--muted); margin-bottom: 14px; }
  .kicker b { color: var(--fg); font-weight: 600; }
  .wl span { display: inline-block; opacity: 0; animation: letterUp .7s var(--spring) forwards; animation-delay: calc(var(--d) * 55ms + .2s); }
  @keyframes letterUp { from { opacity: 0; transform: translateY(14px) rotate(-8deg); filter: blur(3px); } to { opacity: 1; transform: none; filter: none; } }
  #aurora { position: fixed; inset: -20%; z-index: -1; pointer-events: none; opacity: .32; filter: blur(60px); }
  #aurora i { position: absolute; border-radius: 50%; background: radial-gradient(circle, rgba(229,53,59,.55), transparent 65%); animation: drift 22s ease-in-out infinite alternate; }
  #aurora i:nth-child(1) { width: 46vw; height: 46vw; left: 6%; top: 10%; }
  #aurora i:nth-child(2) { width: 38vw; height: 38vw; right: 4%; top: 40%; background: radial-gradient(circle, rgba(255,255,255,.18), transparent 65%); animation-duration: 28s; animation-delay: -6s; }
  #aurora i:nth-child(3) { width: 34vw; height: 34vw; left: 35%; bottom: -6%; animation-duration: 19s; animation-delay: -11s; }
  @keyframes drift { to { transform: translate(6vw, -4vh) scale(1.12); } }
  body.light #aurora { opacity: .12; }
  #cursorRing { position: fixed; left: 0; top: 0; width: 26px; height: 26px; margin: -13px 0 0 -13px; border: 1px solid rgba(229,53,59,.7); border-radius: 50%; pointer-events: none; z-index: 95; transition: width .3s var(--spring), height .3s var(--spring), margin .3s var(--spring), background .3s, border-color .3s; mix-blend-mode: difference; }
  #cursorRing.hot { width: 54px; height: 54px; margin: -27px 0 0 -27px; background: rgba(229,53,59,.15); border-color: var(--red); }
  @media (pointer: coarse) { #cursorRing { display: none; } }
  .desk { transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)); transition: transform .4s var(--ease); transform-style: preserve-3d; }
  .note.float { animation: floaty 5s ease-in-out infinite; animation-delay: var(--fd, 0s); }
  @keyframes floaty { 50% { transform: translateY(-5px) rotate(.6deg); } }
  .brand:hover { color: var(--red); }
  .brand { transition: color .3s; }
  .hero .cta .btn:nth-child(2) { position: relative; }
  .counter { font-family: var(--mono); color: var(--fg); }
  .sparkle-btn::before { content: "✦"; color: var(--red); margin-right: 4px; }

  /* ---------- socials (about + footer) ---------- */
  .socials-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 12px; margin-top: 40px; }
  .scard { position: relative; display: flex; align-items: center; gap: 12px; padding: 14px 16px; border: 1px solid var(--line); border-radius: 14px; background: var(--card); overflow: hidden; color: var(--fg); transition: transform .35s var(--spring), border-color .3s, box-shadow .4s; opacity: 0; animation: cardIn .6s var(--ease) forwards; animation-delay: calc(var(--i) * 90ms + .2s); }
  .scard::before { content: ""; position: absolute; inset: 0; background: radial-gradient(160px circle at var(--mx, 50%) var(--my, 50%), color-mix(in srgb, var(--c) 28%, transparent), transparent 65%); opacity: 0; transition: opacity .4s; pointer-events: none; }
  .scard:hover { transform: translateY(-4px); border-color: var(--c); box-shadow: 0 14px 30px -14px var(--c); }
  .scard:hover::before { opacity: 1; }
  .sbadge { width: 40px; height: 40px; border-radius: 11px; display: grid; place-items: center; font-family: var(--mono); font-weight: 700; font-size: 13px; background: var(--bg2); border: 1px solid var(--line); transition: transform .5s var(--spring), background .3s, color .3s, border-color .3s; flex-shrink: 0; }
  .scard:hover .sbadge { transform: rotate(-8deg) scale(1.08); background: var(--c); color: #000; border-color: var(--c); }
  .sname { font-size: 14px; font-weight: 600; }
  .shandle { font-family: var(--mono); font-size: 11px; color: var(--muted); }
  .sarrow { margin-left: auto; color: var(--dim); transition: transform .35s var(--spring), color .3s; }
  .scard:hover .sarrow { transform: translate(3px, -3px); color: var(--c); }

  /* ---------- footer ---------- */
  footer.site { position: relative; overflow: hidden; padding: 60px 24px 36px; border-top: 0; }
  footer.site::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 1px; background: linear-gradient(90deg, transparent, var(--red), transparent); background-size: 200% 100%; animation: lineFlow 4s linear infinite; }
  @keyframes lineFlow { to { background-position: 200% 0; } }
  footer.site::after { content: ""; position: absolute; left: 50%; bottom: -160px; width: 720px; height: 320px; margin-left: -360px; background: radial-gradient(ellipse, rgba(229,53,59,.14), transparent 70%); pointer-events: none; animation: breathe 6s ease-in-out infinite; }
  @keyframes breathe { 50% { transform: scale(1.12); opacity: .6; } }
  .fwrap { max-width: 1100px; margin: 0 auto; position: relative; z-index: 1; }
  .fbig { font-size: clamp(44px, 11vw, 116px); font-weight: 700; letter-spacing: -.04em; line-height: 1; background: linear-gradient(90deg, var(--fg), var(--red), var(--fg)); background-size: 200% auto; -webkit-background-clip: text; background-clip: text; color: transparent; animation: gradMove 6s linear infinite; cursor: default; }
  @keyframes gradMove { to { background-position: 200% center; } }
  .ftag { color: var(--muted); font-family: var(--mono); font-size: 13px; margin-top: 12px; }
  .ficons { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 30px; }
  .ficon { position: relative; width: 56px; height: 56px; border-radius: 18px; border: 1px solid var(--line); background: var(--card); color: var(--fg); display: grid; place-items: center; transition: transform .45s var(--spring), border-color .3s, background .3s, color .3s, box-shadow .4s; will-change: transform; }
  .ficon .fb { font-family: var(--mono); font-weight: 700; font-size: 14px; transition: transform .4s var(--spring); }
  .ficon:hover { background: var(--c); border-color: var(--c); color: #000; box-shadow: 0 18px 34px -12px var(--c); }
  .ficon:hover .fb { transform: scale(1.15) rotate(-6deg); }
  .flabel { position: absolute; bottom: calc(100% + 12px); left: 50%; transform: translate(-50%, 6px) scale(.9); background: var(--fg); color: var(--bg); font-size: 11px; font-family: var(--mono); padding: 4px 9px; border-radius: 7px; opacity: 0; white-space: nowrap; pointer-events: none; transition: opacity .25s, transform .4s var(--spring); }
  .ficon:hover .flabel { opacity: 1; transform: translate(-50%, 0) scale(1); }
  .ficon.pulse::after { content: ""; position: absolute; inset: -6px; border-radius: 22px; border: 1px solid var(--c); opacity: 0; animation: ringPulse 2.8s infinite; animation-delay: calc(var(--i) * .4s); pointer-events: none; }
  @keyframes ringPulse { 0% { transform: scale(.9); opacity: .7; } 100% { transform: scale(1.3); opacity: 0; } }
  .ficon { animation: iconIn .6s var(--spring) both; animation-delay: calc(var(--i) * 80ms + .3s); }
  @keyframes iconIn { from { opacity: 0; transform: translateY(16px) scale(.8); } }
  .fbottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-top: 48px; color: var(--muted); font-size: 12px; font-family: var(--mono); }
  .fbottom .links a { transition: color .25s; }
  .fbottom .links a:hover { color: var(--red); }
  .copied-flash { animation: flash .6s ease; }
  @keyframes flash { 40% { transform: scale(1.12); } }
  @media (max-width: 760px) { footer.site { padding: 44px 20px 30px; } .fbottom { flex-direction: column; } }

  .fb svg, .sbadge svg { width: 20px; height: 20px; display: block; }
  .sbadge { color: var(--fg); }
  .scard:hover .sbadge { color: #000; }

  /* ---------- buddy controls: minimise / hide / restore ---------- */
  #buddy .body { transition: transform .4s var(--spring); }
  #buddy .bctl { position: absolute; right: -6px; top: -10px; display: flex; gap: 4px; opacity: 0; pointer-events: none; transition: opacity .25s; z-index: 3; }
  #buddy:hover .bctl, #buddy .bctl:focus-within { opacity: 1; pointer-events: auto; }
  #buddy .bctl button { width: 22px; height: 22px; border-radius: 50%; border: 1px solid #333; background: #000; color: #fff; font-size: 13px; line-height: 1; cursor: pointer; display: grid; place-items: center; padding: 0; transition: transform .2s var(--spring), background .2s, border-color .2s; }
  #buddy .bctl button:hover { background: var(--red); border-color: var(--red); transform: scale(1.12); }
  #buddy.min .body { transform: scale(.42); transform-origin: bottom left; }
  #buddy.min .say { display: none; }
  #buddy.min { width: 40px; height: 40px; }
  #buddy.gone { display: none !important; }

  .contact { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 22px; margin-top: 40px; }
  .contact h3 { font-size: 18px; }
  .contact > p { color: var(--muted); font-size: 14px; margin: 6px 0 14px; }
  .cgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .contact input, .contact textarea { width: 100%; background: var(--bg); border: 1px solid var(--line); border-radius: 12px; padding: 10px 14px; color: var(--fg); font: inherit; font-size: 14px; outline: 0; margin-bottom: 8px; transition: border-color .25s, box-shadow .3s; }
  .contact input:focus, .contact textarea:focus { border-color: var(--red); box-shadow: 0 0 0 4px rgba(229,53,59,.12); }
  .contact textarea { resize: vertical; }
  .contact .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .contact form { position: relative; }
  .contact .msg { font-family: var(--mono); font-size: 12px; color: var(--muted); margin-top: 6px; min-height: 18px; }
  .contact .msg.ok { color: #7ee787; }
  .contact .msg.err { color: var(--red); }
  .contact button:disabled { opacity: .6; cursor: wait; }
  @media (max-width: 560px) { .cgrid { grid-template-columns: 1fr; } }

  /* ===================== RESPONSIVE + ADVANCED ===================== */
  .hide { display: none !important; }
  .skip { position: absolute; left: -999px; top: 0; }
  .skip:focus { left: 16px; top: 10px; z-index: 200; background: var(--fg); color: var(--bg); padding: 8px 12px; border-radius: 8px; }
  :focus-visible { outline: 2px solid var(--red); outline-offset: 3px; }
  header.top.scrolled { box-shadow: 0 10px 30px -18px rgba(0,0,0,.8); }
  .burger { display: none; width: 38px; height: 38px; border-radius: 10px; border: 1px solid var(--line); background: var(--card); cursor: pointer; place-items: center; padding: 0; flex-shrink: 0; }
  .burger span { display: block; width: 16px; height: 1.6px; background: var(--fg); margin: 3px auto; transition: transform .35s var(--spring), opacity .2s; border-radius: 2px; }
  body.nav-open .burger span:nth-child(1) { transform: translateY(4.6px) rotate(45deg); }
  body.nav-open .burger span:nth-child(2) { opacity: 0; }
  body.nav-open .burger span:nth-child(3) { transform: translateY(-4.6px) rotate(-45deg); }
  .scrim { position: fixed; inset: 0; background: rgba(0,0,0,.55); backdrop-filter: blur(3px); z-index: 115; opacity: 0; pointer-events: none; transition: opacity .3s; }
  body.nav-open .scrim { opacity: 1; pointer-events: auto; }
  .drawer { position: fixed; top: 0; right: 0; bottom: 0; width: min(80vw, 300px); background: var(--card); border-left: 1px solid var(--line); z-index: 120; transform: translateX(105%); transition: transform .5s var(--ease); padding: 84px 26px 30px; display: flex; flex-direction: column; box-shadow: -30px 0 60px -30px rgba(0,0,0,.7); overflow-y: auto; }
  body.nav-open .drawer { transform: none; }
  .drawer a, .drawer .dbtn { font: inherit; font-size: 20px; padding: 12px 0; border: 0; border-bottom: 1px solid var(--line); color: var(--fg); background: none; text-align: left; cursor: pointer; opacity: 0; transform: translateX(16px); transition: transform .5s var(--spring), opacity .4s, color .2s; }
  body.nav-open .drawer a, body.nav-open .drawer .dbtn { opacity: 1; transform: none; }
  body.nav-open .drawer > *:nth-child(2) { transition-delay: .06s; }
  body.nav-open .drawer > *:nth-child(3) { transition-delay: .12s; }
  body.nav-open .drawer > *:nth-child(4) { transition-delay: .18s; }
  body.nav-open .drawer > *:nth-child(5) { transition-delay: .24s; }
  body.nav-open .drawer > *:nth-child(6) { transition-delay: .3s; }
  .drawer a:hover, .drawer .dbtn:hover { color: var(--red); }
  .drawer .d-foot { margin-top: auto; padding-top: 24px; font-family: var(--mono); font-size: 11px; color: var(--muted); }
  .toc-fab { display: none; position: fixed; left: 16px; bottom: 16px; z-index: 50; border: 1px solid var(--line); background: var(--card); color: var(--fg); border-radius: 999px; padding: 9px 14px; font-family: var(--mono); font-size: 12px; cursor: pointer; box-shadow: 0 10px 30px -10px rgba(0,0,0,.6); }
  .toc-sheet { position: fixed; left: 0; right: 0; bottom: 0; max-height: 62vh; overflow: auto; background: var(--card); border-top: 1px solid var(--line); border-radius: 18px 18px 0 0; padding: 18px 22px 28px; z-index: 121; transform: translateY(105%); transition: transform .45s var(--ease); box-shadow: 0 -20px 40px -20px rgba(0,0,0,.6); }
  body.toc-open .toc-sheet { transform: none; }
  .toc-sheet .th { font-family: var(--mono); font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; margin-bottom: 8px; }
  .toc-sheet a { display: block; padding: 11px 0; border-bottom: 1px solid var(--line); color: var(--muted); font-size: 14px; }
  .toc-sheet a:hover { color: var(--fg); }
  .reader-tools { display: flex; gap: 8px; align-items: center; margin: 18px 0 0; font-family: var(--mono); font-size: 12px; color: var(--muted); flex-wrap: wrap; }
  .reader-tools button { border: 1px solid var(--line); background: var(--card); color: var(--fg); border-radius: 8px; padding: 4px 10px; cursor: pointer; font-family: var(--mono); font-size: 12px; transition: border-color .2s, transform .2s var(--spring); }
  .reader-tools button:hover { border-color: var(--red); transform: translateY(-1px); }
  body.reader-sm article p, body.reader-sm article li { font-size: 14px; }
  body.reader-lg article p, body.reader-lg article li { font-size: 17px; }
  body.reader-xl article p, body.reader-xl article li { font-size: 19px; line-height: 1.8; }
  #viewStat { color: var(--muted); }
  .offline { position: fixed; left: 50%; bottom: 20px; transform: translate(-50%, 140%); background: var(--fg); color: var(--bg); font-family: var(--mono); font-size: 12px; padding: 8px 14px; border-radius: 999px; z-index: 130; transition: transform .45s var(--spring); }
  .offline.show { transform: translate(-50%, 0); }
  .ticker-wrap { overflow: hidden; }

  @media (max-width: 900px) {
    nav.main { display: none; }
    .burger { display: grid; }
    #buddyToggle { display: none; }
    .toc-fab { display: block; }
    .article-wrap { grid-template-columns: 1fr; }
    .article-wrap .toc { display: none; }
    .hero { gap: 28px; }
  }
  @media (max-width: 760px) {
    main { padding: 24px 18px 72px; }
    .bar { padding: 12px 16px; gap: 10px; }
    .brand { font-size: 13px; }
    .bar .right { gap: 6px; }
    .kbd-btn kbd { display: none; }
    .kbd-btn { padding: 7px 10px; }
    .hero { grid-template-columns: 1fr; }
    .hero h1 { font-size: clamp(28px, 8vw, 36px); }
    .cta { gap: 8px; }
    .cta .btn { flex: 1 1 auto; justify-content: center; }
    .term-body { min-height: 0; font-size: 12px; padding: 14px; }
    .scene { height: 170px; border-radius: 12px; margin-bottom: 30px; }
    .ticker { margin: 0 -18px 26px; }
    .toolbar .row2 { flex-direction: column; align-items: stretch; gap: 10px; }
    .seg { align-self: flex-start; }
    .posts { grid-template-columns: 1fr; gap: 12px; }
    .post { padding: 18px; }
    .post h3 { font-size: 17px; }
    .cards3 { grid-template-columns: 1fr; gap: 16px; }
    .xsec { margin-top: 48px; }
    .graph-wrap { margin: 0 -18px; padding: 0 18px 6px; }
    .exp { padding-left: 20px; }
    .exp.in, .exp { font-size: 13px; }
    .mailbox { width: 100%; justify-content: space-between; }
    .mailbox span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
    .desk { min-height: 300px; padding: 18px; }
    .paper { width: 150px; left: 6%; bottom: 20%; font-size: 10px; }
    .sitter { right: 4%; bottom: 28%; transform: scale(.82); transform-origin: bottom right; }
    .lamp { right: 12px; }
    .corner { gap: 20px; }
    .crumb { font-size: 11px; }
    .byline { gap: 10px; font-size: 11px; flex-wrap: wrap; }
    .actions-row { gap: 8px; }
    .actions-row .btn { flex: 1 1 auto; justify-content: center; }
    .related .posts { grid-template-columns: 1fr; }
    .pn { flex-direction: column; }
    .pn .btn { width: 100%; justify-content: center; text-align: center; white-space: normal; }
    .about { gap: 26px; }
    .about h1 { font-size: 28px; }
    .socials-grid { grid-template-columns: 1fr; }
    .cgrid { grid-template-columns: 1fr; }
    .news form { flex-direction: column; }
    .news input { min-width: 0; width: 100%; }
    .news form .btn { width: 100%; justify-content: center; }
    .cmdk { padding-top: 6vh; }
    .cmdk .box { width: 94vw; }
    .fbig { font-size: clamp(40px, 14vw, 72px); }
    .ficons { gap: 10px; }
    .ficon { width: 50px; height: 50px; border-radius: 15px; }
    .fbottom { flex-direction: column; gap: 10px; }
    #buddy { width: 60px; height: 60px; }
    #buddy .body svg { width: 60px; height: 60px; }
    #buddy .say { left: 44px; bottom: 66px; max-width: 190px; min-width: 120px; font-size: 11px; }
    .hint { display: none; }
    #sparks { display: none; }
  }
  @media (max-width: 420px) {
    .brand { font-size: 12px; }
    .kbd-btn { font-size: 11px; }
    .scene { height: 150px; }
    .term-head span { display: none; }
    .drawer { width: 86vw; }
    .drawer a, .drawer .dbtn { font-size: 18px; }
  }
  @media (hover: none) {
    .post:hover, .tcard:hover, .scard:hover, .btn:hover { transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .drawer, .toc-sheet, .offline { transition: none; }
  }

  /* ===================== LIGHT THEME (polished) ===================== */
  .cell[data-lv="0"], .legend i[data-lv="0"] { background: #1a1a1a; }
  .cell[data-lv="1"], .legend i[data-lv="1"] { background: #4a0f12; }
  .cell[data-lv="2"], .legend i[data-lv="2"] { background: #8c1a1f; }
  .cell[data-lv="3"], .legend i[data-lv="3"] { background: #c7272d; }
  .cell[data-lv="4"], .legend i[data-lv="4"] { background: #e5353b; }
  body.light {
    --bg: #ffffff; --bg2: #f5f5f5; --fg: #15130f; --muted: #6b6b6b; --dim: #d6d6d6; --line: #e6e6e6;
    --card: #ffffff; --code: #f7f7f7; --red: #d93a40; --red-glow: rgba(217,58,64,.32);
    color-scheme: light;
  }
  body.light { background: #ffffff; color: var(--fg); }
  body.light header.top { background: rgba(255,255,255,.86); border-bottom-color: var(--line); box-shadow: 0 1px 0 rgba(255,255,255,.7) inset; }
  body.light header.top.scrolled { box-shadow: 0 12px 30px -20px rgba(20,18,15,.25); }
  body.light nav.main a:hover, body.light nav.main a.on { background: #fff; box-shadow: 0 1px 2px rgba(20,18,15,.06), inset 0 0 0 1px var(--line); }
  body.light .kbd-btn, body.light .icon-btn, body.light .burger { background: #fff; color: var(--fg); box-shadow: 0 1px 2px rgba(20,18,15,.05); }
  body.light .btn { background: #fff; color: var(--fg); border-color: var(--line); box-shadow: 0 1px 2px rgba(20,18,15,.05); }
  body.light .btn:hover { border-color: var(--red); box-shadow: 0 8px 20px -12px rgba(217,58,64,.45); }
  body.light .btn.primary { background: var(--fg); border-color: var(--fg); color: var(--bg); box-shadow: 0 10px 22px -14px rgba(20,18,15,.6); }
  body.light .btn.primary:hover { background: var(--red); border-color: var(--red); color: #fff; }
  body.light .btn.primary::after { background: linear-gradient(90deg, transparent, rgba(255,255,255,.35), transparent); }
  body.light .search { background: #fff; border-color: var(--line); box-shadow: 0 1px 2px rgba(20,18,15,.04); }
  body.light .search input { color: var(--fg); }
  body.light .seg { background: #fff; }
  body.light .seg button { color: var(--muted); }
  body.light .scene { border-color: #e0e0e0; box-shadow: 0 30px 60px -38px rgba(20,18,15,.55), 0 0 0 6px rgba(255,255,255,.6); }
  body.light .term { background: #fff; border-color: var(--line); box-shadow: 0 30px 60px -34px rgba(20,18,15,.28); }
  body.light .term-head { background: #fafafa; }
  body.light .term-head i { background: #d4d4d4; }
  body.light .term-head i:first-child { background: var(--red); }
  body.light .term-head span { color: var(--muted); }
  body.light .term-body { color: #666666; }
  body.light .term-body .ok { color: #1f8a3b; }
  body.light .term-body .c { background: var(--fg); }
  body.light .term-cat path[stroke="#e8e8e8"] { stroke: #15130f; }
  body.light .term-cat [fill="#e8e8e8"] { fill: #15130f; }
  body.light .term-cat [fill="#000"] { fill: #ffffff; }
  body.light .post, body.light .tcard, body.light .scard, body.light .card {
    box-shadow: 0 1px 2px rgba(20,18,15,.04), 0 12px 28px -22px rgba(20,18,15,.25);
  }
  body.light .post { border-color: var(--line); }
  body.light .post:hover { border-color: #e0e0e0; box-shadow: 0 24px 44px -26px rgba(217,58,64,.38); }
  body.light .post h3 { color: var(--fg); }
  body.light .tcover { background: radial-gradient(circle at 50% 70%, #ffffff, #f7f7f7 70%); border-color: #e6e6e6; }
  body.light .tcover .moon { background: radial-gradient(circle at 35% 35%, #ffffff, #eeeeee 60%, #cccccc); box-shadow: 0 0 24px rgba(217,58,64,.22); }
  body.light .tcard:hover .tcover { border-color: #d6d6d6; box-shadow: 0 18px 36px -18px rgba(217,58,64,.35); }
  body.light .tcard:hover .ttitle { color: var(--red); }
  body.light .graph, body.light .legend { color: var(--muted); }
  body.light .cell[data-lv="0"] { background: #ededed; }
  body.light .cell[data-lv="1"] { background: #f6c8c9; }
  body.light .cell[data-lv="2"] { background: #ea8a8e; }
  body.light .cell[data-lv="3"] { background: #df5258; }
  body.light .cell[data-lv="4"] { background: #d12a31; }
  body.light .legend i[data-lv="0"] { background: #ededed; }
  body.light .legend i[data-lv="1"] { background: #f6c8c9; }
  body.light .legend i[data-lv="2"] { background: #ea8a8e; }
  body.light .legend i[data-lv="3"] { background: #df5258; }
  body.light .legend i[data-lv="4"] { background: #d12a31; }
  body.light .xhead { border-bottom-color: var(--line); }
  body.light .xhead .t { color: var(--fg); }
  body.light .exp { border-bottom-color: var(--line); }
  body.light .exp .role { color: #444444; }
  body.light .exp::before { background: #dddddd; }
  body.light .exp::after { background: #fff; }
  body.light .mailbox { background: #fff; border-color: var(--line); box-shadow: 0 1px 2px rgba(20,18,15,.05); }
  body.light .mailbox:hover { border-color: #d6cfbe; box-shadow: 0 0 0 4px rgba(217,58,64,.08); }
  body.light .ficon { background: #fff; border-color: var(--line); box-shadow: 0 1px 2px rgba(20,18,15,.05); }
  body.light .ficon:hover { box-shadow: 0 18px 34px -14px var(--c); }
  body.light .scard { background: #fff; border-color: var(--line); }
  body.light .sbadge { background: #f5f5f5; border-color: var(--line); }
  body.light .cgrid input, body.light .contact input, body.light .contact textarea, body.light .news input { background: #fff; border-color: var(--line); }
  body.light .contact, body.light .news { background: #fff; border-color: var(--line); }
  body.light .desk { background: linear-gradient(180deg, #ffffff, #ffffff); border-color: var(--line); box-shadow: 0 30px 60px -40px rgba(20,18,15,.35); }
  body.light .desk::before { background: linear-gradient(180deg, #f5f5f5, #eeeeee); border-top-color: #dcdcdc; }
  body.light .lamp { background: #d6d6d6; }
  body.light .lamp::before { background: #cccccc; }
  body.light .lamp::after { background: radial-gradient(ellipse at 50% 0%, rgba(0,0,0,.04), transparent 70%); }
  body.light .sitter [fill="#e8e8e8"] { fill: #15130f; }
  body.light .sitter path[stroke="#e8e8e8"] { stroke: #15130f; }
  body.light .sitter path[stroke="#e8e8e8"] + g, body.light .sitter .writing path[stroke="#e8e8e8"] { stroke: #15130f; }
  body.light .sitter [fill="#000"] { fill: #fff; }
  body.light .note { border-left-color: #dddddd; }
  body.light .note:hover { border-left-color: var(--red); }
  body.light .note p { color: #333333; }
  body.light article p, body.light article li { color: #333333; }
  body.light .callout { background: #fff; border-color: var(--line); color: #333333; box-shadow: 0 1px 2px rgba(20,18,15,.04); }
  body.light .codeblock { background: #fafafa; border-color: var(--line); }
  body.light .codeblock .bar2 { background: #f5f5f5; border-bottom-color: var(--line); }
  body.light .codeblock button { background: #fff; color: var(--muted); }
  body.light .codeblock pre { color: #222222; }
  body.light .toc a { color: var(--muted); border-left-color: var(--line); }
  body.light .toc a.on { color: var(--fg); }
  body.light .cmdk .box { background: #fff; border-color: var(--line); box-shadow: 0 40px 80px -30px rgba(20,18,15,.35); }
  body.light .cmdk { background: rgba(255,255,255,.7); }
  body.light .cmdk li.sel { background: #f5f5f5; }
  body.light .hint { background: rgba(255,255,255,.92); color: var(--muted); border-color: var(--line); box-shadow: 0 10px 24px -14px rgba(20,18,15,.3); }
  body.light .drawer { background: #fff; border-left-color: var(--line); }
  body.light .drawer a, body.light .drawer .dbtn { border-bottom-color: var(--line); }
  body.light .scrim { background: rgba(255,255,255,.6); }
  body.light #toTop { background: rgba(255,255,255,.92); border-color: var(--line); color: var(--fg); box-shadow: 0 10px 26px -14px rgba(20,18,15,.35); }
  body.light #toTop .track { stroke: #e7e1d3; }
  body.light #buddy .say { background: #fff; border: 1px solid var(--line); box-shadow: 0 16px 32px -14px rgba(217,58,64,.35); }
  body.light #buddy .acts button { border-color: var(--fg); background: var(--fg); color: #fff; }
  body.light #buddy .bctl button { background: #fff; color: var(--fg); border-color: var(--line); }
  body.light .ticker { border-color: var(--line); color: var(--muted); }
  body.light footer.site { color: var(--muted); }
  body.light footer.site::after { background: radial-gradient(ellipse, rgba(217,58,64,.1), transparent 70%); }
  body.light .fbig { background-image: linear-gradient(90deg, var(--fg), var(--red), var(--fg)); }
  body.light .progress, body.light #progressTop { box-shadow: 0 0 10px rgba(217,58,64,.5); }
  body.light .offline { background: var(--fg); color: #fff; }
  body.light .comments { border-color: var(--dim); color: var(--muted); }
  body.light .byline, body.light .crumb { color: var(--muted); }
  body.light ::selection { background: var(--red); color: #fff; }
  body.light body::after { display: none; }
  body.light .tcover::before, body.light .post::before { opacity: .9; }

  /* ===================== ROBOT HELPER ===================== */
  /* ===================== RACER GUIDE CHARACTER ===================== */
  #buddy2 {
    position: fixed;
    left: 0;
    bottom: 0;
    width: 110px;
    height: 140px;
    z-index: 65;
    pointer-events: none;
    will-change: transform;
    transition: opacity .3s;
  }
  #buddy2 .bd-inner {
    position: absolute;
    inset: 0;
    pointer-events: auto;
    cursor: pointer;
    border-radius: 50%;
    outline: none;
  }
  #buddy2 .bd-inner:focus-visible {
    box-shadow: 0 0 0 3px rgba(0, 229, 255, 0.5);
  }
  #buddy2 svg {
    width: 110px;
    height: 140px;
    overflow: visible;
    display: block;
    transition: transform .3s var(--spring);
  }
  #buddy2 svg * {
    transform-box: fill-box;
    transform-origin: 50% 50%;
  }
  #buddy2 .hair-b, #buddy2 .scarf {
    transform-origin: 50% 0;
  }
  #buddy2 .leg-l, #buddy2 .leg-r, #buddy2 .arm-l, #buddy2 .arm-r {
    transform-origin: 50% 0;
  }
  #buddy2 .legs {
    transform-box: view-box;
    transform-origin: 50px 110px;
  }
  #buddy2 .shadow {
    fill: rgba(0, 0, 0, 0.35);
  }
  body.light #buddy2 .shadow {
    fill: rgba(0, 0, 0, 0.15);
  }

  /* Animations: Walk */
  #buddy2.walk .leg-l {
    animation: legA 0.35s ease-in-out infinite alternate;
  }
  #buddy2.walk .leg-r {
    animation: legA 0.35s ease-in-out infinite alternate-reverse;
  }
  @keyframes legA {
    to { transform: translateY(-3px) rotate(4deg); }
  }
  #buddy2.walk .arm-l {
    animation: armA 0.35s alternate-reverse;
  }
  #buddy2.walk .arm-r {
    animation: armA 0.35s alternate;
  }
  @keyframes armA {
    to { transform: rotate(-18deg); }
  }

  /* Animations: Idle Helmet Sway */
  #buddy2 .hair-b {
    animation: sway 3s ease-in-out infinite;
  }
  @keyframes sway {
    0%, 100% { transform: rotate(0); }
    50% { transform: rotate(-3deg); }
  }

  /* Animations: Blink */
  #buddy2 .eyes {
    animation: bl 4.2s infinite;
  }
  @keyframes bl {
    0%, 94%, 100% { transform: scaleY(1); }
    96% { transform: scaleY(0.12); }
  }

  /* Eye Tracking */
  #buddy2 .eye {
    transition: transform 0.2s ease-out;
  }

  /* Sit */
  #buddy2.sit .body {
    transform: translateY(26px);
    transition: transform 0.4s var(--spring);
  }
  #buddy2.sit .legs {
    opacity: 0;
    transition: opacity 0.3s;
  }

  /* Sleep */
  #buddy2.sleep .eyes {
    animation: none;
    transform: scaleY(0.1);
  }
  #buddy2.sleep .hair-b {
    animation: none;
  }
  #buddy2.sleep .body {
    transform: translateY(4px) rotate(-4deg);
  }
  #buddy2 .zz {
    position: absolute;
    left: 74px;
    top: 14px;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
    opacity: 0;
  }
  #buddy2.sleep .zz {
    animation: zz 3s ease-in infinite;
  }
  #buddy2.sleep .zz:nth-child(2) {
    animation-delay: 1s;
  }
  #buddy2.sleep .zz:nth-child(3) {
    animation-delay: 2s;
  }
  @keyframes zz {
    0% { opacity: 0; transform: translate(0, 0); }
    30% { opacity: 1; }
    100% { opacity: 0; transform: translate(12px, -26px); }
  }

  /* Wave */
  #buddy2.wave .arm-r {
    animation: wv 0.4s ease-in-out infinite alternate;
  }
  @keyframes wv {
    to { transform: rotate(-44deg); }
  }

  /* Jump */
  #buddy2 .bd-inner.jump {
    animation: jump 0.7s var(--ease);
  }
  @keyframes jump {
    0%, 100% { transform: none; }
    40% { transform: translateY(-30px) rotate(-8deg); }
  }

  /* Happy */
  #buddy2.happy .eyes {
    transform: scaleY(0.2);
  }

  /* Sparks */
  #buddy2 .bd-fx {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  #buddy2 .fx-spark {
    position: absolute;
    bottom: 70px;
    font-size: 14px;
    color: var(--amber, #ff4d2e);
    animation: sparkUp 1.1s ease-out forwards;
    text-shadow: 0 0 10px rgba(255, 77, 46, 0.6);
  }
  @keyframes sparkUp {
    to { transform: translate(14px, -44px) scale(0.6); opacity: 0; }
  }

  /* Speech Bubble */
  #buddy2 .say {
    position: absolute;
    left: 80px;
    bottom: 104px;
    max-width: 250px;
    min-width: 150px;
    background: var(--card);
    color: var(--fg);
    border: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 12px;
    line-height: 1.5;
    padding: 9px 12px;
    border-radius: 12px 12px 12px 2px;
    opacity: 0;
    transform: translateY(8px) scale(0.92);
    transform-origin: bottom left;
    transition: opacity 0.3s, transform 0.45s var(--spring);
    pointer-events: none;
    box-shadow: 0 14px 34px -10px rgba(0, 229, 255, 0.25);
  }
  #buddy2.flip-say .say {
    left: auto;
    right: 80px;
    border-radius: 12px 12px 2px 12px;
    transform-origin: bottom right;
  }
  body.light #buddy2 .say {
    background: #fff;
    color: #111;
    border: 1px solid var(--line);
  }
  #buddy2.talk .say {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  #buddy2 .acts {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 8px;
  }
  #buddy2 .acts:empty {
    display: none;
  }
  #buddy2 .acts button {
    font: inherit;
    font-size: 11px;
    border: 1px solid var(--line);
    background: var(--bg2);
    color: var(--fg);
    border-radius: 999px;
    padding: 3px 10px;
    cursor: pointer;
    transition: transform 0.2s var(--spring), background 0.2s, border-color 0.2s, color 0.2s;
  }
  #buddy2 .acts button:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: #000;
    transform: translateY(-1px);
  }

  /* Control Buttons (Minimise & Hide on Hover) */
  #buddy2 .bctl {
    position: absolute;
    right: 4px;
    top: 4px;
    display: flex;
    gap: 4px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s;
    z-index: 3;
  }
  #buddy2:hover .bctl, #buddy2 .bctl:focus-within {
    opacity: 1;
    pointer-events: auto;
  }
  #buddy2 .bctl button {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--card);
    color: var(--fg);
    font-size: 13px;
    line-height: 1;
    cursor: pointer;
    display: grid;
    place-items: center;
    padding: 0;
    transition: transform 0.2s var(--spring), background 0.2s, color 0.2s;
  }
  #buddy2 .bctl button:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: #000;
    transform: scale(1.12);
  }

  /* Minimised & Hidden States */
  #buddy2.min {
    width: 46px;
    height: 58px;
  }
  #buddy2.min .bd-inner {
    transform: scale(0.42);
    transform-origin: bottom left;
    transition: transform 0.4s var(--spring);
  }
  #buddy2.min .say {
    display: none;
  }
  #buddy2.gone {
    display: none !important;
  }

  /* Responsive < 700px */
  @media (max-width: 700px) {
    #buddy2 {
      width: 76px;
      height: 96px;
    }
    #buddy2 svg {
      width: 76px;
      height: 96px;
    }
    #buddy2 .say {
      left: 70px;
      bottom: 84px;
      max-width: 200px;
      font-size: 11px;
    }
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    #buddy2, #buddy2 * {
      animation: none !important;
      transition: none !important;
    }
    #buddy2 .eyes {
      animation: bl 4.2s infinite !important;
    }
  }
  @media (prefers-reduced-motion: reduce) { #buddy2 *, #buddy2 { animation: none !important; transition: none !important; } }


  /* ===================== OPENING SEQUENCE (plays once per visit) ===================== */
  #intro { position: fixed; inset: 0; z-index: 300; background: #000; overflow: hidden; }
  #intro .in-top, #intro .in-bot { position: absolute; left: 0; right: 0; height: 50%; background: #000; transition: transform 1s cubic-bezier(.7,0,.2,1); }
  #intro .in-top { top: 0; border-bottom: 1px solid rgba(229,53,59,.35); }
  #intro .in-bot { bottom: 0; border-top: 1px solid rgba(229,53,59,.35); }
  #intro.out .in-top { transform: translateY(-101%); }
  #intro.out .in-bot { transform: translateY(101%); }
  #intro .in-glow { position: absolute; left: 50%; top: 42%; width: 620px; height: 620px; margin: -310px 0 0 -310px; background: radial-gradient(circle, rgba(229,53,59,.22), transparent 60%); animation: inGlow 3s ease-in-out infinite; }
  @keyframes inGlow { 50% { transform: scale(1.15); opacity: .7; } }
  #intro .in-body { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 18px; padding: 20px; transition: opacity .5s, transform .7s var(--ease); }
  #intro.out .in-body { opacity: 0; transform: scale(1.05); }
  #intro .in-label { position: absolute; left: 22px; top: 18px; font-family: var(--mono); font-size: 11px; color: #6f6a5e; letter-spacing: .06em; }
  #intro .in-robot { width: 118px; height: 118px; filter: drop-shadow(0 0 22px rgba(229,53,59,.45)); animation: inFloat 3.2s ease-in-out infinite; }
  @keyframes inFloat { 50% { transform: translateY(-6px); } }
  #intro .in-eye { transform-box: fill-box; transform-origin: 50% 50%; transform: scaleY(.08); transition: transform .4s cubic-bezier(.34,1.56,.64,1); }
  #intro.awake .in-eye { transform: scaleY(1); }
  #intro .in-bulb { animation: bulb 1.2s ease-in-out infinite; }
  #intro .in-term { font-family: var(--mono); font-size: 12px; color: #8a847a; min-height: 120px; width: min(440px, 88vw); line-height: 1.85; }
  #intro .in-term div { opacity: 0; transform: translateX(-6px); animation: inLine .35s forwards; }
  @keyframes inLine { to { opacity: 1; transform: none; } }
  #intro .in-term .ok { color: #7ee787; }
  #intro .in-bar { width: min(440px, 88vw); height: 2px; background: #1c1c1c; position: relative; overflow: hidden; border-radius: 2px; }
  #intro .in-bar i { position: absolute; inset: 0; background: linear-gradient(90deg, transparent, #e5353b, #fff); transform: translateX(-100%); animation: inBar 2.4s cubic-bezier(.5,0,.2,1) .2s forwards; }
  @keyframes inBar { to { transform: translateX(0); } }
  #intro .in-name { font-size: clamp(34px, 8vw, 84px); font-weight: 700; letter-spacing: -.03em; color: #fff; display: flex; flex-wrap: wrap; justify-content: center; }
  #intro .in-name span { display: inline-block; opacity: 0; transform: translateY(34px) skewY(8deg); filter: blur(8px); transition: opacity .7s cubic-bezier(.2,.7,.2,1), transform .8s cubic-bezier(.2,.7,.2,1), filter .7s; }
  #intro.name .in-name span { opacity: 1; transform: none; filter: none; }
  #intro .in-tag { font-family: var(--mono); font-size: 12px; color: #6f6a5e; opacity: 0; transition: opacity .6s .5s; }
  #intro.name .in-tag { opacity: 1; }
  #intro .in-skip { position: absolute; right: 20px; bottom: 18px; font-family: var(--mono); font-size: 11px; color: #8a847a; background: transparent; border: 1px solid #2a2a2a; border-radius: 999px; padding: 6px 12px; cursor: pointer; }
  #intro .in-skip:hover { color: #fff; border-color: var(--red); }

  /* robot: richer design */
  #buddy2 .rb-scanbar { animation: scan 2.4s linear infinite; }
  @keyframes scan { 0% { transform: translateY(0); } 100% { transform: translateY(22px); } }
  #buddy2 .rb-eq rect { fill: #7cf0ff; transform-box: fill-box; transform-origin: 50% 100%; animation: eq .9s ease-in-out infinite alternate; }
  #buddy2 .rb-eq rect:nth-child(2) { animation-delay: .2s; }
  #buddy2 .rb-eq rect:nth-child(3) { animation-delay: .4s; }
  #buddy2 .rb-eq rect:nth-child(4) { animation-delay: .1s; }
  @keyframes eq { to { transform: scaleY(.25); } }
  #buddy2 .rb-eq { opacity: 0; transition: opacity .3s; }
  #buddy2.talk .rb-eq { opacity: 1; }
  #buddy2.talk .rb-eq rect { animation-duration: .22s; }
  #buddy2 .rb-ring { transform-origin: 50px 72px; transform-box: view-box; animation: spin 3s linear infinite; }
  #buddy2.walk .rb-ring { animation-duration: .9s; }
  #buddy2 .rb-core { transform-origin: 50px 72px; transform-box: view-box; animation: corePulse 1.8s ease-in-out infinite; }
  @keyframes corePulse { 50% { transform: scale(1.25); opacity: .7; } }
  #buddy2 .rb-jet { fill: #7cf0ff; opacity: 0; transform-box: fill-box; transform-origin: 50% 0; transition: opacity .3s; filter: blur(.6px); }
  #buddy2.walk .rb-jet { opacity: .9; animation: jet .14s ease-in-out infinite alternate; }
  @keyframes jet { to { transform: scaleY(1.6); } }
  #buddy2 .rb-holo { fill: none; stroke: #7cf0ff; stroke-width: .8; stroke-dasharray: 3 3; opacity: 0; transform-box: view-box; transform-origin: 50px 96px; transition: opacity .4s; }
  #buddy2.sit .rb-holo, #buddy2.sleep .rb-holo { opacity: .85; animation: spin 6s linear infinite; }
  #buddy2 .rb-happy { opacity: 0; transition: opacity .2s; }
  #buddy2.happy .rb-happy { opacity: 1; }
  #buddy2.happy .rb-eye { transform: scaleY(.1); }
  #buddy2 .rb-side { fill: #7cf0ff; animation: led 1.4s ease-in-out infinite; }
  #buddy2 .rb-led.b { animation-delay: .4s; }
  #buddy2 .rb-led.c { animation-delay: .8s; }
  #buddy2 .rb-torso { transform-box: view-box; transform-origin: 50px 74px; animation: breathe 3.4s ease-in-out infinite; }
  @keyframes breathe { 50% { transform: scale(1, 1.02); } }
  #buddy2 .rb-hand { transform-box: fill-box; transform-origin: 50% 50%; }
  #buddy2.wave .rb-hand { animation: handWave .3s ease-in-out infinite alternate; }
  @keyframes handWave { to { transform: rotate(-14deg); } }

  /* Tokyo Drift Theme & Effects */
  #cursorSpotlight { position: fixed; inset: 0; pointer-events: none; z-index: 1; background: radial-gradient(520px circle at var(--cx, 50%) var(--cy, 50%), rgba(0, 229, 255, 0.09) 0%, transparent 62%); display: none; }
  @media (pointer: fine) { #cursorSpotlight { display: block; } }
  #cursorSmokeCanvas { position: fixed; inset: 0; pointer-events: none; z-index: 2; width: 100%; height: 100%; }
  @keyframes brandGlitch { 0%, 94%, 100% { transform: none; text-shadow: none; } 96% { transform: translate(2px, 0); text-shadow: -2px 0 #00e5ff, 2px 0 #ff4d2e; } 98% { transform: translate(-2px, 0); text-shadow: 2px 0 #00e5ff, -2px 0 #ff4d2e; } }
  .brand { animation: brandGlitch 6s infinite; }
  .click-ripple { position: absolute; border-radius: 50%; background: currentColor; opacity: 0.35; pointer-events: none; transform: translate(-50%, -50%) scale(0); animation: rippleSpread 0.65s linear forwards; }
  @keyframes rippleSpread { to { transform: translate(-50%, -50%) scale(2); opacity: 0; } }
  #scanlines { position: fixed; inset: 0; pointer-events: none; z-index: 9998; opacity: 0; transition: opacity 0.25s ease; background: repeating-linear-gradient(to bottom, rgba(0, 0, 0, 0.09) 0 1px, transparent 1px 3px); }
  #scanlines.active { opacity: 1; }
  #scanlines::after { content: ""; position: absolute; left: 0; right: 0; top: -140px; height: 120px; background: linear-gradient(180deg, transparent, rgba(0, 229, 255, 0.07), transparent); animation: scanlineBand 7s linear infinite; }
  @keyframes scanlineBand { 0% { top: -140px; } 100% { top: 100vh; } }
  #nosBoost { position: fixed; inset: 0; pointer-events: none; z-index: 9999; opacity: 0; transform: scale(1.08); transition: opacity 1.3s cubic-bezier(.2, .7, .2, 1), transform 1.3s cubic-bezier(.2, .7, .2, 1); background: repeating-radial-gradient(circle at center, rgba(0, 229, 255, 0.14) 0 2px, transparent 2px 74px); }
  #nosBoost.active { opacity: 1; transform: scale(1); }
  body.nos-shaking { animation: nosShakeAnim 1.2s steps(2); }
  @keyframes nosShakeAnim { 0%, 100% { transform: translate(0, 0); } 20% { transform: translate(-2px, 1px); } 40% { transform: translate(2px, -2px); } 60% { transform: translate(-1px, 2px); } 80% { transform: translate(2px, -1px); } }
  #routeWipe { position: fixed; inset: 0; pointer-events: none; z-index: 10000; opacity: 1; transform: translateX(-110%); background: linear-gradient(108deg, rgba(6, 3, 12, 0.98) 0%, rgba(26, 10, 34, 0.96) 38%, rgba(0, 229, 255, 0.45) 47%, rgba(255, 248, 220, 0.95) 50%, rgba(255, 77, 46, 0.5) 53%, rgba(26, 10, 34, 0.96) 62%, rgba(6, 3, 12, 0.98) 100%); box-shadow: 0 0 100px rgba(0, 229, 255, 0.6); }
  #routeWipe.wiping { animation: routeWipeSlide 2.0s cubic-bezier(.4, 0, .2, 1) forwards; }
  #routeWipe.wipe-exit { animation: routeWipeExit 1.0s cubic-bezier(0, .5, .25, 1) forwards; }
  @keyframes routeWipeSlide { 0% { transform: translateX(-110%); } 100% { transform: translateX(110%); } }
  @keyframes routeWipeExit { 0% { transform: translateX(0%); } 100% { transform: translateX(110%); } }
  .wipe-car-wrap { position: absolute; top: 50%; left: 50%; width: 190px; height: 80px; transform: translate(-50%, -50%) rotate(7deg); pointer-events: none; animation: wipeCarRock 0.32s ease-in-out infinite alternate; }
  @keyframes wipeCarRock { 0% { transform: translate(-50%, -50%) rotate(5.5deg) translateY(0); } 100% { transform: translate(-50%, -50%) rotate(8.5deg) translateY(-3px); } }
  .wipe-car-svg { width: 100%; height: 100%; filter: drop-shadow(0 0 18px rgba(0, 229, 255, 0.95)) drop-shadow(0 0 36px rgba(255, 77, 46, 0.75)); }
  .wipe-speedline { position: absolute; right: 94%; top: 60%; width: 440px; height: 3.5px; background: linear-gradient(90deg, transparent, rgba(0, 229, 255, 0.4), rgba(0, 229, 255, 0.85), #fff8dc); box-shadow: 0 0 16px rgba(0, 229, 255, 0.9), 0 0 32px rgba(0, 229, 255, 0.5); }
  .wipe-speedline-top { position: absolute; right: 94%; top: 34%; width: 320px; height: 2.5px; background: linear-gradient(90deg, transparent, rgba(255, 77, 46, 0.3), rgba(255, 77, 46, 0.85), #ff3b3b); box-shadow: 0 0 12px rgba(255, 77, 46, 0.85); }

  /* Article Drift */
  .article-drift-header { position: relative; height: 140px; border-radius: 14px; overflow: hidden; background: linear-gradient(180deg, #06030c 0%, #1a0a22 65%, #3d0f1c 100%); border: 1px solid rgba(0, 229, 255, 0.22); margin-bottom: 28px; box-shadow: 0 16px 36px -12px rgba(0, 0, 0, 0.8); }
  .article-drift-stars { position: absolute; inset: 0; pointer-events: none; }
  .drift-star { position: absolute; width: 1.5px; height: 1.5px; border-radius: 50%; background: #ffffff; }
  .article-drift-road { position: absolute; left: 0; right: 0; bottom: 24px; height: 3px; background: repeating-linear-gradient(90deg, var(--accent, #00e5ff) 0 36px, transparent 36px 72px); background-size: 72px 100%; box-shadow: 0 0 10px var(--accent, #00e5ff), 0 0 20px var(--accent-glow, rgba(0, 229, 255, 0.4)); animation: driftRoadScroll 0.8s linear infinite; }
  @keyframes driftRoadScroll { from { background-position: 0 0; } to { background-position: 72px 0; } }
  .article-drift-car-wrap { position: absolute; bottom: 22px; width: 120px; height: 50px; left: -130px; animation: driftCarDrive 4.2s linear infinite; will-change: left; pointer-events: none; }
  @keyframes driftCarDrive { 0% { left: -130px; } 100% { left: 100%; } }
  .article-drift-car-svg { width: 100%; height: 100%; filter: drop-shadow(0 0 8px rgba(0, 229, 255, 0.55)); animation: driftCarRock 0.5s ease-in-out infinite alternate; transform-origin: 50% 80%; }
  @keyframes driftCarRock { 0% { transform: rotate(-2deg); } 100% { transform: rotate(2deg); } }
  article h2 { position: relative; }
  article h2::after { content: ""; position: absolute; left: 0; bottom: -8px; width: 100%; height: 2px; background: linear-gradient(90deg, var(--accent, #00e5ff), var(--amber, #ff4d2e), transparent); transform-origin: left; transform: scaleX(0); transition: transform 1.1s var(--ease); pointer-events: none; }
  article h2.revealed::after { transform: scaleX(1); }
  #body > p, #body > ul, #body > ol, #body > .codeblock, #body > h2, #body > h3, #body > blockquote { opacity: 0; transform: translateX(-14px); transition: opacity 0.7s var(--ease), transform 0.7s var(--ease); }
  #body > .in-view { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .article-drift-road, .article-drift-car-wrap, .article-drift-car-svg, #routeWipe, #scanlines, #nosBoost, body.nos-shaking, .brand { animation: none !important; }
    .article-drift-car-wrap { display: none !important; }
    #body > p, #body > ul, #body > ol, #body > .codeblock, #body > h2, #body > h3, #body > blockquote { opacity: 1 !important; transform: none !important; }
    article h2::after { transform: scaleX(1) !important; transition: none !important; }
  }
</style>
</head>
