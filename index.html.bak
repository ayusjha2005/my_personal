      <a class="ficon pulse" data-social="linkedin" style="--c:#0a66c2; --i:1" target="_blank" rel="noopener" aria-label="LinkedIn"><span class="fb" data-icon="linkedin"></span><span class="flabel">LinkedIn</span></a>
      <a class="ficon pulse" data-social="x" style="--c:#e8e8e8; --i:2" target="_blank" rel="noopener" aria-label="X"><span class="fb" data-icon="x"></span><span class="flabel">X / Twitter</span></a>
      <a class="ficon pulse" data-social="instagram" style="--c:#e1306c; --i:3" target="_blank" rel="noopener" aria-label="Instagram"><span class="fb" data-icon="instagram"></span><span class="flabel">Instagram</span></a>
