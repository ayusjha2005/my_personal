/* =============== HELPERS + STATE =============== */
const app = document.getElementById('app');
let query = '';
let sortOrder = 'newest';
const fmtDate = d => new Date(d + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const readTime = html => Math.max(1, Math.round(html.replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length / 200));
const sortedPosts = () => [...POSTS].sort((a, b) => sortOrder === 'newest' ? b.date.localeCompare(a.date) : a.date.localeCompare(b.date));
const getLikes = slug => { try { return +(localStorage.getItem('likes:' + slug) || 0); } catch (e) { return 0; } };
const setLikes = (slug, n) => { try { localStorage.setItem('likes:' + slug, n); } catch (e) {} };
const liked = slug => { try { return localStorage.getItem('liked:' + slug) === '1'; } catch (e) { return false; } };
const setLiked = (slug, v) => { try { localStorage.setItem('liked:' + slug, v ? '1' : '0'); } catch (e) {} };

function setActiveNav(route) {
  document.querySelectorAll('nav.main a[data-route]').forEach(a => a.classList.toggle('on', a.dataset.route === route));
}

