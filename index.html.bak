  document.getElementById('q').addEventListener('input', e => { query = e.target.value; renderPosts(); });
  document.querySelectorAll('.seg button').forEach(b => b.addEventListener('click', () => {
    sortOrder = b.dataset.sort;
    document.querySelectorAll('.seg button').forEach(x => x.classList.toggle('on', x === b));
    renderPosts();
  }));
  renderPosts();
  typeTerminal();
  initScene();
  initHomeFx();
}

function renderPosts() {
  const q = query.trim().toLowerCase();
  const list = sortedPosts().filter(p => !q || (p.title + ' ' + p.excerpt).toLowerCase().includes(q));
  document.getElementById('count').textContent = list.length + ' / ' + POSTS.length;
  const box = document.getElementById('posts');
  box.innerHTML = list.length ? list.map((p, i) => `
    <a class="post" style="--i:${i}" href="#/post/${p.slug}" data-mx>
      <div class="meta"><span>${fmtDate(p.date)}</span><span>·</span><span>${readTime(p.body)} min read</span></div>
      <h3>${p.title}</h3>
      <p>${p.excerpt}</p>
      <span class="arrow">↗</span>
    </a>`).join('') : '<div class="empty">no posts match. try another search.</div>';
  box.querySelectorAll('[data-mx]').forEach(card => card.addEventListener('pointermove', e => {
    const r = card.getBoundingClientRect();
    card.style.setProperty('--mx', (e.clientX - r.left) + 'px');
    card.style.setProperty('--my', (e.clientY - r.top) + 'px');
  }));
}

function typeTerminal() {
  const el = document.getElementById('termBody');
  if (!el) return;
  const script = [
    ['p', '$ whoami'],
    ['', 'engineer · writer · night-time tinkerer'],
    ['p', '$ ls posts/ | tail -3'],
    ['', POSTS.map(p => p.slug + '.md').join('\n')],
    ['p', '$ git log --oneline -1'],
    ['ok', '✓ ' + sortedPosts()[0].title.toLowerCase()],
  ];
  let html = '', li = 0, ci = 0;
  const cursor = '<span class="c"></span>';
  (function step() {
    if (!el.isConnected) return;
    if (li >= script.length) { el.innerHTML = html + cursor; return; }
    const [cls, text] = script[li];
    const open = cls ? `<span class="${cls}">` : '<span>';
    ci = Math.min(ci + 2, text.length);
    el.innerHTML = html + open + text.slice(0, ci).replace(/</g, '&lt;') + '</span>' + cursor;
    if (ci >= text.length) { html += open + text.replace(/</g, '&lt;') + '</span><br>'; li++; ci = 0; setTimeout(step, 420); }
    else setTimeout(step, 22);
  })();
}

/* =============== POST =============== */
function postView(slug) {
  const list = sortedPosts();
  const p = list.find(x => x.slug === slug);
  if (!p) return notFound();
  setActiveNav('');
  const idx = list.indexOf(p);
  const next = list[idx + 1], prev = list[idx - 1];
  const related = list.filter(x => x.slug !== slug).slice(0, 2);
  const likes = getLikes(slug);
  app.innerHTML = `
    <div class="article-wrap view">
      <aside class="toc" id="toc"><h4>on this page</h4></aside>
      <article>
        <div class="crumb"><a href="#/">posts</a> / ${p.slug}</div>
        <h1>${p.title}</h1>
        <div class="byline"><span>${fmtDate(p.date)}</span><span>${readTime(p.body)} min read</span><span id="viewStat">· · ·</span></div>
        <div class="reader-tools" aria-label="reading settings"><span>text size</span><button type="button" data-reader="down" aria-label="smaller text">A−</button><button type="button" data-reader="up" aria-label="larger text">A+</button></div>
        <div id="body">${p.body}</div>
        <div class="actions-row">
          <button class="btn ${liked(slug) ? 'on' : ''}" id="likeBtn" type="button"><span class="heart" id="heart">${liked(slug) ? '♥' : '♡'}</span> <span id="likeCount">${likes}</span></button>
          <a class="btn" id="shareX" href="#" target="_blank" rel="noopener">share on X ↗</a>
          <button class="btn" id="nativeShare" type="button">share ↗</button>
          <button class="btn" id="copyLink" type="button">copy link</button>
        </div>
        <div class="related">
          <h4>keep reading</h4>
          <div class="posts">
            ${related.map((r, i) => `<a class="post" style="--i:${i}" href="#/post/${r.slug}" data-mx><div class="meta"><span>${fmtDate(r.date)}</span></div><h3>${r.title}</h3><p>${r.excerpt}</p><span class="arrow">↗</span></a>`).join('')}
          </div>
        </div>
        <div class="pn">
          ${prev ? `<a class="btn" href="#/post/${prev.slug}">← ${prev.title}</a>` : '<span></span>'}
          ${next ? `<a class="btn" href="#/post/${next.slug}">${next.title} →</a>` : '<span></span>'}
        </div>
      </article>
    </div>
    <div class="progress" id="readBar"></div>`;
  enhanceArticle(p);
  api('/api/posts/' + p.slug + '/view', { method: 'POST' }).catch(() => {});
  api('/api/posts/' + p.slug).then(j => { setLikes(p.slug, j.likes); const lc = document.getElementById('likeCount'); if (lc) lc.textContent = j.likes; }).catch(() => {});
}

function enhanceArticle(p) {
  const body = document.getElementById('body');
  body.querySelectorAll('.codeblock').forEach(cb => {
    const bar = document.createElement('div'); bar.className = 'bar2';
    bar.innerHTML = `<span>${cb.dataset.lang || 'code'}</span><button type="button">copy</button>`;
    cb.prepend(bar);
    const btn = bar.querySelector('button');
    btn.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(cb.querySelector('code').innerText); } catch (e) {}
      cb.classList.add('copied'); btn.textContent = 'copied ✓';
      setTimeout(() => { cb.classList.remove('copied'); btn.textContent = 'copy'; }, 1500);
    });
  });
  const toc = document.getElementById('toc');
  const heads = [...body.querySelectorAll('h2')];
  heads.forEach((h, i) => {
    h.id = 'sec-' + i;
    const a = document.createElement('a'); a.href = '#sec-' + i; a.textContent = h.textContent; toc.appendChild(a);
  });
  const links = [...toc.querySelectorAll('a')];
  const spy = new IntersectionObserver(es => es.forEach(e => {
    if (!e.isIntersecting) return;
    links.forEach(a => a.classList.toggle('on', a.getAttribute('href') === '#' + e.target.id));
  }), { rootMargin: '-35% 0px -60% 0px' });
  heads.forEach(h => spy.observe(h));

  const bar = document.getElementById('readBar');
  const onScroll = () => {
    const r = body.getBoundingClientRect();
    const total = body.offsetHeight - innerHeight * .4;
    bar.style.width = Math.min(100, Math.max(0, -r.top / total * 100)) + '%';
  };
  addEventListener('scroll', onScroll, { passive: true }); onScroll();

  const likeBtn = document.getElementById('likeBtn');
  likeBtn.addEventListener('click', () => {
    const on = !liked(p.slug);
    setLiked(p.slug, on);
    const n = getLikes(p.slug) + (on ? 1 : -1);
    setLikes(p.slug, Math.max(0, n));
    api('/api/posts/' + p.slug + '/like', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ cid: clientId(), liked: on }) })
      .then(j => { setLikes(p.slug, j.likes); const lc = document.getElementById('likeCount'); if (lc) lc.textContent = j.likes; })
      .catch(() => {});
    likeBtn.classList.toggle('on', on);
    const heart = document.getElementById('heart');
    heart.textContent = on ? '♥' : '♡';
    heart.classList.remove('pop'); void heart.offsetWidth; heart.classList.add('pop');
    document.getElementById('likeCount').textContent = Math.max(0, n);
    if (on && window.__burst) { const r = likeBtn.getBoundingClientRect(); window.__burst(r.left + r.width / 2, r.top + r.height / 2); }
  });

  const text = encodeURIComponent(p.title + ' by @yourhandle');
  document.getElementById('shareX').href = `https://x.com/intent/post?text=${text}&url=${encodeURIComponent(location.href)}`;
  document.getElementById('copyLink').addEventListener('click', async e => {
    try { await navigator.clipboard.writeText(location.href); e.target.textContent = 'copied ✓'; }
    catch (err) { e.target.textContent = 'failed'; }
    setTimeout(() => e.target.textContent = 'copy link', 1500);
  });
  app.querySelectorAll('.related [data-mx]').forEach(card => card.addEventListener('pointermove', e => {
    const r = card.getBoundingClientRect();
    card.style.setProperty('--mx', (e.clientX - r.left) + 'px');
    card.style.setProperty('--my', (e.clientY - r.top) + 'px');
  }));
  if (window.initArticleDrift) window.initArticleDrift();
}

/* =============== WRITING CORNER =============== */
function cornerView() {
  setActiveNav('corner');
  app.innerHTML = `
    <section class="view">
      <div class="xhead" style="margin-bottom:26px"><span class="t">writing corner</span><span>a small desk for drafts, half-thoughts and the reading list</span></div>
      <div class="corner">
        <div class="desk">
          <div class="lamp"></div>
          <div class="label">drafting <b>~ ${sortedPosts().length} done</b></div>
          <div class="paper">
            <span class="ln" style="width:60%"></span>
            <span class="ln" style="width:85%"></span>
            <span class="ln" style="width:40%"></span>
            <div><span class="ink">the stable part of the prompt goes first</span></div>
          </div>
          <svg class="sitter" viewBox="0 0 96 92" aria-hidden="true">
            <path class="tail" d="M28 84 C8 84 6 60 18 56" stroke="#e8e8e8" stroke-width="5" fill="none" stroke-linecap="round"/>
            <ellipse cx="46" cy="72" rx="26" ry="18" fill="#e8e8e8"/>
            <circle cx="48" cy="40" r="20" fill="#e8e8e8"/>
            <path d="M32 30 L34 8 L48 24 Z" fill="#e8e8e8"/><path d="M64 30 L62 8 L48 24 Z" fill="#e8e8e8"/>
            <path d="M36 28 L37 16 L44 24 Z" fill="#e5353b"/><path d="M60 28 L59 16 L52 24 Z" fill="#e5353b"/>
            <g class="eyes"><circle cx="41" cy="40" r="2.2" fill="#000"/><circle cx="55" cy="40" r="2.2" fill="#000"/></g>
            <path d="M46 47 Q48 50 50 47" stroke="#000" stroke-width="1.2" fill="none"/>
            <g class="writing"><path d="M62 62 L80 52" stroke="#e8e8e8" stroke-width="5" stroke-linecap="round"/><path d="M80 52 L84 46" stroke="#e5353b" stroke-width="3" stroke-linecap="round"/></g>
          </svg>
        </div>
        <div class="notes">
          <h3>scribbles · latest first</h3>
          ${NOTES.map(n => `<div class="note"><time>${n.date}</time><p>${n.text}</p></div>`).join('')}
        </div>
      </div>
      <div class="corner-list">
        <div class="xhead"><span class="t">reading list</span><a href="#/">all posts →</a></div>
        <div class="posts">
          ${sortedPosts().map((p, i) => `<a class="post" style="--i:${i}" href="#/post/${p.slug}" data-mx><div class="meta"><span>${fmtDate(p.date)}</span><span>·</span><span>${readTime(p.body)} min read</span></div><h3>${p.title}</h3><p>${p.excerpt}</p><span class="arrow">↗</span></a>`).join('')}
        </div>
      </div>
    </section>`;
  app.querySelectorAll('[data-mx]').forEach(card => card.addEventListener('pointermove', e => {
    const r = card.getBoundingClientRect();
    card.style.setProperty('--mx', (e.clientX - r.left) + 'px');
    card.style.setProperty('--my', (e.clientY - r.top) + 'px');
  }));
}

/* =============== ABOUT =============== */
function aboutView() {
  setActiveNav('about');
  app.innerHTML = `<section class="view">${ABOUT_HTML()}</section>`;
  const form = document.getElementById('newsForm');
  const input = document.getElementById('newsEmail');
  const msg = document.getElementById('newsMsg');
  form.addEventListener('submit', e => {
    e.preventDefault();
    const ok = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(input.value.trim());
    input.classList.remove('bad'); void input.offsetWidth;
    if (!ok) { input.classList.add('bad'); msg.className = 'msg'; msg.textContent = 'enter a valid email address'; return; }
    msg.className = 'msg'; msg.style.color = ''; msg.textContent = 'subscribing…';
    api('/api/subscribe', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: input.value.trim() }) })
      .then(j => { msg.className = 'msg ok'; msg.textContent = '✓ ' + j.message; input.value = ''; })
      .catch(err => { msg.className = 'msg'; msg.style.color = 'var(--red)'; msg.textContent = err.message; });
  });
}

function notFound() {
  setActiveNav('');
  app.innerHTML = `<section class="view" style="text-align:center;padding-top:80px"><h1>404</h1><p style="color:var(--muted);margin-top:10px">this page wandered off.</p><p style="margin-top:20px"><a class="btn primary" href="#/">back home</a></p></section>`;
}

/* =============== API =============== */
async function api(path, opts = {}) {
  const r = await fetch(path, opts);
  let j = null;
  try { j = await r.json(); } catch (e) {}
  if (!r.ok) throw new Error((j && j.error) || ('request failed (' + r.status + ')'));
  return j;
}
function clientId() {
  try {
    let id = localStorage.getItem('cid');
    if (!id) {
      id = (crypto.randomUUID ? crypto.randomUUID() : Date.now().toString(36) + Math.random().toString(36).slice(2) + Math.random().toString(36).slice(2));
      localStorage.setItem('cid', id);
    }
    return id;
  } catch (e) { return 'anon-' + Math.random().toString(36).slice(2) + Date.now().toString(36); }
}
async function loadData() {
  try {
    const [posts, notes, socials, config] = await Promise.all([api('/api/posts'), api('/api/notes'), api('/api/socials'), api('/api/config')]);
    POSTS = posts; NOTES = notes; SOCIALS = socials;
    CONFIG = { ...(config.profile || {}), site: config.site || {} };
    applyConfig();
    document.dispatchEvent(new Event('socials-loaded'));
  } catch (e) {
    console.warn('could not reach the blog API:', e.message);
  }
}
document.addEventListener('submit', async e => {
  if (e.target.id !== 'contactForm') return;
  e.preventDefault();
  const f = e.target, msg = document.getElementById('contactMsg'), btn = f.querySelector('button');
  const body = Object.fromEntries(new FormData(f));
  btn.disabled = true; btn.textContent = 'sending…';
  try {
    const j = await api('/api/contact', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    msg.className = 'msg ok'; msg.textContent = '✓ ' + j.message; f.reset();
    if (window.__burst) { const r = btn.getBoundingClientRect(); window.__burst(r.left + r.width / 2, r.top + r.height / 2); }
  } catch (err) {
    msg.className = 'msg err'; msg.textContent = err.message;
  }
  btn.disabled = false; btn.textContent = 'send';
});

/* =============== PROFILE BINDINGS (from dashboard settings) =============== */
function applyConfig() {
  if (!CONFIG) return;
  const name = CONFIG.name || 'Ayush Jha';
  const handle = (CONFIG.handle || 'ayush').replace(/[^a-z0-9_.-]/gi, '') || 'blog';
  const brand = document.querySelector('.brand');
  if (brand && brand.firstChild) brand.firstChild.textContent = '~/' + handle;
  document.querySelectorAll('[data-bind="handle"]').forEach(el => { el.textContent = handle; });
  document.querySelectorAll('[data-bind="name"]').forEach(el => { el.textContent = name; });
  document.querySelectorAll('[data-bind="tagline"]').forEach(el => { el.textContent = CONFIG.tagline || 'building systems that think'; });
  document.querySelectorAll('[data-bind="email"]').forEach(el => { el.textContent = CONFIG.email || 'hello@yourdomain.com'; });
  const big = document.getElementById('fbig');
  if (big) big.textContent = name;
  const site = CONFIG.site || {};
  if (site.title) document.title = site.title;
  const md = document.querySelector('meta[name=description]');
  if (md && site.description) md.content = site.description;
}
function aboutBio() {
  if (CONFIG && CONFIG.bio) return CONFIG.bio.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  return `I'm Ayush Jha, an engineer working on distributed systems and AI infrastructure. This blog is for notes I wish I had found earlier: things I tried, what broke, and what I'd do differently.`;
}

/* =============== ROUTER + REVEAL =============== */
let revealIO = null;
function observeReveals() {
  if (!revealIO) revealIO = new IntersectionObserver(es => es.forEach(e => {
    if (e.isIntersecting) { e.target.classList.add('in'); revealIO.unobserve(e.target); }
  }), { threshold: .12 });
  document.querySelectorAll('.rv:not(.in), .exp:not(.in)').forEach(el => revealIO.observe(el));
}

function route() {
  document.title = (CONFIG && CONFIG.site && CONFIG.site.title) || 'Ayush Jha · tech blog';
  const h = location.hash || '#/';
  if (h === '#/' || h === '#') homeView();
  else if (h.startsWith('#/post/')) postView(h.replace('#/post/', ''));
  else if (h === '#/corner') cornerView();
  else if (h === '#/about') aboutView();
  else notFound();
  window.scrollTo({ top: 0, behavior: 'instant' });
  observeReveals();
}
addEventListener('hashchange', route);
</script>

<script>
/* =============== SCENE (night ridges, moon, walking cat) =============== */
function whenIntroDone(cb) {
  if (window.__introDone) cb();
  else (window.__introWait = window.__introWait || []).push(cb);
}
function initScene() {
    const c = document.getElementById('scene');
    if (!c) return;
    const ctx = c.getContext('2d');
    if (!ctx) return;

    const TAU = Math.PI * 2;
    const prefersReducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let W = 0, H = 0, dpr = 1, mx = 0.5;
    let animId = null;
    const sceneStartTime = performance.now();

    // Particle & history caps
    const MAX_SMOKE = 420;
    const MAX_SKID = 160;

    const smokePuffs = [];
    const skidPoints = [];

    // Pseudo-random deterministic helper for building layout
    function pseudoRand(seed) {
      const x = Math.sin(seed * 12.9898 + 78.233) * 43758.5453;
      return x - Math.floor(x);
    }

    // 1. Stars (~70 dots in top 45% of sky)
    const stars = [];
    for (let i = 0; i < 70; i++) {
      stars.push({
        fx: pseudoRand(i * 3 + 1),
        fy: pseudoRand(i * 7 + 2) * 0.45,
        r: 0.6 + pseudoRand(i * 11 + 3) * 1.2,
        phase: pseudoRand(i * 13 + 5) * TAU,
      });
    }

    // 2. Rain (~110 streaks)
    const rain = [];
    for (let i = 0; i < 110; i++) {
      rain.push({
        x: pseudoRand(i * 17 + 7),
        y: pseudoRand(i * 19 + 11),
        speed: 0.6 + pseudoRand(i * 23 + 13) * 0.6,
      });
    }

    // 3. Skyline Layers Configuration
    const layerDefs = [
      { count: 22, color: '#141026', minH: 0.25, maxH: 0.55, parallax: 0.25, winDensity: 0.25 },
      { count: 15, color: '#0b0716', minH: 0.30, maxH: 0.70, parallax: 0.60, winDensity: 0.40 },
      { count: 9,  color: '#050309', minH: 0.20, maxH: 0.50, parallax: 1.10, winDensity: 0.55 },
    ];

    const skylineLayers = layerDefs.map((def, layerIdx) => {
      const buildings = [];
      let curX = 0;
      for (let bi = 0; bi < def.count; bi++) {
        const seed = bi + layerIdx * 100;
        const widthRel = 0.05 + pseudoRand(seed * 1.3) * 0.06; // 5% - 11% of W
        const heightRel = def.minH + pseudoRand(seed * 2.7) * (def.maxH - def.minH);
        const hasNeon = pseudoRand(seed * 4.1) < 0.35;
        const neonColor = pseudoRand(seed * 5.3) < 0.4 ? '#00e5ff' : (pseudoRand(seed * 5.3) < 0.7 ? '#ff4d2e' : '#9ad7ff');
        const hasBeacon = pseudoRand(seed * 7.1) < 0.3;

        buildings.push({
          bi,
          seed: pseudoRand(seed * 8.9),
          xRel: curX,
          widthRel,
          heightRel,
          hasNeon,
          neonColor,
          hasBeacon,
          winSeed: seed * 12.3,
        });

        curX += widthRel * (0.85 + pseudoRand(seed * 9.7) * 0.3);
      }
      return { def, buildings };
    });

    // 4. Shooting Star State
    let nextShootingStarTime = 5;
    let currentShootingStar = null;

    // 5. Opening Convoy State
    const convoyCars = [
      { type: 'sports', start: 0.20, bodyColor: '#c81d1d', glowColor: '#00e5ff', phase: 0 },
      { type: 'sports', start: 0.65, bodyColor: '#e8edf5', glowColor: '#ff4d2e', phase: 1.7 },
      { type: 'sports', start: 1.10, bodyColor: '#101622', glowColor: '#00e5ff', phase: 3.4 },
      { type: 'police', start: 1.30, phase: 0 },
      { type: 'police', start: 1.75, phase: 1.5 },
    ];

    function resize() {
      dpr = window.devicePixelRatio || 1;
      const rect = c.getBoundingClientRect();
      W = rect.width || c.parentElement.clientWidth || 800;
      H = rect.height || 230;
      c.width = W * dpr;
      c.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    resize();
    window.addEventListener('resize', resize);

    if (c.parentElement) {
      c.parentElement.addEventListener('pointermove', (e) => {
        const r = c.getBoundingClientRect();
        mx = (e.clientX - r.left) / (r.width || 1);
      });
      c.parentElement.addEventListener('pointerleave', () => { mx = 0.5; });
    }

    // Helper: Spawn smoke puff
    function spawnSmoke(x, y, vx, vy) {
      if (prefersReducedMotion || smokePuffs.length >= MAX_SMOKE) return;
      smokePuffs.push({
        x,
        y,
        vx,
        vy,
        radius: 2 + Math.random() * 2,
        life: 1,
      });
    }

    // Drawing: Sports Car
    function drawSportsCar(x, gy, k, yaw, distance, bodyColor, glowColor) {
      ctx.save();
      ctx.translate(x, gy);
      ctx.scale(k, k);
      ctx.translate(16, -3);
      ctx.rotate(yaw);
      ctx.translate(-16, 3);

      // Underglow
      ctx.save();
      ctx.beginPath();
      ctx.ellipse(40, 0, 38, 2.6, 0, 0, TAU);
      ctx.fillStyle = glowColor || 'rgba(0,229,255,0.22)';
      ctx.shadowColor = glowColor || '#00e5ff';
      ctx.shadowBlur = 10;
      ctx.fill();
      ctx.restore();

      // Body path
      ctx.beginPath();
      ctx.moveTo(0, -4);
      ctx.lineTo(3, -10);
      ctx.lineTo(16, -13);
      ctx.lineTo(28, -18);
      ctx.lineTo(44, -18);
      ctx.lineTo(54, -12);
      ctx.lineTo(72, -10);
      ctx.lineTo(80, -7);
      ctx.lineTo(80, -3);
      ctx.closePath();
      ctx.fillStyle = bodyColor || '#c81d1d';
      ctx.fill();
      ctx.lineWidth = 0.7;
      ctx.strokeStyle = 'rgba(0,229,255,0.55)';
      ctx.stroke();

      // Glass quad: (28,-18) (44,-18) (50,-12) (24,-12)
      ctx.beginPath();
      ctx.moveTo(28, -18);
      ctx.lineTo(44, -18);
      ctx.lineTo(50, -12);
      ctx.lineTo(24, -12);
      ctx.closePath();
      ctx.fillStyle = 'rgba(0,229,255,0.28)';
      ctx.fill();

      // Red stripe: (6,-7) to (76,-7)
      ctx.beginPath();
      ctx.moveTo(6, -7);
      ctx.lineTo(76, -7);
      ctx.strokeStyle = 'rgba(255,77,46,0.9)';
      ctx.lineWidth = 1.1;
      ctx.stroke();

      // Rear spoiler: rect at (2,-16), 9 x 2, #0a0c14
      ctx.fillStyle = '#0a0c14';
      ctx.fillRect(2, -16, 9, 2);

      // Wheels: at (16,-3) and (64,-3), r = 4.5
      [16, 64].forEach((wx) => {
        ctx.beginPath();
        ctx.arc(wx, -3, 4.5, 0, TAU);
        ctx.fillStyle = '#000000';
        ctx.fill();
        ctx.lineWidth = 0.6;
        ctx.strokeStyle = '#222';
        ctx.stroke();

        // Rotating spokes
        const a = distance / 4.5 + wx;
        ctx.beginPath();
        ctx.moveTo(wx + 3 * Math.cos(a), -3 + 3 * Math.sin(a));
        ctx.lineTo(wx - 3 * Math.cos(a), -3 - 3 * Math.sin(a));
        ctx.strokeStyle = 'rgba(0,229,255,0.6)';
        ctx.lineWidth = 0.7;
        ctx.stroke();
      });

      // Headlight: arc radius 1.5 at (80,-6), #fff8dc, shadowBlur 8, shadowColor #ffd666
      ctx.save();
      ctx.beginPath();
      ctx.arc(80, -6, 1.5, 0, TAU);
      ctx.fillStyle = '#fff8dc';
      ctx.shadowColor = '#ffd666';
      ctx.shadowBlur = 8;
      ctx.fill();
      ctx.restore();

      // Taillight: arc radius 1.2 at (0,-8), #ff3b3b
      ctx.save();
      ctx.beginPath();
      ctx.arc(0, -8, 1.2, 0, TAU);
      ctx.fillStyle = '#ff3b3b';
      ctx.shadowColor = '#ff3b3b';
      ctx.shadowBlur = 6;
      ctx.fill();
      ctx.restore();

      ctx.restore();
    }

    // Drawing: Police Cruiser
    function drawPoliceCruiser(x, gy, k, yaw, distance, t) {
      ctx.save();
      ctx.translate(x, gy);
      ctx.scale(k, k);
      ctx.translate(14, -3);
      ctx.rotate(yaw || 0);
      ctx.translate(-14, 3);

      // Cruiser body: (0,-4) (2,-11) (14,-14) (24,-21) (42,-21) (52,-14) (70,-12) (76,-8) (76,-3)
      ctx.beginPath();
      ctx.moveTo(0, -4);
      ctx.lineTo(2, -11);
      ctx.lineTo(14, -14);
      ctx.lineTo(24, -21);
      ctx.lineTo(42, -21);
      ctx.lineTo(52, -14);
      ctx.lineTo(70, -12);
      ctx.lineTo(76, -8);
      ctx.lineTo(76, -3);
      ctx.closePath();
      ctx.fillStyle = '#e9edf4';
      ctx.fill();
      ctx.lineWidth = 0.8;
      ctx.strokeStyle = '#05060c';
      ctx.stroke();

      // Black stripe: rect (0,-9) 76 x 2.4
      ctx.fillStyle = '#05060c';
      ctx.fillRect(0, -9, 76, 2.4);

      // Windscreen: quad (26,-14) (40,-14) (46,-13) (24,-13)
      ctx.beginPath();
      ctx.moveTo(26, -14);
      ctx.lineTo(40, -14);
      ctx.lineTo(46, -13);
      ctx.lineTo(24, -13);
      ctx.closePath();
      ctx.fillStyle = 'rgba(10,14,24,0.85)';
      ctx.fill();

      // Light bar: red rect (29,-24) 8x3 and blue rect (38,-24) 8x3
      const isFlash = Math.floor(7 * t) % 2 === 0;
      ctx.save();
      ctx.shadowBlur = 10;
      // Red light
      ctx.fillStyle = isFlash ? '#ff2a2a' : '#5a0f0f';
      ctx.shadowColor = isFlash ? '#ff2a2a' : 'transparent';
      ctx.fillRect(29, -24, 8, 3);
      // Blue light
      ctx.fillStyle = isFlash ? '#103366' : '#2a7bff';
      ctx.shadowColor = isFlash ? 'transparent' : '#2a7bff';
      ctx.fillRect(38, -24, 8, 3);
      ctx.restore();

      // Headlight & taillight
      ctx.save();
      ctx.beginPath();
      ctx.arc(76, -6, 1.4, 0, TAU);
      ctx.fillStyle = '#fff8dc';
      ctx.shadowColor = '#ffd666';
      ctx.shadowBlur = 6;
      ctx.fill();

      ctx.beginPath();
      ctx.arc(0, -7, 1.2, 0, TAU);
      ctx.fillStyle = '#ff3b3b';
      ctx.shadowColor = '#ff3b3b';
      ctx.shadowBlur = 5;
      ctx.fill();
      ctx.restore();

      // Wheels: circles r = 4.5 at (14,-3) and (62,-3)
      [14, 62].forEach((wx) => {
        ctx.beginPath();
        ctx.arc(wx, -3, 4.5, 0, TAU);
        ctx.fillStyle = '#000000';
        ctx.fill();

        const a = distance / 4.5 + wx;
        ctx.beginPath();
        ctx.moveTo(wx + 3 * Math.cos(a), -3 + 3 * Math.sin(a));
        ctx.lineTo(wx - 3 * Math.cos(a), -3 - 3 * Math.sin(a));
        ctx.strokeStyle = 'rgba(200,210,230,0.6)';
        ctx.lineWidth = 0.7;
        ctx.stroke();
      });

      ctx.restore();
    }

    // Drawing: Helicopter
    function drawHelicopter(cx, gy, t) {
      const hx = cx - 70;
      const hy = H * 0.14 + 4 * Math.sin(1.1 * t);
      const scale = 1.2;

      ctx.save();
      ctx.translate(hx, hy);
      ctx.scale(scale, scale);

      // Searchlight cone down to (cx + 52, gy - 12)
      // Transform local target coordinate:
      const targetLocalX = (cx + 52 - hx) / scale;
      const targetLocalY = (gy - 12 - hy) / scale;

      const lightGrad = ctx.createLinearGradient(0, 10, targetLocalX, targetLocalY);
      lightGrad.addColorStop(0, 'rgba(255,250,220,0.28)');
      lightGrad.addColorStop(1, 'rgba(255,250,220,0.05)');

      ctx.beginPath();
      ctx.moveTo(-2, 10);
      ctx.lineTo(2, 10);
      ctx.lineTo(targetLocalX + 20, targetLocalY);
      ctx.lineTo(targetLocalX - 20, targetLocalY);
      ctx.closePath();
      ctx.fillStyle = lightGrad;
      ctx.fill();

      // Rotor: ellipse (0,-12), radii 30*(0.55 + 0.45*|sin(28t)|)*1.6 x 1.8
      const rotorW = 30 * (0.55 + 0.45 * Math.abs(Math.sin(28 * t))) * 1.6;
      ctx.beginPath();
      ctx.ellipse(0, -12, rotorW, 1.8, 0, 0, TAU);
      ctx.fillStyle = 'rgba(200,210,225,0.3)';
      ctx.fill();

      // Mast
      ctx.strokeStyle = '#05060c';
      ctx.lineWidth = 1.4;
      ctx.beginPath();
      ctx.moveTo(0, -12);
      ctx.lineTo(0, -8);
      ctx.stroke();

      // Tail boom: polygon (18,-3) (52,-5) (52,-2) (18,2)
      ctx.beginPath();
      ctx.moveTo(18, -3);
      ctx.lineTo(52, -5);
      ctx.lineTo(52, -2);
      ctx.lineTo(18, 2);
      ctx.closePath();
      ctx.fillStyle = '#0a0c14';
      ctx.fill();

      // Tail fin: polygon (50,-5) (54,-14) (56,-13) (53,-3)
      ctx.beginPath();
      ctx.moveTo(50, -5);
      ctx.lineTo(54, -14);
      ctx.lineTo(56, -13);
      ctx.lineTo(53, -3);
      ctx.closePath();
      ctx.fillStyle = '#0a0c14';
      ctx.fill();

      // Tail rotor
      ctx.beginPath();
      ctx.arc(54, -13, 3.5, 0, TAU);
      ctx.fillStyle = 'rgba(200,210,225,0.25)';
      ctx.fill();

      // Body: ellipse (0,0), radii 22 x 10, #0a0c14, stroke rgba(0,229,255,0.5), 0.6px
      ctx.beginPath();
      ctx.ellipse(0, 0, 22, 10, 0, 0, TAU);
      ctx.fillStyle = '#0a0c14';
      ctx.fill();
      ctx.lineWidth = 0.6;
      ctx.strokeStyle = 'rgba(0,229,255,0.5)';
      ctx.stroke();

      // Cockpit: ellipse (-8,-2), radii 9 x 6, rgba(0,229,255,0.3)
      ctx.beginPath();
      ctx.ellipse(-8, -2, 9, 6, 0, 0, TAU);
      ctx.fillStyle = 'rgba(0,229,255,0.3)';
      ctx.fill();

      // Skids: line (-14,12) to (14,12); struts (-6,6)->(-8,12) and (8,6)->(8,12)
      ctx.strokeStyle = '#05060c';
      ctx.lineWidth = 1.2;
      ctx.beginPath();
      ctx.moveTo(-14, 12);
      ctx.lineTo(14, 12);
      ctx.moveTo(-6, 6);
      ctx.lineTo(-8, 12);
      ctx.moveTo(8, 6);
      ctx.lineTo(8, 12);
      ctx.stroke();

      // Nav light: dot r = 1.4 at (-22,0). #ff2a2a when flash is true, #3a0808 otherwise
      const flash = Math.floor(7 * t) % 2 === 0;
      ctx.save();
      ctx.beginPath();
      ctx.arc(-22, 0, 1.4, 0, TAU);
      ctx.fillStyle = flash ? '#ff2a2a' : '#3a0808';
      ctx.shadowColor = flash ? '#ff2a2a' : 'transparent';
      ctx.shadowBlur = 6;
      ctx.fill();
      ctx.restore();

      ctx.restore();
    }

    // MAIN ANIMATION LOOP
    function render(now) {
      if (!c.isConnected) return;
      const t = (now - sceneStartTime) / 1000;
      const gy = H - 5;
      const isMobile = W < 700;
      const carScaleFactor = isMobile ? 0.8 : 1.0;

      ctx.clearRect(0, 0, W, H);

      // 1. Sky Gradient: #06030c (top), #1a0a22 (65%), #3d0f1c (bottom)
      const skyGrad = ctx.createLinearGradient(0, 0, 0, H);
      skyGrad.addColorStop(0, '#06030c');
      skyGrad.addColorStop(0.65, '#1a0a22');
      skyGrad.addColorStop(1, '#3d0f1c');
      ctx.fillStyle = skyGrad;
      ctx.fillRect(0, 0, W, H);

      // 2. Stars
      stars.forEach((st) => {
        const alpha = prefersReducedMotion ? 0.5 : Math.max(0.05, 0.2 + 0.5 * Math.sin(1.4 * t + st.phase));
        ctx.beginPath();
        ctx.arc(st.fx * W, st.fy * H, st.r, 0, TAU);
        ctx.fillStyle = `rgba(220, 235, 255, ${alpha})`;
        ctx.fill();
      });

      // 3. Passing Aircraft Light (moving left at 40 px/s at height H * 0.18)
      if (!prefersReducedMotion) {
        const airX = ((W - (40 * t) % (W + 60)) + 30) % (W + 60) - 30;
        const airY = H * 0.18;
        ctx.save();
        ctx.beginPath();
        ctx.arc(airX, airY, 1.2, 0, TAU);
        ctx.fillStyle = '#ffffff';
        ctx.shadowColor = '#ffffff';
        ctx.shadowBlur = 4;
        ctx.fill();
        ctx.restore();
      }

      // 4. Shooting Star (every 7-16s, 1.2s duration)
      if (!prefersReducedMotion) {
        if (!currentShootingStar && t > nextShootingStarTime) {
          currentShootingStar = {
            t0: t,
            x0: W * (0.4 + Math.random() * 0.5),
            y0: H * (0.02 + Math.random() * 0.12),
            dx: -(0.25 + Math.random() * 0.15) * W,
            dy: 0.35 * H,
          };
          nextShootingStarTime = t + 7 + Math.random() * 9;
        }

        if (currentShootingStar) {
          const age = t - currentShootingStar.t0;
          if (age > 1.2) {
            currentShootingStar = null;
          } else {
            const prog = age / 1.2;
            const sx = currentShootingStar.x0 + currentShootingStar.dx * prog;
            const sy = currentShootingStar.y0 + currentShootingStar.dy * prog;
            const tailLen = 32 * (1 - prog);
            const tailDx = (currentShootingStar.dx / (0.4 * W)) * tailLen;
            const tailDy = (currentShootingStar.dy / (0.35 * H)) * tailLen;

            ctx.save();
            ctx.beginPath();
            ctx.moveTo(sx, sy);
            ctx.lineTo(sx - tailDx, sy - tailDy);
            ctx.strokeStyle = `rgba(255, 255, 255, ${(1 - prog) * 0.8})`;
            ctx.lineWidth = 1.2;
            ctx.stroke();
            ctx.restore();
          }
        }
      }

      // 5. Rain (~110 streaks)
      if (!prefersReducedMotion) {
        ctx.strokeStyle = 'rgba(160,200,255,0.18)';
        ctx.lineWidth = 1;
        ctx.beginPath();
        rain.forEach((r) => {
          r.y += 0.012 * r.speed;
          r.x -= 0.002;
          if (r.y > 1) r.y = 0;
          if (r.x < 0) r.x = 1;

          const rx = r.x * W;
          const ry = r.y * H;
          ctx.moveTo(rx, ry);
          ctx.lineTo(rx - 1.5, ry + 9);
        });
        ctx.stroke();
      }

      // 6. Skyline: 3 Parallax Layers with Assembly on Load
      skylineLayers.forEach((layer, layerIdx) => {
        const def = layer.def;
        const hOffset = (mx - 0.5) * -40 * def.parallax;
        const layerStart = layerIdx * 0.5;

        layer.buildings.forEach((bld) => {
          const towerStart = layerStart + bld.bi * 0.16 + bld.seed * 0.3;
          let p = 1.0;
          if (!prefersReducedMotion) {
            p = Math.max(0, Math.min(1, (t - towerStart) / 1.6));
          }

          if (p <= 0) return;

          const heightSteps = prefersReducedMotion ? 1 : Math.ceil(p * 6) / 6;
          const fullHeight = bld.heightRel * H;
          const curHeight = fullHeight * heightSteps;
          const baseAlpha = Math.min(1, p * 3);
          const winAlpha = Math.min(1, Math.max(0, (p - 0.3) / 0.4));

          const bx = bld.xRel * W + hOffset;
          const bw = bld.widthRel * W;
          const by = H - curHeight;

          // Tower base
          ctx.save();
          ctx.globalAlpha = baseAlpha;
          ctx.fillStyle = def.color;
          ctx.fillRect(bx, by, bw, curHeight);

          // Thin street band at the bottom of each layer (5px tall)
          ctx.fillRect(bx, H - 5, bw, 5);

          // Windows grid: every 9px across, 11px down, size 2.4 x 4.5px
          if (winAlpha > 0.05) {
            ctx.globalAlpha = baseAlpha * winAlpha;
            const cols = Math.floor((bw - 8) / 9);
            const rows = Math.floor((curHeight - 16) / 11);

            for (let cIdx = 0; cIdx < cols; cIdx++) {
              for (let rIdx = 0; rIdx < rows; rIdx++) {
                const wSeed = pseudoRand(bld.winSeed + cIdx * 19 + rIdx * 31);
                if (wSeed < def.winDensity) {
                  const wx = bx + 4 + cIdx * 9;
                  const wy = by + 8 + rIdx * 11;

                  let isWarm = wSeed < def.winDensity * 0.2;
                  let winColor = isWarm ? 'rgba(255,77,46,0.9)' : 'rgba(150,210,255,0.55)';

                  // Subtle flicker on some windows
                  if (!prefersReducedMotion && wSeed < def.winDensity * 0.08) {
                    if (Math.sin(t * 8 + wSeed * 100) < 0) {
                      continue;
                    }
                  }

                  ctx.fillStyle = winColor;
                  ctx.fillRect(wx, wy, 2.4, 4.5);
                }
              }
            }
          }

          // Neon Strip: 10% down tower
          if (bld.hasNeon && p >= 0.8) {
            const ny = by + fullHeight * 0.10;
            ctx.save();
            ctx.shadowColor = bld.neonColor;
            ctx.shadowBlur = 14;
            ctx.fillStyle = bld.neonColor;
            ctx.fillRect(bx + 2, ny, bw - 4, 2);
            ctx.restore();
          }

          // Red Beacon: 4px above roof pulsing
          if (bld.hasBeacon && p >= 0.9) {
            const beaconPulse = prefersReducedMotion ? 0.8 : (0.4 + 0.6 * Math.max(0, Math.sin(2.4 * t + bld.bi)));
            ctx.save();
            ctx.beginPath();
            ctx.arc(bx + bw / 2, by - 4, 1.8, 0, TAU);
            ctx.fillStyle = `rgba(255, 42, 42, ${beaconPulse})`;
            ctx.shadowColor = '#ff2a2a';
            ctx.shadowBlur = 8;
            ctx.fill();
            ctx.restore();
          }

          ctx.restore();
        });
      });

      // 7. Horizon Warm Glow (radial on top of towers)
      const hGlow = ctx.createRadialGradient(W / 2, H * 1.02, 0, W / 2, H * 1.02, W * 0.6);
      hGlow.addColorStop(0, 'rgba(255,77,46,0.22)');
      hGlow.addColorStop(1, 'rgba(255,77,46,0)');
      ctx.fillStyle = hGlow;
      ctx.fillRect(0, 0, W, H);

      // 8. Neon Signs (ドリフト, 東京, 首都高)
      const signs = [
        { text: 'ドリフト', x: W * 0.12, color: '#00e5ff' },
        { text: '東京',     x: W * 0.58, color: '#ff4d2e' },
        { text: '首都高',   x: W * 0.84, color: '#00e5ff' },
      ];

      ctx.save();
      ctx.font = 'bold 16px sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';

      signs.forEach((s, idx) => {
        const sy = H * 0.42 + 6 * idx;
        const signAlpha = prefersReducedMotion ? 1.0 : (Math.sin((3 + idx) * t + idx) > -0.6 ? 1.0 : 0.25);

        ctx.save();
        ctx.globalAlpha = signAlpha;
        ctx.fillStyle = s.color;
        ctx.shadowColor = s.color;
        ctx.shadowBlur = 12;
        ctx.fillText(s.text, s.x, sy);
        ctx.restore();
      });
      ctx.restore();

      // IF REDUCED MOTION IS ENABLED: Stop here!
      // "skip every car, smoke, skid, flash, wipe, NOS and road animation"
      if (prefersReducedMotion) {
        return;
      }

      // 9. Skid Marks Rendering
      if (skidPoints.length > 1) {
        ctx.save();
        ctx.lineWidth = 1.6;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';

        for (let i = 1; i < skidPoints.length; i++) {
          const p1 = skidPoints[i - 1];
          const p2 = skidPoints[i];
          if (!p1 || !p2) continue;

          const alpha = Math.max(0, 1 - (t - p2.t) / 3) * 0.55;
          if (alpha <= 0) continue;

          ctx.strokeStyle = `rgba(0, 229, 255, ${alpha})`;
          ctx.beginPath();
          ctx.moveTo(p1.x, p1.y);
          ctx.lineTo(p2.x, p2.y);
          ctx.stroke();
        }
        ctx.restore();
      }

      // 10. Smoke Puffs Rendering & Physics
      for (let i = smokePuffs.length - 1; i >= 0; i--) {
        const sp = smokePuffs[i];
        sp.x += sp.vx / 60;
        sp.y += sp.vy / 60;
        sp.radius += 0.25;
        sp.life -= 0.012;

        if (sp.life <= 0) {
          smokePuffs.splice(i, 1);
          continue;
        }

        ctx.beginPath();
        ctx.arc(sp.x, sp.y, sp.radius, 0, TAU);
        ctx.fillStyle = `rgba(225, 230, 240, ${sp.life * 0.2})`;
        ctx.fill();
      }

      // 11. CAR 1: OPENING CONVOY (once per page load)
      const convoyLaneY = H - 5 - 0.25 * 34;
      const convoyScale = 1.2 * carScaleFactor;

      convoyCars.forEach((car) => {
        if (t >= car.start) {
          const age = t - car.start;
          const cx = -140 + 300 * age;

          if (cx < W + 220) {
            const yaw = 0.14 * Math.sin(6 * age + car.phase);

            // Smoke puffs while |yaw| > 0.05
            if (Math.abs(yaw) > 0.05) {
              const rwX = cx + 16 * convoyScale;
              const rwY = convoyLaneY - 3 * convoyScale;
              spawnSmoke(rwX, rwY, -(40 + Math.random() * 50), -(10 + Math.random() * 20));
              spawnSmoke(rwX, rwY, -(40 + Math.random() * 50), -(10 + Math.random() * 20));
            }

            // Speed lines behind car
            ctx.save();
            ctx.strokeStyle = car.glowColor || 'rgba(0,229,255,0.35)';
            ctx.globalAlpha = 0.35;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(cx - 40 * convoyScale, convoyLaneY - 8 * convoyScale);
            ctx.lineTo(cx - 160 * convoyScale, convoyLaneY - 8 * convoyScale);
            ctx.stroke();
            ctx.restore();

            if (car.type === 'sports') {
              drawSportsCar(cx, convoyLaneY, convoyScale, yaw, 300 * age, car.bodyColor, car.glowColor);
            } else {
              drawPoliceCruiser(cx, convoyLaneY, convoyScale, yaw, 300 * age, t);
            }
          }
        }
      });

      // Arrival Flash: full-canvas fill with alpha = max(0, 1 - |t - 0.35| * 5) * 0.22
      const flashAlpha = Math.max(0, 1 - Math.abs(t - 0.35) * 5) * 0.22;
      if (flashAlpha > 0.005) {
        ctx.save();
        ctx.fillStyle = `rgba(255, 240, 225, ${flashAlpha})`;
        ctx.fillRect(0, 0, W, H);
        ctx.restore();
      }

      // 12. CAR 2: LOOPING DRIFT CAR (runs forever)
      const driftScale = 1.3 * carScaleFactor;
      const wrapSpan = W + 260;
      const cx = (((120 * t) % wrapSpan) + wrapSpan) % wrapSpan - 130;
      const driftYaw = 0.16 * Math.sin(1.3 * t) - 0.04;
      const isSliding = Math.abs(driftYaw) > 0.07;

      if (isSliding) {
        const rwX = cx + 16 * driftScale;
        const rwY = gy - 3 * driftScale;

        // Smoke puffs
        spawnSmoke(rwX + (Math.random() - 0.5) * 6, rwY, -(25 + Math.random() * 35), -(8 + Math.random() * 18));
        spawnSmoke(rwX + (Math.random() - 0.5) * 6, rwY, -(25 + Math.random() * 35), -(8 + Math.random() * 18));

        // Record skid point
        if (skidPoints.length >= MAX_SKID) {
          skidPoints.shift();
        }
        skidPoints.push({ x: rwX, y: rwY, t });
      } else {
        if (skidPoints.length > 0 && skidPoints[skidPoints.length - 1] !== null) {
          if (skidPoints.length >= MAX_SKID) {
            skidPoints.shift();
          }
          skidPoints.push(null);
        }
      }

      // Clean old skid points (> 3.2s old)
      while (skidPoints.length > 0 && skidPoints[0] && (t - skidPoints[0].t > 3.2)) {
        skidPoints.shift();
      }

      // Draw Drift Car
      drawSportsCar(cx, gy, driftScale, driftYaw, 120 * t, '#c81d1d', '#00e5ff');

      // 13. CAR 3: DRIFT CRUISER (Follows at cx - 170, hidden if W < 700)
      if (!isMobile) {
        const cruiserScale = 1.25 * carScaleFactor;
        const cruiserX = cx - 170;
        drawPoliceCruiser(cruiserX, gy, cruiserScale, driftYaw * 0.6, 120 * t, t);
      }

      // 14. CAR 4: HELICOPTER (Flies above drift chase, hidden if W < 700)
      if (!isMobile) {
        drawHelicopter(cx, gy, t);
      }

      animId = requestAnimationFrame(render);
    }

    if (prefersReducedMotion) {
      render(sceneStartTime);
    } else {
      animId = requestAnimationFrame(render);
    }
  }

function initHomeFx() {
  // graph
  const g = document.getElementById('graph');
  if (g) {
    const months = ['Nov','Dec','Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct'];
    const DAYS = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
    const labels = ['', 'Mon', '', 'Wed', '', 'Fri', ''];
    g.appendChild(document.createElement('span'));
    for (let w = 0; w < 52; w++) {
      const m = document.createElement('span'); m.className = 'm';
      if (w % 4 === 0) m.textContent = months[Math.floor(w / 4.35) % 12];
      g.appendChild(m);
    }
    const cells = [];
    for (let d = 0; d < 7; d++) {
      const lab = document.createElement('span'); lab.className = 'd'; lab.textContent = labels[d]; g.appendChild(lab);
      for (let w = 0; w < 52; w++) {
        const c = document.createElement('span'); c.className = 'cell';
        const r = Math.random();
        c.dataset.lv = r < .4 ? 0 : r < .6 ? 1 : r < .8 ? 2 : r < .93 ? 3 : 4;
        c.addEventListener('pointerenter', e => {
          const t = document.getElementById('tip');
          t.textContent = `${DAYS[d]} · week ${w + 1}`;
          t.style.left = e.clientX + 'px'; t.style.top = e.clientY + 'px'; t.style.opacity = 1;
        });
        c.addEventListener('pointerleave', () => { document.getElementById('tip').style.opacity = 0; });
        g.appendChild(c); cells.push({ el: c, w, d });
      }
    }
    const iv = setInterval(() => {
      if (!g.isConnected) { clearInterval(iv); return; }
      cells.forEach(c => c.el.classList.remove('hot'));
      for (let i = 0; i < 4; i++) cells[Math.floor(Math.random() * cells.length)].el.classList.add('hot');
    }, 2400);
    const gio = new IntersectionObserver(es => es.forEach(e => {
      if (!e.isIntersecting) return;
      cells.forEach(({ el, w, d }) => setTimeout(() => el.classList.add('on'), w * 22 + d * 18));
      gio.disconnect();
    }), { threshold: .3 });
    gio.observe(g);
  }

  // talk covers: spotlight
  document.querySelectorAll('.tcover').forEach(cv => cv.addEventListener('pointermove', e => {
    const r = cv.getBoundingClientRect();
    cv.style.setProperty('--mx', (e.clientX - r.left) + 'px');
    cv.style.setProperty('--my', (e.clientY - r.top) + 'px');
  }));
  // tilt
  document.querySelectorAll('.tilt').forEach(card => {
    card.addEventListener('pointermove', e => {
      const r = card.getBoundingClientRect();
      const px = (e.clientX - r.left) / r.width - .5, py = (e.clientY - r.top) / r.height - .5;
      card.style.transform = `perspective(700px) rotateX(${-py * 6}deg) rotateY(${px * 8}deg) translateY(-3px)`;
    });
    card.addEventListener('pointerleave', () => { card.style.transform = ''; });
  });
  // mailbox: copy with confetti + ripple
  const cm = document.getElementById('copyMail');
  if (cm) {
    cm.addEventListener('click', async () => {
      const r = cm.getBoundingClientRect();
      if (window.__burst) window.__burst(r.left + r.width / 2, r.top + r.height / 2);
      try { await navigator.clipboard.writeText(document.getElementById('email2').textContent.trim()); cm.textContent = 'copied ✓'; }
      catch (e) { cm.textContent = 'failed'; }
      setTimeout(() => cm.textContent = 'copy', 1600);
    });
    const box = cm.parentElement;
    box.addEventListener('pointerdown', e => {
      const r = box.getBoundingClientRect(), s = document.createElement('span');
      s.className = 'rip'; s.style.left = (e.clientX - r.left) + 'px'; s.style.top = (e.clientY - r.top) + 'px';
      s.style.width = s.style.height = '20px'; s.style.marginLeft = s.style.marginTop = '-10px';
      box.appendChild(s); setTimeout(() => s.remove(), 750);
    });
  }
  // headings: scramble once
  const chars = '01/<>#%$&';
  const sIO = new IntersectionObserver(es => es.forEach(e => {
    if (!e.isIntersecting) return;
    const el = e.target, final = el.textContent; let f = 0;
    const id = setInterval(() => {
      f++;
      el.textContent = final.split('').map((ch, i) => (ch === ' ' || i / final.length < f / 14) ? ch : chars[Math.floor(Math.random() * chars.length)]).join('');
      if (f >= 14) { clearInterval(id); el.textContent = final; }
    }, 40);
    sIO.unobserve(el);
  }), { threshold: .6 });
  document.querySelectorAll('.xhead .t').forEach(el => sIO.observe(el));
}

/* =============== GLOBAL: buttons, sparkles, buddy, palette, shortcuts =============== */
(function () {
  // magnetic buttons (delegated, works after re-render)
  document.addEventListener('pointermove', e => {
    const el = e.target.closest && e.target.closest('.btn');
    if (!el) return;
    const r = el.getBoundingClientRect();
    el.style.transform = `translate(${(e.clientX - (r.left + r.width / 2)) * .15}px, ${(e.clientY - (r.top + r.height / 2)) * .2}px)`;
  });
  document.addEventListener('pointerout', e => {
    const el = e.target.closest && e.target.closest('.btn');
    if (el && !el.contains(e.relatedTarget)) el.style.transform = '';
  });

  // back to top + progress
  const prog = document.createElement('div'); prog.id = 'progressTop'; document.body.appendChild(prog);
  const toTop = document.createElement('button'); toTop.id = 'toTop'; toTop.type = 'button'; toTop.setAttribute('aria-label', 'back to top');
  toTop.innerHTML = '<svg viewBox="0 0 48 48"><circle class="track" cx="24" cy="24" r="22"/><circle class="bar" cx="24" cy="24" r="22" stroke-dasharray="138.2" stroke-dashoffset="138.2"/></svg><span>↑</span>';
  document.body.appendChild(toTop);
  const ring = toTop.querySelector('.bar');
  addEventListener('scroll', () => {
    const max = document.documentElement.scrollHeight - innerHeight;
    const p = max > 0 ? scrollY / max : 0;
    prog.style.transform = `scaleX(${p})`;
    ring.style.strokeDashoffset = 138.2 * (1 - p);
    toTop.classList.toggle('show', scrollY > 500);
  }, { passive: true });
  toTop.addEventListener('click', () => scrollTo({ top: 0, behavior: 'smooth' }));
  document.getElementById('backTop').addEventListener('click', e => { e.preventDefault(); scrollTo({ top: 0, behavior: 'smooth' }); });

  // tooltip + confetti + sparkles
  const tip = document.createElement('div'); tip.id = 'tip'; document.body.appendChild(tip);
  const cf = document.createElement('canvas'); cf.id = 'confetti'; document.body.appendChild(cf);
  const cx = cf.getContext('2d'); let parts = [];
  const rsCf = () => { cf.width = innerWidth; cf.height = innerHeight; }; rsCf(); addEventListener('resize', rsCf);
  window.__burst = (x, y) => {
    for (let i = 0; i < 46; i++) {
      const a = Math.random() * Math.PI * 2, s = Math.random() * 6 + 2;
      parts.push({ x, y, vx: Math.cos(a) * s, vy: Math.sin(a) * s - 4, life: 1, c: Math.random() < .5 ? '#e5353b' : '#fff', r: Math.random() * 3 + 1.5 });
    }
  };
  (function loopCf() {
    cx.clearRect(0, 0, cf.width, cf.height);
    parts = parts.filter(p => p.life > 0);
    for (const p of parts) {
      p.vy += .22; p.vx *= .98; p.x += p.vx; p.y += p.vy; p.life -= .016;
      cx.globalAlpha = Math.max(p.life, 0); cx.fillStyle = p.c; cx.beginPath(); cx.arc(p.x, p.y, p.r, 0, 7); cx.fill();
    }
    cx.globalAlpha = 1;
    requestAnimationFrame(loopCf);
  })();

  const sc = document.createElement('canvas'); sc.id = 'sparks'; document.body.appendChild(sc);
  const sx = sc.getContext('2d'); let sp = [];
  const rsS = () => { sc.width = innerWidth; sc.height = innerHeight; }; rsS(); addEventListener('resize', rsS);
  addEventListener('pointermove', e => {
    for (let i = 0; i < 2; i++) sp.push({ x: e.clientX, y: e.clientY, vx: (Math.random() - .5) * 1.2, vy: (Math.random() - .5) * 1.2 - .4, l: 1, c: Math.random() < .7 ? '#e5353b' : '#fff', r: Math.random() * 1.6 + .6 });
    if (sp.length > 220) sp.splice(0, sp.length - 220);
  });
  (function f() {
    sx.clearRect(0, 0, sc.width, sc.height);
    sp = sp.filter(p => p.l > 0);
    for (const p of sp) { p.x += p.vx; p.y += p.vy; p.l -= .03; sx.globalAlpha = Math.max(p.l, 0); sx.fillStyle = p.c; sx.beginPath(); sx.arc(p.x, p.y, p.r, 0, 7); sx.fill(); }
    sx.globalAlpha = 1;
    requestAnimationFrame(f);
  })();

  // buddy cat
  const buddy = document.createElement('div'); buddy.id = 'buddy';
  buddy.innerHTML = `
    <div class="say"><div id="bText"></div><div class="acts" id="bActs"></div></div>
    <div class="body" id="bBody" role="button" tabindex="0" aria-label="buddy helper">
      <svg viewBox="0 0 90 90">
        <path class="tail" d="M20 70 C4 70 2 52 12 48" stroke="#000" stroke-width="5" fill="none" stroke-linecap="round"/>
        <rect class="l l1" x="30" y="72" width="6" height="12" rx="3" fill="#000"/>
        <rect class="l l2" x="40" y="72" width="6" height="12" rx="3" fill="#000"/>
        <rect class="l l3" x="52" y="72" width="6" height="12" rx="3" fill="#000"/>
        <rect class="l l4" x="62" y="72" width="6" height="12" rx="3" fill="#000"/>
        <ellipse cx="46" cy="64" rx="24" ry="14" fill="#000"/>
        <circle cx="42" cy="40" r="17" fill="#000"/>
        <path d="M26 34 L28 14 L42 28 Z" fill="#000"/>
        <path d="M58 34 L56 14 L42 28 Z" fill="#000"/>
        <path d="M30 30 L31 20 L37 26 Z" fill="#e5353b"/>
        <path d="M54 30 L53 20 L47 26 Z" fill="#e5353b"/>
        <g class="eyes"><circle cx="35" cy="40" r="4.6" fill="#fff"/><circle cx="49" cy="40" r="4.6" fill="#fff"/><circle cx="35.6" cy="40.6" r="2" fill="#000"/><circle cx="49.6" cy="40.6" r="2" fill="#000"/></g>
        <path d="M39 49 Q42 52 45 49" stroke="#e5353b" stroke-width="1.4" fill="none"/>
        <g class="paw"><rect x="66" y="48" width="7" height="16" rx="3.5" fill="#000"/><circle cx="69.5" cy="48" r="5" fill="#000"/></g>
      </svg>
    </div>`;
  document.body.appendChild(buddy);
  const svgEl = buddy.querySelector('svg');
  const bText = document.getElementById('bText');
  const bActs = document.getElementById('bActs');
  const bBody = document.getElementById('bBody');
  const LABEL = { latest: 'read latest', search: 'search ⌘K', say: 'say hi', copy: 'copy email', corner: 'writing corner' };
  let x = 40, dir = 1, walking = true, hover = false, hideT = null, lastT = performance.now();
  let nextToggle = performance.now() + 3500, curKey = null, idle = 0;

  function say(text, acts = [], ms = 5200) {
    bText.textContent = text;
    bActs.innerHTML = acts.map(a => `<button type="button" data-act="${a}">${LABEL[a]}</button>`).join('');
    buddy.classList.add('talk');
    clearTimeout(hideT);
    if (!hover) hideT = setTimeout(() => buddy.classList.remove('talk'), ms);
  }
  bBody.addEventListener('pointerenter', () => {
    hover = true; walking = false; buddy.classList.remove('walk');
    buddy.classList.add('wave'); setTimeout(() => buddy.classList.remove('wave'), 1700);
    say('hi! I can take you places 🐾', ['latest', 'corner', 'say'], 99999);
  });
  bBody.addEventListener('pointerleave', () => {
    hover = false;
    setTimeout(() => { if (!hover) { walking = true; buddy.classList.add('walk'); nextToggle = performance.now() + 3000; } }, 700);
    hideT = setTimeout(() => buddy.classList.remove('talk'), 2400);
  });
  let tipIdx = 0;
  bBody.addEventListener('click', () => {
    if (buddy.classList.contains('min')) { setMode(null); return; }
    say(['purr…', 'mrrp!', 'writing corner has drafts 👀', 'psst: press / to search'][tipIdx++ % 4], [], 3200);
  });
  bActs.addEventListener('click', e => {
    const b = e.target.closest('button[data-act]'); if (!b) return;
    const a = b.dataset.act;
    buddy.classList.remove('talk');
    if (a === 'latest') location.hash = '#/post/' + sortedPosts()[0].slug;
    if (a === 'corner') location.hash = '#/corner';
    if (a === 'search') document.getElementById('openCmd').click();
    if (a === 'say') {
      const m = document.getElementById('say');
      if (m) m.scrollIntoView({ behavior: 'smooth', block: 'center' }); else location.hash = '#/about';
    }
    if (a === 'copy') {
      const cm = document.getElementById('copyMail');
      if (cm) { cm.scrollIntoView({ behavior: 'smooth', block: 'center' }); setTimeout(() => cm.click(), 600); }
      else location.hash = '#/about';
    }
  });
  // minimise / hide / restore
  const bctl = document.createElement('div'); bctl.className = 'bctl';
  bctl.innerHTML = '<button type="button" data-b="min" aria-label="minimise helper cat" title="minimise">–</button><button type="button" data-b="gone" aria-label="hide helper cat" title="hide">×</button>';
  buddy.appendChild(bctl);
  const toggleBtn = document.getElementById('buddyToggle');
  function syncToggle() {
    toggleBtn.textContent = buddy.classList.contains('gone') ? 'cat off' : (buddy.classList.contains('min') ? 'cat min' : 'cat on');
  }
  function setMode(m) {
    buddy.classList.remove('min', 'gone', 'talk');
    if (m) buddy.classList.add(m);
    try { localStorage.setItem('buddyMode', m || 'on'); } catch (e) {}
    syncToggle();
  }
  bctl.addEventListener('click', e => {
    const b = e.target.closest('button[data-b]'); if (!b) return;
    e.stopPropagation();
    setMode(b.dataset.b === 'min' ? 'min' : 'gone');
  });
  toggleBtn.addEventListener('click', () => setMode(buddy.classList.contains('gone') ? null : 'gone'));
  let savedMode = null; try { savedMode = localStorage.getItem('buddyMode'); } catch (e) {}
  if (savedMode === 'min' || savedMode === 'gone') buddy.classList.add(savedMode);
  syncToggle();

  function tick(now) {
    const dt = Math.min(.05, (now - lastT) / 1000); lastT = now;
    if (!hover) {
      if (walking) {
        x += dir * 44 * dt;
        const max = innerWidth - 100;
        if (x > max) { x = max; dir = -1; }
        if (x < 6) { x = 6; dir = 1; }
      }
      if (now > nextToggle) {
        walking = !walking;
        buddy.classList.toggle('walk', walking);
        nextToggle = now + (walking ? 3500 + Math.random() * 3000 : 2000 + Math.random() * 2200);
      }
    }
    buddy.style.transform = `translateX(${x}px)`;
    svgEl.style.transform = `scaleX(${dir})`;
    requestAnimationFrame(tick);
  }
  buddy.classList.add('walk');
  requestAnimationFrame(tick);

  const PROBES = [
    { sel: '.scene', text: "hey, I'm buddy 🐾 want the latest post?", acts: ['latest', 'corner'] },
    { sel: '#posts', text: 'tip: press / to search posts', acts: ['search'] },
    { sel: '.tcard', text: 'talk invites? say hi ↓', acts: ['say'] },
    { sel: '#graph', text: 'hover a square to see its week', acts: [] },
    { sel: '.exp', text: 'open to chat about roles?', acts: ['say'] },
    { sel: '.mailbox', text: 'copy my email in one tap', acts: ['copy'] },
    { sel: '.corner', text: 'the desk has drafts. peek in 👀', acts: ['latest'] },
  ];
  const IDLE = ['psst, ⌘K opens search', 'this cat is open source 🐾', 'every post shows a reading time', 'g then c opens the writing corner'];
  function probe() {
    if (hover) return;
    let hit = null;
    for (const p of PROBES) {
      const el = document.querySelector(p.sel); if (!el) continue;
      const r = el.getBoundingClientRect();
      if (r.top < innerHeight * .75 && r.bottom > innerHeight * .25) hit = p;
    }
    const key = hit ? hit.sel : 'default';
    if (key !== curKey) {
      curKey = key;
      const p = hit || { text: 'say hi 👋', acts: ['say', 'latest'] };
      say(p.text, p.acts, 6000);
    }
  }
  setInterval(probe, 900);
  setInterval(() => { if (!hover && !buddy.classList.contains('talk')) say(IDLE[idle++ % IDLE.length], [], 3800); }, 13000);

  // command palette
  const cmdk = document.getElementById('cmdk');
  const input = document.getElementById('cmdInput');
  const list = document.getElementById('cmdList');
  let items = [], sel = 0;
  const pages = [
    { label: 'Home', hint: 'g h', href: '#/' },
    { label: 'Writing corner', hint: 'g c', href: '#/corner' },
    { label: 'About', hint: 'g a', href: '#/about' },
  ];
  function build() {
    const q = input.value.trim().toLowerCase();
    const posts = sortedPosts().map(p => ({ label: p.title, hint: fmtDate(p.date), href: '#/post/' + p.slug }));
    items = [...posts, ...pages].filter(i => !q || i.label.toLowerCase().includes(q));
    sel = 0;
    list.innerHTML = items.map((it, i) => `<li data-i="${i}" class="${i === 0 ? 'sel' : ''}"><span>${it.label}</span><span class="k">${it.hint}</span></li>`).join('') || '<li style="cursor:default">no results</li>';
  }
  function paint() { list.querySelectorAll('li').forEach((li, i) => li.classList.toggle('sel', i === sel)); }
  function openCmd() { cmdk.classList.add('open'); input.value = ''; build(); setTimeout(() => input.focus(), 10); }
  function closeCmd() { cmdk.classList.remove('open'); }
  function go(i) { const it = items[i]; if (!it) return; closeCmd(); location.hash = it.href; }
  document.getElementById('openCmd').addEventListener('click', openCmd);
  cmdk.addEventListener('click', e => { if (e.target === cmdk) closeCmd(); });
  input.addEventListener('input', build);
  list.addEventListener('click', e => { const li = e.target.closest('li[data-i]'); if (li) go(+li.dataset.i); });
  input.addEventListener('keydown', e => {
    if (e.key === 'ArrowDown') { sel = Math.min(sel + 1, items.length - 1); paint(); e.preventDefault(); }
    if (e.key === 'ArrowUp') { sel = Math.max(sel - 1, 0); paint(); e.preventDefault(); }
    if (e.key === 'Enter') go(sel);
    if (e.key === 'Escape') closeCmd();
  });

  // keyboard shortcuts: ⌘K, /, g+h/c/a, t for theme
  let gPending = 0;
  addEventListener('keydown', e => {
    const typing = /INPUT|TEXTAREA/.test(document.activeElement.tagName);
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); cmdk.classList.contains('open') ? closeCmd() : openCmd(); return; }
    if (typing || cmdk.classList.contains('open')) { if (e.key === 'Escape') closeCmd(); return; }
    if (e.key === '/') { const q = document.getElementById('q'); if (q) { e.preventDefault(); q.focus(); } return; }
    if (e.key === 't') { document.getElementById('themeBtn').click(); return; }
    if (e.key === 'g') { gPending = Date.now(); return; }
    if (Date.now() - gPending < 900) {
      const map = { h: '#/', c: '#/corner', a: '#/about' };
      if (map[e.key]) location.hash = map[e.key];
      gPending = 0;
    }
  });

  // theme
  const themeBtn = document.getElementById('themeBtn');
  let saved = null; try { saved = localStorage.getItem('theme'); } catch (e) {}
  if (saved === 'light') document.body.classList.add('light');
  themeBtn.addEventListener('click', () => {
    document.body.classList.toggle('light');
    try { localStorage.setItem('theme', document.body.classList.contains('light') ? 'light' : 'dark'); } catch (e) {}
  });
  document.getElementById('yr').textContent = new Date().getFullYear();

  // keyboard hint on load
  const hint = document.createElement('div'); hint.className = 'hint';
  hint.textContent = '⌘K search · / find posts · g c writing corner · t theme';
  document.body.appendChild(hint);
  setTimeout(() => hint.classList.add('show'), 2500);
  setTimeout(() => hint.classList.remove('show'), 9000);

  loadData().then(route);
})();
</script>

<script>
/* ===== Ayush additions: letter wave, cursor ring, desk tilt, floating notes, aurora ===== */
(function () {
  // aurora background
  const au = document.createElement('div'); au.id = 'aurora';
  au.innerHTML = '<i></i><i></i><i></i>';
  document.body.prepend(au);

  // cursor ring (fine pointers only)
  if (matchMedia('(pointer: fine)').matches) {
    const ring = document.createElement('div'); ring.id = 'cursorRing';
    document.body.appendChild(ring);
    let rx = innerWidth / 2, ry = innerHeight / 2, tx = rx, ty = ry;
    addEventListener('pointermove', e => { tx = e.clientX; ty = e.clientY; });
    (function follow() {
      rx += (tx - rx) * .22; ry += (ty - ry) * .22;
      ring.style.transform = `translate(${rx}px, ${ry}px)`;
      requestAnimationFrame(follow);
    })();
    document.addEventListener('pointerover', e => {
      ring.classList.toggle('hot', !!e.target.closest('a, button, .post, .tcard, .note, .chip'));
    });
  }

  // decorate newly rendered views (idempotent)
  function decorate() {
    // letter wave on the name
    document.querySelectorAll('.wl:not([data-done])').forEach(el => {
      el.dataset.done = 1;
      const txt = el.textContent;
      el.innerHTML = [...txt].map((ch, i) => `<span style="--d:${i}">${ch === ' ' ? '&nbsp;' : ch}</span>`).join('');
    });
    // floating sticky notes
    document.querySelectorAll('.note:not([data-fl])').forEach((n, i) => {
      n.dataset.fl = 1; n.classList.add('float'); n.style.setProperty('--fd', (i * .6) + 's');
    });
    // desk tilt toward cursor
    const desk = document.querySelector('.desk');
    if (desk && !desk.dataset.tilt) {
      desk.dataset.tilt = 1;
      desk.addEventListener('pointermove', e => {
        const r = desk.getBoundingClientRect();
        desk.style.setProperty('--ry', ((e.clientX - r.left) / r.width - .5) * 8 + 'deg');
        desk.style.setProperty('--rx', -((e.clientY - r.top) / r.height - .5) * 6 + 'deg');
      });
      desk.addEventListener('pointerleave', () => { desk.style.setProperty('--rx', '0deg'); desk.style.setProperty('--ry', '0deg'); });
    }
  }
  const obs = new MutationObserver(decorate);
  obs.observe(document.getElementById('app'), { childList: true });
  decorate();
})();
</script>
<script>
/* ===== socials wiring, copy email, magnetic footer icons ===== */
(function () {
  const fill = () => {
    document.querySelectorAll('.fb[data-icon]').forEach(f => { f.innerHTML = ICONS[f.dataset.icon]; });
    document.querySelectorAll('[data-social]').forEach(a => {
      const k = a.dataset.social;
      if (SOCIALS[k] && k !== 'email') a.href = SOCIALS[k].url;
      if (k === 'email') a.href = SOCIALS.email.url;
    });
    const y = document.getElementById('yr'); if (y) y.textContent = new Date().getFullYear();
    const bt = document.getElementById('backTop');
    if (bt && !bt.dataset.fx) { bt.dataset.fx = 1; bt.addEventListener('click', e => { e.preventDefault(); scrollTo({ top: 0, behavior: 'smooth' }); }); }
  };
  fill();
  document.addEventListener('socials-loaded', fill);

  // copy-email behaviour (footer + about cards)
  const copyEmail = async (el) => {
    const addr = SOCIALS.email.handle;
    const r = el.getBoundingClientRect();
    if (window.__burst) window.__burst(r.left + r.width / 2, r.top + r.height / 2);
    try { await navigator.clipboard.writeText(addr); } catch (e) {}
    const lbl = document.getElementById('emailLabel');
    if (lbl && el.dataset.social === 'email') { lbl.textContent = 'copied ✓'; setTimeout(() => lbl.textContent = 'copy email', 1600); }
    el.classList.remove('copied-flash'); void el.offsetWidth; el.classList.add('copied-flash');
  };
  document.addEventListener('click', e => {
    const el = e.target.closest('[data-copy-email="1"]');
    if (!el) return;
    if (el.classList.contains('ficon') || el.classList.contains('scard')) {
      // footer email copies; about email card keeps mailto but also copies
      if (el.dataset.social === 'email' || el.classList.contains('scard')) { if (el.dataset.social === 'email') e.preventDefault(); copyEmail(el); }
    }
  });

  // magnetic + glow on footer icons and cards
  document.addEventListener('pointermove', e => {
    const ic = e.target.closest && e.target.closest('.ficon');
    if (ic) {
      const r = ic.getBoundingClientRect();
      ic.style.transform = `translate(${(e.clientX - (r.left + r.width / 2)) * .25}px, ${(e.clientY - (r.top + r.height / 2)) * .3}px) rotate(-4deg)`;
    }
    const card = e.target.closest && e.target.closest('.scard');
    if (card) {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mx', (e.clientX - r.left) + 'px');
      card.style.setProperty('--my', (e.clientY - r.top) + 'px');
    }
  });
  document.addEventListener('pointerout', e => {
    const ic = e.target.closest && e.target.closest('.ficon');
    if (ic && !ic.contains(e.relatedTarget)) ic.style.transform = '';
  });

  // footer name: scramble-in when it scrolls into view
  const big = document.getElementById('fbig');
  if (big) {
    const chars = 'abcdefghijklmnopqrstuvwxyz';
    const io = new IntersectionObserver(es => es.forEach(en => {
      if (!en.isIntersecting) return;
      const final = big.textContent;
      let f = 0;
      const id = setInterval(() => {
        f++;
        big.textContent = final.split('').map((ch, i) => (ch === ' ' || i / final.length < f / 16) ? ch : chars[Math.floor(Math.random() * chars.length)]).join('');
        if (f >= 16) { clearInterval(id); big.textContent = final; }
      }, 45);
      io.disconnect();
    }), { threshold: .5 });
    io.observe(big);
  }
})();
</script>
<script>
/* ===================== RESPONSIVE + ADVANCED FEATURES ===================== */
(function () {
  const body = document.body;
  const q = (s, r = document) => r.querySelector(s);

  /* ---- header shadow on scroll ---- */
  const header = q('header.top');
  addEventListener('scroll', () => header.classList.toggle('scrolled', scrollY > 8), { passive: true });

  /* ---- mobile drawer ---- */
  const burger = q('#burger');
  const scrim = document.createElement('div'); scrim.className = 'scrim';
  const drawer = document.createElement('nav');
  drawer.className = 'drawer'; drawer.id = 'drawer'; drawer.setAttribute('aria-label', 'Mobile menu');
  drawer.innerHTML = `
    <a href="#/">home</a>
    <a href="#/corner">writing corner</a>
    <a href="#/about">about</a>
    <button class="dbtn" id="dCat" type="button">helper cat</button>
    <button class="dbtn" id="dTheme" type="button">theme</button>
    <div class="d-foot">Ayush Jha · ${new Date().getFullYear()}<br>built with plain html + express</div>`;
  document.body.append(scrim, drawer);
  function setNav(open) {
    body.classList.toggle('nav-open', open);
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'close menu' : 'open menu');
    if (open) q('a', drawer).focus({ preventScroll: true });
  }
  burger.addEventListener('click', () => setNav(!body.classList.contains('nav-open')));
  scrim.addEventListener('click', () => setNav(false));
  drawer.addEventListener('click', e => { if (e.target.closest('a')) setNav(false); });
  q('#dCat').addEventListener('click', () => { q('#buddyToggle').click(); });
  q('#dTheme').addEventListener('click', () => { q('#themeBtn').click(); });
  addEventListener('keydown', e => { if (e.key === 'Escape') setNav(false); });
  addEventListener('hashchange', () => setNav(false));
  matchMedia('(min-width: 901px)').addEventListener('change', e => { if (e.matches) setNav(false); });

  /* ---- post UI: mobile contents sheet, reader size, views, share ---- */
  function addFab() {
    if (q('#tocFab')) return;
    const fab = document.createElement('button');
    fab.className = 'toc-fab'; fab.id = 'tocFab'; fab.type = 'button'; fab.textContent = 'contents ↑';
    const sheet = document.createElement('div');
    sheet.className = 'toc-sheet'; sheet.id = 'tocSheet'; sheet.setAttribute('role', 'dialog'); sheet.setAttribute('aria-label', 'on this page');
    document.body.append(fab, sheet);
    fab.addEventListener('click', () => {
      const links = [...document.querySelectorAll('#toc a')];
      sheet.innerHTML = '<div class="th">on this page</div>' + links.map(a => `<a href="${a.getAttribute('href')}">${a.textContent}</a>`).join('');
      body.classList.toggle('toc-open');
    });
    sheet.addEventListener('click', e => { if (e.target.closest('a')) body.classList.remove('toc-open'); });
  }
  function removeFab() {
    q('#tocFab') && q('#tocFab').remove();
    q('#tocSheet') && q('#tocSheet').remove();
    body.classList.remove('toc-open');
  }
  const SIZES = ['reader-sm', '', 'reader-lg', 'reader-xl'];
  let sizeIdx = 1;
  try { sizeIdx = +(localStorage.getItem('readerSize') ?? 1); } catch (e) {}
  function applySize() {
    body.classList.remove('reader-sm', 'reader-lg', 'reader-xl');
    if (SIZES[sizeIdx]) body.classList.add(SIZES[sizeIdx]);
    try { localStorage.setItem('readerSize', sizeIdx); } catch (e) {}
  }
  document.addEventListener('click', e => {
    const b = e.target.closest('[data-reader]');
    if (!b) return;
    sizeIdx = Math.max(0, Math.min(SIZES.length - 1, sizeIdx + (b.dataset.reader === 'up' ? 1 : -1)));
    applySize();
  });
  document.addEventListener('click', async e => {
    if (!e.target.closest('#nativeShare')) return;
    try { await navigator.share({ title: document.title, url: location.href }); } catch (err) {}
  });

  function syncPostUI() {
    if (window.applyConfig) applyConfig();
    const hasArticle = !!q('article h1');
    if (!hasArticle) document.title = (CONFIG && CONFIG.site && CONFIG.site.title) || 'Ayush Jha · tech blog';
    else document.title = q('article h1').textContent + ' · Ayush Jha';

    if (q('#toc')) addFab(); else removeFab();

    const ns = q('#nativeShare');
    if (ns && !ns.dataset.init) { ns.dataset.init = 1; if (!navigator.share) ns.classList.add('hide'); }
    if (q('#readerTools') || q('.reader-tools')) applySize();

    const vs = q('#viewStat');
    if (vs && !vs.dataset.done) {
      vs.dataset.done = 1;
      const slug = location.hash.replace('#/post/', '');
      api('/api/posts/' + slug).then(j => { vs.textContent = `${j.views} views · ${j.likes} likes`; }).catch(() => { vs.textContent = ''; });
    }
  }
  new MutationObserver(syncPostUI).observe(q('#app'), { childList: true });
  syncPostUI();

  /* ---- offline indicator ---- */
  const off = document.createElement('div');
  off.className = 'offline'; off.textContent = 'you are offline. showing saved pages';
  document.body.appendChild(off);
  const setOnline = () => off.classList.toggle('show', !navigator.onLine);
  addEventListener('online', setOnline); addEventListener('offline', setOnline); setOnline();

  /* ---- service worker (installable, offline shell) ---- */
  if ('serviceWorker' in navigator && location.protocol.startsWith('http')) {
    navigator.serviceWorker.register('/sw.js').catch(() => {});
  }
})();
</script>
<script>
/* theme: follow OS on first visit, keep the browser UI colour in sync */
(function () {
  const meta = document.querySelector('meta[name=theme-color]');
  const sync = () => { if (meta) meta.content = document.body.classList.contains('light') ? '#f7f5f0' : '#000000'; };
  new MutationObserver(sync).observe(document.body, { attributes: true, attributeFilter: ['class'] });
  try {
    if (localStorage.getItem('theme') === null && matchMedia('(prefers-color-scheme: light)').matches) document.body.classList.add('light');
  } catch (e) {}
  sync();
})();
</script>
<script>
/* ==========================================================================
   TOKYO DRIFT: RACER GUIDE CHARACTER
   Animated SVG Racer Guide (Walking, Sitting, Sleeping, Waving, Jumping,
   Eye-Tracking, Page-Aware Speech Hints & Minimise/Hide Controls)
   ========================================================================== */

(function () {
  // Clean up any stale guide elements
  ['buddy', 'buddy2'].forEach((id) => {
    const old = document.getElementById(id);
    if (old) old.remove();
  });

  const tog = document.getElementById('buddyToggle');
  const toggleBtn = tog ? tog.cloneNode(true) : null;
  if (tog && toggleBtn) tog.replaceWith(toggleBtn);

  const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Create Racer Guide Container
  const el = document.createElement('div');
  el.id = 'buddy2';
  el.className = 'bd walk';
  el.innerHTML = `
    <div class="say"><div class="bd-text"></div><div class="acts"></div></div>
    <div class="bd-inner" role="button" tabindex="0" aria-label="guide character. click to play">
      <svg viewBox="0 0 100 130" aria-hidden="true">
        <defs>
          <linearGradient id="racerSuit" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#e02a2a"/>
            <stop offset="100%" stop-color="#4a0a0a"/>
          </linearGradient>
          <linearGradient id="racerHelmet" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#ff4a3a"/>
            <stop offset="100%" stop-color="#8b1111"/>
          </linearGradient>
          <linearGradient id="racerVisor" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#b8fbff"/>
            <stop offset="50%" stop-color="#1fb8d4"/>
            <stop offset="100%" stop-color="#0a3a4a"/>
          </linearGradient>
        </defs>

        <!-- Shadow: ellipse centre (50,127), radii 26 x 3.5, class "shadow" -->
        <ellipse class="shadow" cx="50" cy="127" rx="26" ry="3.5"/>

        <!-- Legs group (class "legs") -->
        <g class="legs">
          <!-- leg-l: rect x37 y96 11 x 28 radius 4, fill #161d2e -->
          <rect class="leg-l" x="37" y="96" width="11" height="28" rx="4" fill="#161d2e"/>
          <!-- leg-r: rect x52 same size -->
          <rect class="leg-r" x="52" y="96" width="11" height="28" rx="4" fill="#161d2e"/>

          <!-- Boots: path (34,118) to (48,118) to (48,124), rounded bottom to (35,126), fill #05060c with a 0.9px cyan #00e5ff stroke -->
          <path class="boot-l" d="M 34 118 L 48 118 L 48 124 Q 41.5 127 35 126 Z" fill="#05060c" stroke="#00e5ff" stroke-width="0.9"/>
          <line x1="36" y1="124" x2="46" y2="124" stroke="#00e5ff" stroke-width="2" stroke-linecap="round" opacity="0.8"/>

          <!-- Mirror for right boot at x52-67 -->
          <path class="boot-r" d="M 52 118 L 66 118 L 66 124 Q 59.5 127 53 126 Z" fill="#05060c" stroke="#00e5ff" stroke-width="0.9"/>
          <line x1="54" y1="124" x2="64" y2="124" stroke="#00e5ff" stroke-width="2" stroke-linecap="round" opacity="0.8"/>
        </g>

        <!-- Body group (class "body") -->
        <g class="body">
          <!-- Arm-left (class "arm-l"): path (31,76) (25,98) curve to (29,104), (33,104), (38,80), fill suit gradient, 1.2px dark stroke -->
          <g class="arm-l">
            <path d="M 31 76 L 25 98 Q 27 104 29 104 L 33 104 L 38 80 Z" fill="url(#racerSuit)" stroke="#05060c" stroke-width="1.2"/>
            <circle cx="27" cy="102" r="4.6" fill="#05060c" stroke="#00e5ff" stroke-width="0.8"/>
          </g>

          <!-- Torso: path (31,72) Q(50,62) (69,72), L(70,102), Q(70,110) (62,110), L(38,110), Q(30,110) (30,102), Z -->
          <path class="torso" d="M 31 72 Q 50 62 69 72 L 70 102 Q 70 110 62 110 L 38 110 Q 30 110 30 102 Z" fill="url(#racerSuit)" stroke="#05060c" stroke-width="1.4"/>

          <!-- Shoulder pads: ellipses (34,74) and (66,74), radii 7 x 5, #8b1111 with cyan arcs (1.2px) -->
          <ellipse cx="34" cy="74" rx="7" ry="5" fill="#8b1111"/>
          <path d="M 29 74 Q 34 70 39 74" fill="none" stroke="#00e5ff" stroke-width="1.2"/>
          <ellipse cx="66" cy="74" rx="7" ry="5" fill="#8b1111"/>
          <path d="M 61 74 Q 66 70 71 74" fill="none" stroke="#00e5ff" stroke-width="1.2"/>

          <!-- Chest zip: vertical line x50 from y70 to y102, dark, 55% opacity -->
          <line x1="50" y1="70" x2="50" y2="102" stroke="#05060c" stroke-width="1.2" opacity="0.55"/>

          <!-- Sponsor patch: rect (40,86) 20 x 11, radius 2, #fff8dc with a dark 0.6px stroke. Number "7" centred at (50,94.5), font 9px bold, Arial, #05060c -->
          <rect x="40" y="86" width="20" height="11" rx="2" fill="#fff8dc" stroke="#05060c" stroke-width="0.6"/>
          <text x="50" y="94.5" text-anchor="middle" dominant-baseline="central" font-family="Arial, sans-serif" font-size="9" font-weight="bold" fill="#05060c">7</text>

          <!-- Belt: rect (31,101) 38 x 4, #05060c. Buckle: rect (47,100.5) 6 x 5, radius 1, #ffd666 -->
          <rect x="31" y="101" width="38" height="4" fill="#05060c"/>
          <rect x="47" y="100.5" width="6" height="5" rx="1" fill="#ffd666"/>

          <!-- Arm-right (class "arm-r"): mirror at x69-76, glove circle (73,102) -->
          <g class="arm-r">
            <path d="M 69 76 L 75 98 Q 73 104 71 104 L 67 104 L 62 80 Z" fill="url(#racerSuit)" stroke="#05060c" stroke-width="1.2"/>
            <circle cx="73" cy="102" r="4.6" fill="#05060c" stroke="#00e5ff" stroke-width="0.8"/>
          </g>

          <!-- Head group (class "head") -->
          <g class="head">
            <!-- Neck: rect (44,60) 12 x 12, radius 3, #d9a07f -->
            <rect x="44" y="60" width="12" height="12" rx="3" fill="#d9a07f"/>

            <!-- Collar (HANS-style): path (38,66) Q(50,72) (62,66), L(63,72), Q(50,77) (37,72), #161d2e -->
            <path d="M 38 66 Q 50 72 62 66 L 63 72 Q 50 77 37 72 Z" fill="#161d2e"/>

            <!-- Helmet shell (class "hair-b"): path (28,46) Q(28,21) (50,19) Q(72,21) (72,46), L(72,58), Q(72,66) (62,66), L(38,66), Q(28,66) (28,58), Z -->
            <path class="hair-b" d="M 28 46 Q 28 21 50 19 Q 72 21 72 46 L 72 58 Q 72 66 62 66 L 38 66 Q 28 66 28 58 Z" fill="url(#racerHelmet)" stroke="#05060c" stroke-width="1.4"/>

            <!-- White centre stripe: path (45,20.5) Q(50,19) (55,20.5), L(57,47), L(43,47), Z, #fff8dc at 92% opacity -->
            <path d="M 45 20.5 Q 50 19 55 20.5 L 57 47 L 43 47 Z" fill="#fff8dc" opacity="0.92"/>

            <!-- Visor: path (33,47) Q(50,40) (67,47), L(65,56), Q(50,61) (35,56), Z -->
            <path class="visor" d="M 33 47 Q 50 40 67 47 L 65 56 Q 50 61 35 56 Z" fill="url(#racerVisor)" stroke="#05060c" stroke-width="1.1"/>

            <!-- Visor glint: path (37,47) Q(45,43) (52,44), L(49,47), Q(43,47) (37,50), white at 55% -->
            <path d="M 37 47 Q 45 43 52 44 L 49 47 Q 43 47 37 50 Z" fill="#ffffff" opacity="0.55"/>

            <!-- Chin guard: path (35,58) Q(50,64) (65,58), L(63,66), Q(50,70) (37,66), #161d2e -->
            <path d="M 35 58 Q 50 64 65 58 L 63 66 Q 50 70 37 66 Z" fill="#161d2e"/>

            <!-- Cyan side dot: circle (68,30) r2, #00e5ff -->
            <circle cx="68" cy="30" r="2" fill="#00e5ff"/>

            <!-- Eyes group (class "eyes"): eye-l at (43,51) and eye-r at (57,51) -->
            <g class="eyes">
              <g class="eye eye-l">
                <ellipse cx="43" cy="51" rx="2.6" ry="2.8" fill="#05060c"/>
                <circle cx="43.9" cy="50.1" r="0.8" fill="#ffffff"/>
              </g>
              <g class="eye eye-r">
                <ellipse cx="57" cy="51" rx="2.6" ry="2.8" fill="#05060c"/>
                <circle cx="57.9" cy="50.1" r="0.8" fill="#ffffff"/>
              </g>
            </g>
          </g>
        </g>
      </svg>
      <div class="bd-fx">
        <span class="zz">z</span>
        <span class="zz">z</span>
        <span class="zz">z</span>
      </div>
    </div>
    <div class="bctl">
      <button type="button" data-b="min" aria-label="minimise guide" title="minimise">–</button>
      <button type="button" data-b="gone" aria-label="hide guide" title="hide">×</button>
    </div>
  `;

  document.body.appendChild(el);

  const inner = el.querySelector('.bd-inner');
  const svg = el.querySelector('svg');
  const fx = el.querySelector('.bd-fx');
  const bText = el.querySelector('.bd-text');
  const bActs = el.querySelector('.acts');
  const eyes = [...el.querySelectorAll('.eye')];

  const ACT_LABELS = {
    latest: 'read latest',
    corner: 'writing corner',
    say: 'say hi',
    search: 'search ⌘K',
  };

  const CLICK_LINES = [
    "engine warm. let's go.",
    "lap one, no brakes.",
    "clean line through the city.",
    "hold the slide… hold it.",
    "the night is ours.",
  ];

  const IDLE_LINES = [
    "psst, ⌘K opens search",
    "g then c opens the writing corner",
    "every post shows a reading time",
    "click me for a little jump",
  ];

  let x = 40, dir = 1, mode = 'walk', hover = false, near = false;
  let lastT = performance.now(), modeUntil = performance.now() + 4500;
  let lastActive = performance.now(), hideT = null, clickLineIdx = 0, idleIdx = 0;
  let mouseX = window.innerWidth * 0.5, mouseY = window.innerHeight * 0.5;

  function setMode(m) {
    el.classList.remove('walk', 'sit', 'sleep');
    if (m) el.classList.add(m);
    mode = m || 'walk';
  }

  function say(text, acts = [], ms = 5000) {
    bText.textContent = text;
    bActs.innerHTML = acts.map(a => `<button type="button" data-act="${a}">${ACT_LABELS[a] || a}</button>`).join('');
    el.classList.add('talk');
    clearTimeout(hideT);
    if (!hover) {
      hideT = setTimeout(() => el.classList.remove('talk'), ms);
    }
  }

  window.racerSay = say;
  window.robotSay = say; // backwards compatibility

  // Sparks effect: 3 amber glyphs "✦" rising 14px right and 44px up over 1.1s
  function spawnSparks() {
    for (let i = 0; i < 3; i++) {
      const s = document.createElement('span');
      s.className = 'fx-spark';
      s.textContent = '✦';
      s.style.left = `${30 + Math.random() * 35}%`;
      s.style.animationDelay = `${i * 0.12}s`;
      fx.appendChild(s);
      setTimeout(() => s.remove(), 1200);
    }
  }

  function wake() {
    if (mode === 'sleep') setMode('walk');
  }

  // Pointer movement tracking
  addEventListener('pointermove', (e) => {
    lastActive = performance.now();
    mouseX = e.clientX;
    mouseY = e.clientY;

    const r = inner.getBoundingClientRect();
    const cx = r.left + r.width / 2;
    const cy = r.top + r.height / 2;
    const dx = e.clientX - cx;
    const dy = e.clientY - cy;
    const d = Math.hypot(dx, dy) || 1;

    // Eye tracking: up to 2.2px horizontally and 0.6x that vertically
    const k = Math.min(d, 220) / 220 * 2.2;
    const tx = (dx / d * k).toFixed(2);
    const ty = (dy / d * k * 0.6).toFixed(2);

    eyes.forEach((ey) => {
      ey.style.transform = `translate(${tx}px, ${ty}px)`;
    });

    // Near cursor: |dx| < 170, dy between -200 and 40
    near = Math.abs(dx) < 170 && dy > -200 && dy < 40;
    if (near && mode !== 'sleep') {
      dir = dx > 0 ? 1 : -1;
    }

    if (mode === 'sleep' && d < 80) {
      wake();
    }
  }, { passive: true });

  // Hover character
  inner.addEventListener('pointerenter', () => {
    hover = true;
    wake();
    el.classList.add('wave');
    setTimeout(() => el.classList.remove('wave'), 2200);
    if (!el.classList.contains('min')) {
      say('hey. I can show you around.', ['latest', 'corner', 'say'], 8000);
    }
  });

  inner.addEventListener('pointerleave', () => {
    hover = false;
    el.classList.remove('wave');
    hideT = setTimeout(() => el.classList.remove('talk'), 2400);
  });

  // Click or Enter/Space: happy, jump, sparks, and random dialogue
  function playClick() {
    wake();
    el.classList.add('happy');
    setTimeout(() => el.classList.remove('happy'), 1200);

    inner.classList.remove('jump');
    void inner.offsetWidth;
    inner.classList.add('jump');
    setTimeout(() => inner.classList.remove('jump'), 750);

    spawnSparks();
    const line = CLICK_LINES[clickLineIdx++ % CLICK_LINES.length];
    say(line, [], 3000);
    lastActive = performance.now();
  }

  inner.addEventListener('click', () => {
    if (el.classList.contains('min')) {
      setVisual('on');
      return;
    }
    playClick();
  });

  inner.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      playClick();
    }
  });

  // Action button handling in speech bubble
  bActs.addEventListener('click', (e) => {
    const btn = e.target.closest('button[data-act]');
    if (!btn) return;
    const act = btn.dataset.act;
    el.classList.remove('talk');

    if (act === 'latest') {
      // Find latest article or go to writings
      window.location.href = '/writings';
    } else if (act === 'corner') {
      window.location.href = '/corner';
    } else if (act === 'say') {
      window.location.href = '/contact';
    } else if (act === 'search') {
      document.getElementById('openCmd')?.click();
    }
  });

  // State management: helperMode ("min", "gone", or "on")
  function setVisual(m) {
    el.classList.remove('min', 'gone', 'talk');
    const modeVal = m || 'on';
    if (modeVal === 'min') el.classList.add('min');
    if (modeVal === 'gone') el.classList.add('gone');

    try {
      localStorage.setItem('helperMode', modeVal);
    } catch (e) {}

    syncToggle();
  }

  function syncToggle() {
    if (!toggleBtn) return;
    if (el.classList.contains('gone')) {
      toggleBtn.textContent = 'helper off';
    } else if (el.classList.contains('min')) {
      toggleBtn.textContent = 'helper min';
    } else {
      toggleBtn.textContent = 'helper on';
    }
  }

  // Minimise & Hide buttons
  el.querySelector('.bctl').addEventListener('click', (e) => {
    const b = e.target.closest('button[data-b]');
    if (!b) return;
    e.stopPropagation();
    setVisual(b.dataset.b === 'min' ? 'min' : 'gone');
  });

  if (toggleBtn) {
    toggleBtn.addEventListener('click', () => {
      if (el.classList.contains('gone')) {
        setVisual('on');
      } else if (el.classList.contains('min')) {
        setVisual('gone');
      } else {
        setVisual('min');
      }
    });
  }

  // Load saved helperMode
  let savedMode = null;
  try {
    savedMode = localStorage.getItem('helperMode');
  } catch (e) {}
  if (savedMode === 'min' || savedMode === 'gone') {
    el.classList.add(savedMode);
  }
  syncToggle();

  // Idle speech bubble every 14s
  setInterval(() => {
    if (!hover && !el.classList.contains('talk') && mode !== 'sleep' && !el.classList.contains('gone')) {
      say(IDLE_LINES[idleIdx++ % IDLE_LINES.length], [], 3800);
    }
  }, 14000);

  // Page-aware hints every 0.9s (between 25% and 75% of viewport)
  let lastHintSection = null;
  let hintExpires = 0;

  setInterval(() => {
    if (hover || el.classList.contains('talk') || mode === 'sleep' || el.classList.contains('gone')) return;
    const now = performance.now();
    if (now < hintExpires) return;

    const vh = window.innerHeight;
    const midTop = vh * 0.25;
    const midBottom = vh * 0.75;

    function isMid(elem) {
      if (!elem) return false;
      const rect = elem.getBoundingClientRect();
      const elemCenter = rect.top + rect.height / 2;
      return elemCenter >= midTop && elemCenter <= midBottom;
    }

    const hero = document.querySelector('.hero');
    const posts = document.getElementById('posts') || document.querySelector('.posts');
    const contact = document.getElementById('contactForm') || document.querySelector('.contact');
    const desk = document.querySelector('.desk');

    if (isMid(hero) && lastHintSection !== 'hero') {
      lastHintSection = 'hero';
      hintExpires = now + 6000;
      say('Welcome to the skyline. Want the latest post?', ['latest'], 6000);
    } else if (isMid(posts) && lastHintSection !== 'posts') {
      lastHintSection = 'posts';
      hintExpires = now + 6000;
      say('Tip: press / to search posts.', [], 6000);
    } else if (isMid(contact) && lastHintSection !== 'contact') {
      lastHintSection = 'contact';
      hintExpires = now + 6000;
      say('Copy my email in one tap.', ['say'], 6000);
    } else if (isMid(desk) && lastHintSection !== 'desk') {
      lastHintSection = 'desk';
      hintExpires = now + 6000;
      say('Ready to read? Check out the drafts.', ['corner'], 6000);
    }
  }, 900);

  // Random mode picker
  function pick(now) {
    if (near && mode !== 'sleep') {
      setMode('sit');
      modeUntil = now + 900;
      return;
    }
    if (mode === 'sleep') {
      setMode('walk');
      modeUntil = now + 4000 + Math.random() * 3000;
      return;
    }
    if (mode === 'walk') {
      // If cursor hasn't moved for 30s, 80% chance to sleep for 25s
      if (now - lastActive > 30000 && Math.random() < 0.8) {
        setMode('sleep');
        modeUntil = now + 25000;
        return;
      }
      // 35% chance to sit for 2-4s
      if (Math.random() < 0.35) {
        setMode('sit');
        modeUntil = now + 2000 + Math.random() * 2000;
      } else {
        modeUntil = now + 3500 + Math.random() * 3000;
      }
      return;
    }
    setMode('walk');
    modeUntil = now + 4000 + Math.random() * 3000;
  }

  // Main animation / walking tick
  function tick(now) {
    const dt = Math.min(0.05, (now - lastT) / 1000);
    lastT = now;

    if (!el.classList.contains('gone')) {
      const minX = 6;
      const maxX = Math.max(minX + 20, window.innerWidth - 120);

      if (REDUCED) {
        // Reduced motion: stands still
        setMode('sit');
      } else {
        if (!hover && now > modeUntil) {
          pick(now);
        }

        if (mode === 'walk' && !hover) {
          x += dir * 52 * dt; // walk right at 52px/s
          if (x > maxX) {
            x = maxX;
            dir = -1;
          }
          if (x < minX) {
            x = minX;
            dir = 1;
          }
        }
      }

      x = Math.max(6, Math.min(maxX, x));

      // Flip speech bubble when near right edge
      if (x > window.innerWidth - 280) {
        el.classList.add('flip-say');
      } else {
        el.classList.remove('flip-say');
      }

      el.style.transform = `translateX(${x}px)`;
      svg.style.transform = `scaleX(${dir})`;
    }

    requestAnimationFrame(tick);
  }

  requestAnimationFrame(tick);
})();

</script>
<script>
/* ===================== OPENING SEQUENCE: boot, robot wakes, name reveals, curtain opens ===================== */
(function () {
  const markDone = () => { window.__introDone = true; (window.__introWait || []).splice(0).forEach(f => { try { f(); } catch (e) {} }); };
  let seen = false; try { seen = sessionStorage.getItem('introSeen') === '1'; } catch (e) {}
  if (seen || matchMedia('(prefers-reduced-motion: reduce)').matches) { markDone(); return; }
  const esc = s => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const intro = document.createElement('div');
  intro.id = 'intro';
  intro.setAttribute('role', 'dialog'); intro.setAttribute('aria-label', 'welcome');
  intro.innerHTML = `
    <div class="in-glow"></div>
    <div class="in-top"></div><div class="in-bot"></div>
    <div class="in-label">ayush.os · v2.0</div>
    <div class="in-body">
      <svg class="in-robot" viewBox="0 0 100 100" aria-hidden="true">
        <line x1="50" y1="20" x2="50" y2="8" stroke="#8b98aa" stroke-width="2.4" stroke-linecap="round"/>
        <circle class="in-bulb" cx="50" cy="7" r="4" fill="#e5353b"/>
        <rect x="22" y="20" width="56" height="48" rx="15" fill="#e8eef6" stroke="#6f7b8c" stroke-width="1"/>
        <rect x="30" y="30" width="40" height="28" rx="9" fill="#0b1d33"/>
        <rect class="in-eye" x="37" y="37" width="8" height="12" rx="3" fill="#7cf0ff"/>
        <rect class="in-eye" x="55" y="37" width="8" height="12" rx="3" fill="#7cf0ff"/>
        <rect x="42" y="55" width="16" height="3" rx="1.5" fill="#6f7b8c"/>
      </svg>
      <div class="in-term"></div>
      <div class="in-bar"><i></i></div>
      <div class="in-name"></div>
      <div class="in-tag">writing about systems that think</div>
    </div>
    <button class="in-skip" type="button">skip ⏭</button>`;
  document.body.appendChild(intro);
  document.body.style.overflow = 'hidden';

  const term = intro.querySelector('.in-term');
  const lines = [
    ['> booting ayush.os', ''],
    ['> mounting writing corner', 'ok'],
    ['> syncing articles', 'ok'],
    ['> waking the robot', 'ok'],
    ['> welcome back 👋', ''],
  ];
  lines.forEach(([t, ok], i) => setTimeout(() => {
    const d = document.createElement('div');
    d.innerHTML = esc(t) + (ok ? ` <span class="ok">… ${ok} ✓</span>` : '');
    d.style.animationDelay = '0s';
    term.appendChild(d);
  }, 250 + i * 430));

  const name = 'AYUSH JHA';
  intro.querySelector('.in-name').innerHTML = [...name].map((c, i) => `<span style="transition-delay:${i * 70}ms">${c === ' ' ? '&nbsp;' : c}</span>`).join('');

  let finished = false;
  function finish() {
    if (finished) return; finished = true;
    intro.classList.add('out');
    document.body.style.overflow = '';
    try { sessionStorage.setItem('introSeen', '1'); } catch (e) {}
    markDone();
    setTimeout(() => intro.remove(), 1100);
  }
  setTimeout(() => intro.classList.add('awake'), 2300);
  setTimeout(() => intro.classList.add('name'), 2750);
  setTimeout(finish, 4700);
  setTimeout(() => { if (intro.isConnected) finish(); }, 7000);
  intro.querySelector('.in-skip').addEventListener('click', finish);
  const onKey = e => { if (e.key === 'Escape' || e.key === 'Enter') { finish(); removeEventListener('keydown', onKey); } };
  addEventListener('keydown', onKey);
})();
</script>
<script>
/* ==========================================================================
   CORE APPLICATION JAVASCRIPT & TOKYO DRIFT EFFECTS
   ========================================================================== */
(function () {
  const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // 1. Live Footer Clock
  (function initFooterClock() {
    const el = document.getElementById('fClock');
    if (!el) return;
    function tick() {
      const now = new Date();
      el.textContent = now.toLocaleTimeString('en-US', {
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: false,
      });
    }
    tick();
    setInterval(tick, 1000);
  })();

  // 2. Aurora background
  if (!document.getElementById('aurora')) {
    const au = document.createElement('div');
    au.id = 'aurora';
    au.innerHTML = '<i></i><i></i><i></i>';
    document.body.prepend(au);
  }

  // 3. Tokyo Drift: Cursor Spotlight (520px radial glow rgba(0,229,255,0.09) fading to transparent at 62%)
  let spotlight = document.getElementById('cursorSpotlight');
  if (!spotlight && matchMedia('(pointer: fine)').matches) {
    spotlight = document.createElement('div');
    spotlight.id = 'cursorSpotlight';
    document.body.appendChild(spotlight);

    let sx = innerWidth / 2, sy = innerHeight / 2, tx = sx, ty = sy;
    addEventListener('pointermove', (e) => { tx = e.clientX; ty = e.clientY; }, { passive: true });

    (function loopSpotlight() {
      sx += (tx - sx) * 0.12;
      sy += (ty - sy) * 0.12;
      spotlight.style.setProperty('--cx', `${sx}px`);
      spotlight.style.setProperty('--cy', `${sy}px`);
      requestAnimationFrame(loopSpotlight);
    })();
  }

  // 4. Tokyo Drift: Tyre-Smoke Cursor Trail (canvas, z-index 2, capped at 90)
  let smokeCanvas = document.getElementById('cursorSmokeCanvas');
  if (!smokeCanvas && !REDUCED && matchMedia('(pointer: fine)').matches) {
    smokeCanvas = document.createElement('canvas');
    smokeCanvas.id = 'cursorSmokeCanvas';
    document.body.appendChild(smokeCanvas);

    const sctx = smokeCanvas.getContext('2d');
    const MAX_CURSOR_SMOKE = 90;
    const cursorPuffs = [];

    function resizeSmokeCanvas() {
      smokeCanvas.width = innerWidth;
      smokeCanvas.height = innerHeight;
    }
    resizeSmokeCanvas();
    addEventListener('resize', resizeSmokeCanvas);

    addEventListener('pointermove', (e) => {
      // Spawn on about half of pointer moves
      if (Math.random() < 0.5 && cursorPuffs.length < MAX_CURSOR_SMOKE) {
        cursorPuffs.push({
          x: e.clientX,
          y: e.clientY,
          vx: (Math.random() - 0.5) * 20, // ±10
          vy: -(10 + Math.random() * 16), // -(10–26)
          r: 2 + Math.random() * 2,       // 2–4
          life: 1.0,
        });
      }
    }, { passive: true });

    (function loopCursorSmoke() {
      sctx.clearRect(0, 0, smokeCanvas.width, smokeCanvas.height);
      for (let i = cursorPuffs.length - 1; i >= 0; i--) {
        const p = cursorPuffs[i];
        p.x += p.vx / 60;
        p.y += p.vy / 60;
        p.life -= 0.02;

        if (p.life <= 0) {
          cursorPuffs.splice(i, 1);
          continue;
        }

        sctx.beginPath();
        sctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        sctx.fillStyle = `rgba(200, 210, 225, ${p.life * 0.14})`;
        sctx.fill();
      }
      requestAnimationFrame(loopCursorSmoke);
    })();
  }

  // 5. Tokyo Drift: Scanlines Overlay (Toggle with 'S' key)
  let scanlines = document.getElementById('scanlines');
  if (!scanlines) {
    scanlines = document.createElement('div');
    scanlines.id = 'scanlines';
    document.body.appendChild(scanlines);
  }

  // 6. Tokyo Drift: NOS Boost Overlay (Press 'N' key)
  let nosOverlay = document.getElementById('nosBoost');
  if (!nosOverlay) {
    nosOverlay = document.createElement('div');
    nosOverlay.id = 'nosBoost';
    document.body.appendChild(nosOverlay);
  }

  function triggerNosBoost() {
    if (REDUCED || !nosOverlay) return;
    nosOverlay.classList.remove('active');
    document.body.classList.remove('nos-shaking');
    void nosOverlay.offsetWidth;
    nosOverlay.classList.add('active');
    document.body.classList.add('nos-shaking');

    setTimeout(() => nosOverlay.classList.remove('active'), 1300);
    setTimeout(() => document.body.classList.remove('nos-shaking'), 1200);
  }

  // 7. Tokyo Drift: Route Change Wipe (on hashchange)
  let routeWipe = document.getElementById('routeWipe');
  if (!routeWipe) {
    routeWipe = document.createElement('div');
    routeWipe.id = 'routeWipe';
    routeWipe.innerHTML = `
      <div class="wipe-car-wrap">
        <svg class="wipe-car-svg" viewBox="-2 -22 84 26">
          <ellipse cx="40" cy="0" rx="38" ry="2.6" fill="rgba(0,229,255,0.4)"/>
          <path d="M 0 -4 L 3 -10 L 16 -13 L 28 -18 L 44 -18 L 54 -12 L 72 -10 L 80 -7 L 80 -3 Z" fill="#c81d1d" stroke="rgba(0,229,255,0.7)" stroke-width="0.8"/>
          <polygon points="28,-18 44,-18 50,-12 24,-12" fill="rgba(0,229,255,0.35)"/>
          <line x1="6" y1="-7" x2="76" y2="-7" stroke="rgba(255,77,46,0.9)" stroke-width="1.1"/>
          <rect x="2" y="-16" width="9" height="2" fill="#0a0c14"/>
          <circle cx="16" cy="-3" r="4.5" fill="#000000" stroke="#00e5ff" stroke-width="0.6"/>
          <circle cx="64" cy="-3" r="4.5" fill="#000000" stroke="#00e5ff" stroke-width="0.6"/>
          <circle cx="80" cy="-6" r="1.5" fill="#fff8dc"/>
          <circle cx="0" cy="-8" r="1.2" fill="#ff3b3b"/>
        </svg>
        <div class="wipe-speedline"></div>
        <div class="wipe-speedline wipe-speedline-top"></div>
      </div>
    `;
    document.body.appendChild(routeWipe);
  }

  // Check for seamless car transition exit on page arrival
  try {
    if (sessionStorage.getItem('carRouteWiping') === '1') {
      sessionStorage.removeItem('carRouteWiping');
      if (!REDUCED && routeWipe) {
        routeWipe.classList.remove('wiping');
        routeWipe.classList.add('wipe-exit');
        setTimeout(() => routeWipe.classList.remove('wipe-exit'), 1000);
      }
    }
  } catch (_) {}

  let isWiping = false;

  function navigateSmooth(href) {
    // Simple hard navigation — the new page will play the wipe-exit on arrival
    window.location.href = href;
  }

  function triggerRouteWipe(callback) {
    if (REDUCED || !routeWipe) {
      if (callback) callback();
      return;
    }
    if (isWiping) return;
    isWiping = true;

    routeWipe.classList.remove('wiping', 'wipe-exit');
    void routeWipe.offsetWidth;
    routeWipe.classList.add('wiping');

    if (callback) {
      // Wait until the car has swept almost all the way across (1.8s into the 2.0s animation)
      // so the user sees the full neon wipe before the new page content appears
      setTimeout(() => {
        try {
          sessionStorage.setItem('carRouteWiping', '1');
        } catch (_) {}
        callback();
      }, 1800);
    }
    setTimeout(() => {
      routeWipe.classList.remove('wiping');
      isWiping = false;
    }, 2100);
  }

  window.addEventListener('hashchange', () => triggerRouteWipe());
  window.triggerCarTransition = triggerRouteWipe;

  // Intercept internal page link clicks for Tokyo Drift car transition
  document.addEventListener('click', (e) => {
    const a = e.target.closest && e.target.closest('a[href]');
    if (!a) return;
    const href = a.getAttribute('href');
    if (!href || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:') || a.target === '_blank') return;
    if (href.startsWith('/admin') || href.startsWith('/api') || href.startsWith('/auth')) return;

    if (href.startsWith('/') && !e.metaKey && !e.ctrlKey && !e.shiftKey && !a.hasAttribute('download')) {
      e.preventDefault();
      triggerRouteWipe(() => {
        navigateSmooth(href);
      });
    }
  });

  // 8. Global Keyboard handler for Scanlines & NOS
  addEventListener('keydown', (e) => {
    const isTyping = /INPUT|TEXTAREA|SELECT/i.test(document.activeElement?.tagName) || document.activeElement?.isContentEditable;
    if (isTyping) return;

    if (e.key === 's' || e.key === 'S') {
      if (scanlines) scanlines.classList.toggle('active');
    } else if (e.key === 'n' || e.key === 'N') {
      triggerNosBoost();
    }
  });

  // 9. Magnetic buttons & nav links (within 90px of pointer shift by dx*0.18, dy*0.25)
  if (!REDUCED && matchMedia('(pointer: fine)').matches) {
    document.addEventListener('pointermove', (e) => {
      const magnetics = document.querySelectorAll('button, .btn, nav.main a, .ficon, .kbd-btn, .icon-btn');
      magnetics.forEach((el) => {
        const r = el.getBoundingClientRect();
        const cx = r.left + r.width / 2;
        const cy = r.top + r.height / 2;
        const dx = e.clientX - cx;
        const dy = e.clientY - cy;
        const dist = Math.hypot(dx, dy);

        if (dist < 90) {
          el.style.transform = `translate(${dx * 0.18}px, ${dy * 0.25}px)`;
          el.dataset.magnet = '1';
        } else if (el.dataset.magnet) {
          el.style.transform = '';
          delete el.dataset.magnet;
        }
      });
    }, { passive: true });

    document.addEventListener('pointerleave', () => {
      document.querySelectorAll('[data-magnet]').forEach((el) => {
        el.style.transform = '';
        delete el.dataset.magnet;
      });
    });
  }

  // 10. Click Ripple on buttons
  document.addEventListener('pointerdown', (e) => {
    const btn = e.target.closest && e.target.closest('button, .btn');
    if (!btn) return;
    const rect = btn.getBoundingClientRect();
    const size = Math.max(rect.width, rect.height) * 2;
    const ripple = document.createElement('span');
    ripple.className = 'click-ripple';
    ripple.style.width = `${size}px`;
    ripple.style.height = `${size}px`;
    ripple.style.left = `${e.clientX - rect.left}px`;
    ripple.style.top = `${e.clientY - rect.top}px`;
    btn.appendChild(ripple);
    setTimeout(() => ripple.remove(), 650);
  });

  // 11. 3D Tilt on post and stat cards
  if (!REDUCED && matchMedia('(pointer: fine)').matches) {
    document.addEventListener('pointermove', (e) => {
      const card = e.target.closest && e.target.closest('.post, .stat, .project-card, .tcard, .scard, .note');
      if (card) {
        const r = card.getBoundingClientRect();
        const px = (e.clientX - (r.left + r.width / 2)) / r.width;   // [-0.5, 0.5]
        const py = (e.clientY - (r.top + r.height / 2)) / r.height; // [-0.5, 0.5]
        card.style.transform = `perspective(800px) rotateX(${-py * 7}deg) rotateY(${px * 9}deg) translateY(-4px)`;
        card.style.setProperty('--mx', `${e.clientX - r.left}px`);
        card.style.setProperty('--my', `${e.clientY - r.top}px`);
      }
    }, { passive: true });

    document.addEventListener('pointerout', (e) => {
      const card = e.target.closest && e.target.closest('.post, .stat, .project-card, .tcard, .scard, .note');
      if (card && !card.contains(e.relatedTarget)) {
        card.style.transform = '';
      }
    });
  }

  // 12. Cursor ring
  if (matchMedia('(pointer: fine)').matches && !document.getElementById('cursorRing')) {
    const ring = document.createElement('div');
    ring.id = 'cursorRing';
    document.body.appendChild(ring);
    let rx = innerWidth / 2, ry = innerHeight / 2, tx = rx, ty = ry;
    addEventListener('pointermove', (e) => { tx = e.clientX; ty = e.clientY; });
    (function follow() {
      rx += (tx - rx) * 0.22;
      ry += (ty - ry) * 0.22;
      ring.style.transform = `translate(${rx}px, ${ry}px)`;
      requestAnimationFrame(follow);
    })();
    document.addEventListener('pointerover', (e) => {
      ring.classList.toggle('hot', !!e.target.closest('a, button, .post, .tcard, .note, .project-card, .skill-pill'));
    });
  }

  // 13. Back to top & scroll progress
  let prog = document.getElementById('progressTop');
  if (!prog) {
    prog = document.createElement('div');
    prog.id = 'progressTop';
    document.body.appendChild(prog);
  }
  let toTop = document.getElementById('toTop');
  if (!toTop) {
    toTop = document.createElement('button');
    toTop.id = 'toTop';
    toTop.type = 'button';
    toTop.setAttribute('aria-label', 'back to top');
    toTop.innerHTML = '<svg viewBox="0 0 48 48"><circle class="track" cx="24" cy="24" r="22"/><circle class="bar" cx="24" cy="24" r="22" stroke-dasharray="138.2" stroke-dashoffset="138.2"/></svg><span>↑</span>';
    document.body.appendChild(toTop);
    toTop.addEventListener('click', () => scrollTo({ top: 0, behavior: 'smooth' }));
  }
  const trackRing = toTop.querySelector('.bar');
  addEventListener('scroll', () => {
    const max = document.documentElement.scrollHeight - innerHeight;
    const p = max > 0 ? scrollY / max : 0;
    if (prog) prog.style.transform = `scaleX(${p})`;
    if (trackRing) trackRing.style.strokeDashoffset = 138.2 * (1 - p);
    toTop.classList.toggle('show', scrollY > 400);
  }, { passive: true });

  const backTop = document.getElementById('backTop');
  if (backTop) backTop.addEventListener('click', (e) => { e.preventDefault(); scrollTo({ top: 0, behavior: 'smooth' }); });

  // 14. Confetti burst
  const cf = document.createElement('canvas');
  cf.id = 'confetti';
  document.body.appendChild(cf);
  const cx = cf.getContext('2d');
  let parts = [];
  const rsCf = () => { cf.width = innerWidth; cf.height = innerHeight; };
  rsCf();
  addEventListener('resize', rsCf);
  window.__burst = (x, y) => {
    for (let i = 0; i < 46; i++) {
      const a = Math.random() * Math.PI * 2, s = Math.random() * 6 + 2;
      parts.push({ x, y, vx: Math.cos(a) * s, vy: Math.sin(a) * s - 4, life: 1, c: Math.random() < 0.5 ? '#e5353b' : '#fff', r: Math.random() * 3 + 1.5 });
    }
  };
  (function loopCf() {
    cx.clearRect(0, 0, cf.width, cf.height);
    parts = parts.filter(p => p.life > 0);
    for (const p of parts) {
      p.vy += 0.22; p.vx *= 0.98; p.x += p.vx; p.y += p.vy; p.life -= 0.016;
      cx.globalAlpha = Math.max(p.life, 0); cx.fillStyle = p.c; cx.beginPath(); cx.arc(p.x, p.y, p.r, 0, 7); cx.fill();
    }
    cx.globalAlpha = 1;
    requestAnimationFrame(loopCf);
  })();

  // 15. Scramble headings
  const chars = '01/<>#%$&';
  const sIO = new IntersectionObserver((es) => es.forEach((e) => {
    if (!e.isIntersecting) return;
    const el = e.target, final = el.textContent; let f = 0;
    const id = setInterval(() => {
      f++;
      el.textContent = final.split('').map((ch, i) => (ch === ' ' || i / final.length < f / 14) ? ch : chars[Math.floor(Math.random() * chars.length)]).join('');
      if (f >= 14) { clearInterval(id); el.textContent = final; }
    }, 40);
    sIO.unobserve(el);
  }), { threshold: 0.6 });
  document.querySelectorAll('.xhead .t').forEach(el => sIO.observe(el));

  // 16. Letter wave on name
  document.querySelectorAll('.wl:not([data-done])').forEach((el) => {
    el.dataset.done = '1';
    const txt = el.textContent;
    el.innerHTML = [...txt].map((ch, i) => `<span style="--d:${i}">${ch === ' ' ? '&nbsp;' : ch}</span>`).join('');
  });

  // 17. Desk tilt in writing corner
  const desk = document.querySelector('.desk');
  if (desk) {
    desk.addEventListener('pointermove', (e) => {
      const r = desk.getBoundingClientRect();
      desk.style.setProperty('--ry', ((e.clientX - r.left) / r.width - 0.5) * 8 + 'deg');
      desk.style.setProperty('--rx', -((e.clientY - r.top) / r.height - 0.5) * 6 + 'deg');
    });
    desk.addEventListener('pointerleave', () => {
      desk.style.setProperty('--rx', '0deg');
      desk.style.setProperty('--ry', '0deg');
    });
  }

  // 18. Floating notes
  document.querySelectorAll('.note:not([data-fl])').forEach((n, i) => {
    n.dataset.fl = '1'; n.classList.add('float'); n.style.setProperty('--fd', (i * 0.6) + 's');
  });

  // 19. Mailbox copy
  const cm = document.getElementById('copyMail');
  if (cm) {
    cm.addEventListener('click', async () => {
      const emailElem = document.getElementById('email2') || document.querySelector('[data-bind="email"]');
      const text = emailElem ? emailElem.textContent.trim() : 'reach2kr.ayush@gmail.com';
      const r = cm.getBoundingClientRect();
      if (window.__burst) window.__burst(r.left + r.width / 2, r.top + r.height / 2);
      try {
        await navigator.clipboard.writeText(text);
        cm.textContent = 'copied ✓';
      } catch (e) {
        cm.textContent = 'failed';
      }
      setTimeout(() => (cm.textContent = 'copy'), 1600);
    });
  }

  // 20. Footer / social email copy
  document.addEventListener('click', async (e) => {
    const el = e.target.closest('[data-copy-email="1"]');
    if (!el) return;
    e.preventDefault();
    const addr = el.getAttribute('href')?.replace('mailto:', '') || 'reach2kr.ayush@gmail.com';
    const r = el.getBoundingClientRect();
    if (window.__burst) window.__burst(r.left + r.width / 2, r.top + r.height / 2);
    try { await navigator.clipboard.writeText(addr); } catch (err) {}
    const lbl = document.getElementById('emailLabel');
    if (lbl) { lbl.textContent = 'copied ✓'; setTimeout(() => (lbl.textContent = 'copy email'), 1600); }
    el.classList.remove('copied-flash'); void el.offsetWidth; el.classList.add('copied-flash');
  });

  // 21. Theme toggle
  const themeBtn = document.getElementById('themeBtn');
  let saved = null; try { saved = localStorage.getItem('theme'); } catch (e) {}
  if (saved === 'light') document.body.classList.add('light');
  if (themeBtn) {
    themeBtn.addEventListener('click', () => {
      document.body.classList.toggle('light');
      try { localStorage.setItem('theme', document.body.classList.contains('light') ? 'light' : 'dark'); } catch (e) {}
    });
  }

  // 22. Mobile menu drawer
  const burger = document.getElementById('burger');
  const scrim = document.querySelector('.scrim') || document.createElement('div');
  scrim.className = 'scrim';
  if (!scrim.parentElement) document.body.appendChild(scrim);

  const drawer = document.getElementById('drawer') || document.createElement('nav');
  drawer.className = 'drawer'; drawer.id = 'drawer';
  drawer.innerHTML = `
    <a href="/">home</a>
    <a href="/writings">writings</a>
    <a href="/projects">projects</a>
    <a href="/skills">skills</a>
    <a href="/about">about</a>
    <a href="/contact">contact</a>
    <button class="dbtn" id="dCmdBar" type="button" style="color:var(--red);">&gt;_ command bar</button>
    <button class="dbtn" id="dTheme" type="button">toggle theme</button>
    <div class="d-foot">Ayush Jha · ${new Date().getFullYear()}<br>computer science student & developer</div>
  `;
  if (!drawer.parentElement) document.body.appendChild(drawer);

  function setNav(open) {
    document.body.classList.toggle('nav-open', open);
    if (burger) {
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'close menu' : 'open menu');
    }
  }
  if (burger) burger.addEventListener('click', () => setNav(!document.body.classList.contains('nav-open')));
  scrim.addEventListener('click', () => setNav(false));
  drawer.addEventListener('click', e => { if (e.target.closest('a')) setNav(false); });
  const dTheme = document.getElementById('dTheme');
  if (dTheme && themeBtn) dTheme.addEventListener('click', () => themeBtn.click());

  // 23. Command palette
  const cmdk = document.getElementById('cmdk');
  const cmdInput = document.getElementById('cmdInput');
  const cmdList = document.getElementById('cmdList');
  const openCmd = document.getElementById('openCmd');

  if (cmdk && cmdInput && cmdList) {
    let items = [], sel = 0;
    const staticPages = [
      { label: 'Home', hint: 'g h', href: '/' },
      { label: 'All Writings', hint: 'g w', href: '/writings' },
      { label: 'Projects', hint: 'g p', href: '/projects' },
      { label: 'Skills', hint: 'g s', href: '/skills' },
      { label: 'About Me', hint: 'g a', href: '/about' },
      { label: 'Contact', hint: 'g m', href: '/contact' },
      { label: 'Admin Console (Login / Dashboard)', hint: 'admin', href: '/admin' },
    ];

    async function loadCmdItems() {
      try {
        const res = await fetch('/api/posts');
        const posts = await res.json();
        const postItems = posts.map(p => ({
          label: p.title,
          hint: p.category,
          href: `/writings/${p.slug}`,
        }));
        return [...postItems, ...staticPages];
      } catch (e) {
        return staticPages;
      }
    }

    async function buildCmd() {
      const all = await loadCmdItems();
      const q = cmdInput.value.trim().toLowerCase();
      items = all.filter(it => !q || it.label.toLowerCase().includes(q) || it.hint.toLowerCase().includes(q));
      sel = 0;
      cmdList.innerHTML = items.length
        ? items.map((it, i) => `<li data-i="${i}" class="${i === 0 ? 'sel' : ''}"><span>${it.label}</span><span class="k">${it.hint}</span></li>`).join('')
        : '<li style="cursor:default">no results</li>';
    }

    function openPalette() {
      cmdk.classList.add('open');
      cmdInput.value = '';
      buildCmd();
      setTimeout(() => cmdInput.focus(), 10);
    }
    function closePalette() { cmdk.classList.remove('open'); }
    function choose(i) {
      const it = items[i];
      if (!it) return;
      closePalette();
      window.location.href = it.href;
    }

    if (openCmd) openCmd.addEventListener('click', openPalette);
    const dCmdBar = document.getElementById('dCmdBar');
    if (dCmdBar) dCmdBar.addEventListener('click', () => { setNav(false); openPalette(); });
    cmdk.addEventListener('click', e => { if (e.target === cmdk) closePalette(); });
    cmdInput.addEventListener('input', buildCmd);
    cmdList.addEventListener('click', e => {
      const li = e.target.closest('li[data-i]');
      if (li) choose(+li.dataset.i);
    });
    cmdInput.addEventListener('keydown', e => {
      if (e.key === 'ArrowDown') { sel = Math.min(sel + 1, items.length - 1); updateSel(); e.preventDefault(); }
      if (e.key === 'ArrowUp') { sel = Math.max(sel - 1, 0); updateSel(); e.preventDefault(); }
      if (e.key === 'Enter') choose(sel);
      if (e.key === 'Escape') closePalette();
    });
    function updateSel() {
      cmdList.querySelectorAll('li').forEach((li, i) => li.classList.toggle('sel', i === sel));
    }

    // Keyboard shortcuts
    let gPending = 0;
    addEventListener('keydown', e => {
      const typing = /INPUT|TEXTAREA/.test(document.activeElement.tagName);
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); cmdk.classList.contains('open') ? closePalette() : openPalette(); return; }
      if (typing || cmdk.classList.contains('open')) { if (e.key === 'Escape') closePalette(); return; }
      if (e.key === '/') { const q = document.getElementById('q'); if (q) { e.preventDefault(); q.focus(); } return; }
      if (e.key === 't' && themeBtn) { themeBtn.click(); return; }
      if (e.key === 'g') { gPending = Date.now(); return; }
      if (Date.now() - gPending < 900) {
        const map = { h: '/', w: '/writings', b: '/writings', p: '/projects', s: '/skills', a: '/about', c: '/corner', m: '/contact', '!': '/admin' };
        if (map[e.key]) window.location.href = map[e.key];
        gPending = 0;
      }
    });
  }

  // 24. Typewriter in Hero Terminal
  const termEl = document.getElementById('termBody');
  if (termEl) {
    const script = [
      ['p', '$ whoami'],
      ['', 'ayush jha · cse @ vit'],
      ['p', '$ cat interests.txt'],
      ['', 'backend architecture · databases · algorithms · ai'],
      ['p', '$ git status'],
      ['ok', '✓ on branch main · learning & building continuously'],
    ];
    let html = '', li = 0, ci = 0;
    const cursor = '<span class="c"></span>';
    (function step() {
      if (!termEl.isConnected) return;
      if (li >= script.length) { termEl.innerHTML = html + cursor; return; }
      const [cls, text] = script[li];
      const open = cls ? `<span class="${cls}">` : '<span>';
      ci = Math.min(ci + 2, text.length);
      termEl.innerHTML = html + open + text.slice(0, ci).replace(/</g, '&lt;') + '</span>' + cursor;
      if (ci >= text.length) { html += open + text.replace(/</g, '&lt;') + '</span><br>'; li++; ci = 0; setTimeout(step, 450); }
      else setTimeout(step, 24);
    })();
  }

  // 25. Codeblock copy button
  document.querySelectorAll('.codeblock').forEach((cb) => {
    let bar = cb.querySelector('.bar2');
    if (!bar) {
      bar = document.createElement('div'); bar.className = 'bar2';
      bar.innerHTML = `<span>${cb.dataset.lang || 'code'}</span><button type="button">copy</button>`;
      cb.prepend(bar);
    }
    const btn = bar.querySelector('button');
    if (btn && !btn.dataset.init) {
      btn.dataset.init = '1';
      btn.addEventListener('click', async () => {
        try {
          const codeEl = cb.querySelector('code');
          await navigator.clipboard.writeText(codeEl ? codeEl.innerText : '');
          cb.classList.add('copied'); btn.textContent = 'copied ✓';
          setTimeout(() => { cb.classList.remove('copied'); btn.textContent = 'copy'; }, 1500);
        } catch (e) {}
      });
    }
  });

  // 26. Table of Contents Scrollspy on Blog Details
  const toc = document.getElementById('toc');
  if (toc) {
    const heads = [...document.querySelectorAll('article h2')];
    heads.forEach((h, i) => {
      if (!h.id) h.id = 'sec-' + i;
    });
    const links = [...toc.querySelectorAll('a')];
    const spy = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      links.forEach(a => a.classList.toggle('on', a.getAttribute('href') === '#' + e.target.id));
    }), { rootMargin: '-30% 0px -60% 0px' });
    heads.forEach(h => spy.observe(h));
  }

  // 27. Reading progress bar on Blog Details
  const readBar = document.getElementById('readBar');
  const articleBody = document.getElementById('body') || document.querySelector('article');
  if (readBar && articleBody) {
    const onScroll = () => {
      const r = articleBody.getBoundingClientRect();
      const total = articleBody.offsetHeight - innerHeight * 0.4;
      readBar.style.width = Math.min(100, Math.max(0, -r.top / total * 100)) + '%';
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  // 28. Like button handling
  const likeBtn = document.getElementById('likeBtn');
  if (likeBtn) {
    const slug = likeBtn.dataset.slug;
    likeBtn.addEventListener('click', async () => {
      const isLiked = likeBtn.classList.contains('on');
      const newStatus = !isLiked;
      likeBtn.classList.toggle('on', newStatus);
      const heart = document.getElementById('heart');
      if (heart) {
        heart.textContent = newStatus ? '♥' : '♡';
        heart.classList.remove('pop'); void heart.offsetWidth; heart.classList.add('pop');
      }
      const countEl = document.getElementById('likeCount');
      if (countEl) {
        countEl.textContent = Math.max(0, parseInt(countEl.textContent || 0) + (newStatus ? 1 : -1));
      }
      if (newStatus && window.__burst) {
        const r = likeBtn.getBoundingClientRect();
        window.__burst(r.left + r.width / 2, r.top + r.height / 2);
      }
      try {
        await fetch(`/api/posts/${slug}/like`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ liked: newStatus }),
        });
      } catch (err) {}
    });
  }

  // 29. Contact form AJAX
  const contactForm = document.getElementById('contactForm');
  if (contactForm) {
    contactForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = contactForm.querySelector('button[type="submit"]');
      const msg = document.getElementById('contactMsg');
      const formData = new FormData(contactForm);
      const data = Object.fromEntries(formData.entries());

      if (btn) { btn.disabled = true; btn.textContent = 'sending…'; }
      if (msg) { msg.className = 'msg'; msg.textContent = 'Sending message...'; }

      try {
        const res = await fetch('/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(data),
        });
        const json = await res.json();
        if (!res.ok) throw new Error(json.error || 'Failed to submit form');

        if (msg) {
          msg.className = 'msg ok';
          msg.textContent = '✓ ' + json.message;
        }
        contactForm.reset();
        if (window.__burst && btn) {
          const r = btn.getBoundingClientRect();
          window.__burst(r.left + r.width / 2, r.top + r.height / 2);
        }
      } catch (err) {
        if (msg) {
          msg.className = 'msg err';
          msg.textContent = err.message;
        }
      } finally {
        if (btn) { btn.disabled = false; btn.textContent = 'send'; }
      }
    });
  }

  // 30. Newsletter form AJAX
  const newsForm = document.getElementById('newsForm');
  if (newsForm) {
    newsForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = document.getElementById('newsEmail');
      const msg = document.getElementById('newsMsg');
      const email = input ? input.value.trim() : '';

      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        if (input) input.classList.add('bad');
        if (msg) { msg.className = 'msg'; msg.textContent = 'enter a valid email address'; }
        return;
      }

      if (msg) { msg.className = 'msg'; msg.textContent = 'subscribing…'; }
      try {
        const res = await fetch('/contact/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        const json = await res.json();
        if (msg) { msg.className = 'msg ok'; msg.textContent = '✓ ' + json.message; }
        if (input) input.value = '';
      } catch (err) {
        if (msg) { msg.className = 'msg'; msg.textContent = 'Failed to subscribe.'; }
      }
    });
  }

  // 31. Reveal observer for scroll animations
  const rvIO = new IntersectionObserver((es) => es.forEach((e) => {
    if (e.isIntersecting) { e.target.classList.add('in'); rvIO.unobserve(e.target); }
  }), { threshold: 0.1 });
  document.querySelectorAll('.rv:not(.in), .exp:not(.in)').forEach(el => rvIO.observe(el));

  // ========================================================================
  // 32. TOKYO DRIFT: ARTICLE PAGES ENHANCEMENT
  // ========================================================================
  function initArticleDrift() {
    const article = document.querySelector('article');
    if (!article) return;

    // A. Insert article drift header above title if not already present
    if (!article.querySelector('.article-drift-header')) {
      const title = article.querySelector('h1');
      if (title) {
        const hdr = document.createElement('div');
        hdr.className = 'article-drift-header';
        hdr.setAttribute('aria-hidden', 'true');
        hdr.innerHTML = `
          <div class="article-drift-stars"></div>
          <div class="article-drift-road"></div>
          <div class="article-drift-car-wrap">
            <svg class="article-drift-car-svg" viewBox="-2 -22 84 26">
              <ellipse cx="40" cy="0" rx="38" ry="2.6" fill="rgba(0,229,255,0.25)"/>
              <path d="M 0 -4 L 3 -10 L 16 -13 L 28 -18 L 44 -18 L 54 -12 L 72 -10 L 80 -7 L 80 -3 Z" fill="#c81d1d" stroke="rgba(0,229,255,0.55)" stroke-width="0.7"/>
              <polygon points="28,-18 44,-18 50,-12 24,-12" fill="rgba(0,229,255,0.28)"/>
              <line x1="6" y1="-7" x2="76" y2="-7" stroke="rgba(255,77,46,0.9)" stroke-width="1.1"/>
              <rect x="2" y="-16" width="9" height="2" fill="#0a0c14"/>
              <circle cx="16" cy="-3" r="4.5" fill="#000000" stroke="#333" stroke-width="0.6"/>
              <circle cx="64" cy="-3" r="4.5" fill="#000000" stroke="#333" stroke-width="0.6"/>
              <circle cx="80" cy="-6" r="1.5" fill="#fff8dc"/>
              <circle cx="0" cy="-8" r="1.2" fill="#ff3b3b"/>
            </svg>
          </div>
        `;
        title.parentNode.insertBefore(hdr, title);

        // Add faint stars into header
        const starsWrap = hdr.querySelector('.article-drift-stars');
        if (starsWrap) {
          for (let i = 0; i < 35; i++) {
            const dot = document.createElement('span');
            dot.className = 'drift-star';
            dot.style.left = `${(Math.sin(i * 12.3) * 0.5 + 0.5) * 100}%`;
            dot.style.top = `${(Math.cos(i * 7.7) * 0.5 + 0.5) * 65}%`;
            dot.style.opacity = `${0.2 + (i % 5) * 0.12}`;
            starsWrap.appendChild(dot);
          }
        }
      }
    }

    // B. Headings underline bar reveal
    const headings = article.querySelectorAll('h2');
    const h2Observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          h2Observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });

    headings.forEach((h2) => {
      if (REDUCED) {
        h2.classList.add('revealed');
      } else {
        h2Observer.observe(h2);
      }
    });

    // C. Body children reveal (paragraphs, lists, code blocks, headings)
    const contentArea = document.getElementById('body') || article.querySelector('.terminal-article-content') || article;
    const targets = contentArea.querySelectorAll(':scope > p, :scope > ul, :scope > ol, :scope > .codeblock, :scope > h2, :scope > h3, :scope > blockquote, :scope > div:not(.actions-row):not(.like-corner-card)');

    if (REDUCED) {
      targets.forEach(el => el.classList.add('in-view'));
    } else {
      const childObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            childObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });

      targets.forEach(el => childObserver.observe(el));
    }
  }

  // Export initArticleDrift globally so both SSR and dynamic post views can call it
  window.initArticleDrift = initArticleDrift;

  // Run on load if viewing an article
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initArticleDrift);
  } else {
    initArticleDrift();
  }
})();

</script>
</body>
</html>