      </section>

      <section class="xsec rv" id="say">
        <div class="xhead"><span class="t">say hi</span></div>
        <div class="mailbox"><span id="email2" data-bind="email">hello@yourdomain.com</span><button id="copyMail" type="button">copy</button></div>
